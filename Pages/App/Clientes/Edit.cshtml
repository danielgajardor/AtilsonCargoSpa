@page "{id:int?}"
@model AtilsonCargoSpa.Pages.App.Clientes.EditModel
@{
    ViewData["Title"] = "Editar Cliente";
}

<style>
    :root {
        --txt-main: #0f172a;    
        --txt-muted: #64748b;   
        --border-soft: #e2e8f0; 
        --bg-main: #ffffff;     
        --bg-soft: #f8fafc;     
        --atilson-dark: #2c1b4d;
    }

    body { background-color: #f1f5f9; }

    .module-card { background: var(--bg-main); border: 1px solid var(--border-soft); border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03); margin-bottom: 25px; overflow: hidden; }
    .module-header { background-color: var(--bg-soft); padding: 16px 25px; border-bottom: 1px solid var(--border-soft); display: flex; align-items: center; gap: 10px; }
    .module-header h6 { font-size: 13px; font-weight: 800; color: var(--txt-main); text-transform: uppercase; letter-spacing: 0.5px; margin: 0; }
    .module-body { padding: 30px; }

    .form-group-custom { margin-bottom: 1.5rem; }
    .input-label { font-size: 10px; font-weight: 800; color: var(--txt-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; display: block; }
    .input-label.required::after { content: " *"; color: #e11d48; font-size: 12px; }

    .input-modern { font-size: 13px; font-weight: 500; color: var(--txt-main); background-color: transparent; border: none; border-bottom: 1px solid #cbd5e1; border-radius: 0; padding: 8px 0; transition: all 0.3s ease; width: 100%; }
    select.input-modern { padding-right: 20px; }
    .input-modern:focus { outline: none; border-bottom-color: var(--atilson-dark); box-shadow: 0 1px 0 0 var(--atilson-dark); }
    
    .status-select { background-color: #f3f0ff !important; border-bottom: 2px solid var(--atilson-dark) !important; color: var(--atilson-dark) !important; font-weight: 900 !important; border-radius: 4px 4px 0 0 !important; padding: 8px 10px !important; }

    .btn-submit-pro { background: linear-gradient(135deg, var(--atilson-dark) 0%, #1a102e 100%); color: white; border: none; border-radius: 6px; padding: 14px 30px; font-size: 13px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; box-shadow: 0 4px 6px rgba(44, 27, 77, 0.2); transition: all 0.2s ease; }
    .btn-submit-pro:hover { transform: translateY(-2px); box-shadow: 0 6px 12px rgba(44, 27, 77, 0.3); color: white; }
</style>

<div class="container-fluid py-4" style="max-width: 900px;">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: var(--txt-main); margin: 0; letter-spacing: -0.5px;">EDITAR CLIENTE: @Model.Cliente.RazonSocial</h1>
            <p class="text-muted small m-0 fw-medium">Actualice la información de la empresa.</p>
        </div>
        <a asp-page="Index" class="btn btn-white border bg-white shadow-sm text-muted fw-bold px-4" style="font-size: 11px; letter-spacing: 0.5px;">CANCELAR Y VOLVER</a>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Cliente.Id" />
        <input type="hidden" asp-for="Cliente.FechaCreacion" />
        <input type="hidden" asp-for="Cliente.UsuarioCreador" />
        
        <div class="module-card" style="border-top: 4px solid var(--atilson-dark);">
            <div class="module-header">
                <i class="bi bi-buildings-fill text-muted fs-5"></i>
                <h6>1. Datos de Identificación y Estado</h6>
            </div>
            <div class="module-body">
                <div class="row gx-5">
                    <div class="col-md-3 form-group-custom">
                        <label class="input-label required">RUT / Tax ID</label>
                        <input asp-for="Cliente.Rut" class="input-modern" required />
                    </div>
                    <div class="col-md-6 form-group-custom">
                        <label class="input-label required">Razón Social</label>
                        <input asp-for="Cliente.RazonSocial" class="input-modern" required />
                    </div>
                    <div class="col-md-3 form-group-custom">
                        <label class="input-label text-primary">Estado del Cliente</label>
                        <select asp-for="Cliente.Activo" class="input-modern status-select">
                            <option value="1">🟢 ACTIVO</option>
                            <option value="0">❌ INACTIVO</option>
                        </select>
                    </div>
                </div>
                <div class="row gx-5 mb-0">
                    <div class="col-12 form-group-custom mb-0">
                        <label class="input-label">Nombre de Fantasía</label>
                        <input asp-for="Cliente.NombreCliente" class="input-modern" />
                    </div>
                </div>
            </div>
        </div>

        <div class="module-card" style="border-top: 4px solid #3b82f6;">
            <div class="module-header bg-white">
                <i class="bi bi-geo-alt-fill text-primary fs-5"></i>
                <h6>2. Contacto y Ubicación</h6>
            </div>
            <div class="module-body bg-light bg-opacity-25">
                <div class="row gx-5">
                    <div class="col-md-12 form-group-custom">
                        <label class="input-label">Dirección Comercial</label>
                        <input asp-for="Cliente.Direccion" class="input-modern" />
                    </div>
                </div>
                <div class="row gx-5 mb-0">
                    <div class="col-md-6 form-group-custom mb-0">
                        <label class="input-label">Ciudad / Región</label>
                        <select asp-for="Cliente.IdCiudad" class="input-modern" asp-items="ViewBag.IdCiudad">
                            <option value="">-- Seleccionar Ciudad --</option>
                        </select>
                    </div>
                    <div class="col-md-6 form-group-custom mb-0">
                        <label class="input-label">Persona de Contacto</label>
                        <input asp-for="Cliente.Contacto" class="input-modern" />
                    </div>
                </div>
            </div>
        </div>

        <div class="module-card" style="border-top: 4px solid #10b981; margin-top: 30px;">
            <div class="module-header bg-white">
                <i class="bi bi-cash-coin text-success fs-5"></i>
                <h6>3. Cierres de Negocio Activos (Tarifario del Cliente)</h6>
            </div>
            <div class="module-body p-0">
                <table class="table-platinum m-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Área / Servicio</th>
                            <th>Ruta / Concepto</th>
                            <th class="text-end">Tarifa Pactada</th>
                            <th class="text-center">Vencimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cliente.TarifasClientes != null && Model.Cliente.TarifasClientes.Any(t => t.EsActiva == true))
                        {
                            @foreach (var tarifa in Model.Cliente.TarifasClientes.Where(t => t.EsActiva == true).OrderBy(t => t.GrupoCobro))
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <span class="badge-exec @(tarifa.GrupoCobro == "Marítimo" ? "bg-primary text-white" : tarifa.GrupoCobro == "Terrestre" ? "bg-warning text-dark" : "bg-secondary text-white")">
                                            @tarifa.GrupoCobro
                                        </span>
                                    </td>
                                    <td>
                                        <span class="data-primary">@tarifa.Concepto</span>
                                        @if (!string.IsNullOrEmpty(tarifa.Pol))
                                        {
                                            <span class="data-secondary text-uppercase">@tarifa.Pol <i class="bi bi-arrow-right mx-1"></i> @tarifa.Pod</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">
                                        @tarifa.Moneda $@tarifa.PrecioPactado.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <span class="@(tarifa.FechaFinVigencia < DateTime.Now ? "text-danger fw-bold" : "text-success")">
                                            @tarifa.FechaFinVigencia.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i> No hay tarifas activas negociadas con este cliente.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4 mb-5 text-end">
            <button type="submit" class="btn-submit-pro">
                <i class="bi bi-arrow-repeat me-2"></i> Actualizar Cliente
            </button>
        </div>
    </form>
</div>