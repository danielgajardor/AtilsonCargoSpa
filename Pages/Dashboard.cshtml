@page
@model AtilsonCargoSpa.Pages.DashboardModel
@{
    ViewData["Title"] = "Centro de Mando ATILSON";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* ========================================================
           VARIABLES Y PALETA CORPORATIVA ATILSON (TOP TIER ERP)
        ======================================================== */
    :root {
        --atilson-dark: #0f172a;
        --atilson-purple: #6d2d9e;
        --atilson-accent: #0ea5e9;
        --txt-main: #1e293b;
        --txt-muted: #64748b;
        --border-soft: #e2e8f0;
        --bg-body: #f8fafc;
        --bg-panel: #ffffff;
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
        --shadow-lg: 0 15px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    }

    body {
        background-color: var(--bg-body);
        color: var(--txt-main);
        font-family: 'Inter', system-ui, sans-serif;
    }

    footer {
        display: none !important;
    }

    /* ========================================================
           ANIMACIONES
        ======================================================== */
    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .d-1 {
        animation-delay: 0.1s;
    }

    .d-2 {
        animation-delay: 0.2s;
    }

    .d-3 {
        animation-delay: 0.3s;
    }

    .d-4 {
        animation-delay: 0.4s;
    }

    @@keyframes fadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========================================================
           ACCESOS DIRECTOS GIGANTES (ERP STYLE)
        ======================================================== */
    .quick-access-btn {
        display: flex;
        align-items: center;
        padding: 30px;
        border-radius: 16px;
        color: white;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-md);
        position: relative;
        overflow: hidden;
        min-height: 140px;
    }

        .quick-access-btn::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background: url('data:image/svg+xml;utf8,<svg width="100" height="100" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><path d="M10 10 L90 90 M90 10 L10 90" stroke="rgba(255,255,255,0.03)" stroke-width="2" fill="none"/></svg>') repeat;
            pointer-events: none;
        }

        .quick-access-btn:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
            color: white;
        }

    .qa-ops {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }

        .qa-ops:hover {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        }

    .qa-fin {
        background: linear-gradient(135deg, #16a34a 0%, #059669 100%);
    }

        .qa-fin:hover {
            background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
        }

    .qa-com {
        background: linear-gradient(135deg, #6d2d9e 0%, #4c1d95 100%);
    }

        .qa-com:hover {
            background: linear-gradient(135deg, #7e22ce 0%, #5b21b6 100%);
        }

    .qa-icon {
        font-size: 50px;
        line-height: 1;
        margin-right: 25px;
        opacity: 0.9;
        z-index: 1;
    }

    .qa-content {
        z-index: 1;
    }

    .qa-title {
        font-size: 22px;
        font-weight: 900;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .qa-subtitle {
        font-size: 13px;
        font-weight: 500;
        opacity: 0.8;
        margin-top: 4px;
    }

    /* ========================================================
           PANELES DE DATOS (KPIs y Gráficos)
        ======================================================== */
    .data-panel {
        background: var(--bg-panel);
        border: 1px solid var(--border-soft);
        border-radius: 16px;
        padding: 24px;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-md);
        position: relative;
    }

        .data-panel:hover {
            border-color: #cbd5e1;
            box-shadow: var(--shadow-lg);
        }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .panel-title {
        font-size: 13px;
        font-weight: 800;
        color: var(--txt-main);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .panel-icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #f3e8ff;
        color: var(--atilson-purple);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .kpi-title {
        font-size: 11px;
        color: var(--txt-muted);
        text-transform: uppercase;
        font-weight: 800;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .kpi-value {
        font-size: 42px;
        color: var(--atilson-dark);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -1.5px;
    }

    .kpi-sub {
        font-size: 11px;
        font-weight: 800;
        margin-top: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
    }

    /* ========================================================
           TABLA DE ÚLTIMAS OPERACIONES
        ======================================================== */
    .table-erp {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-erp th {
            font-size: 10px;
            text-transform: uppercase;
            color: var(--txt-muted);
            font-weight: 800;
            padding: 16px 20px;
            border-bottom: 2px solid var(--border-soft);
            background-color: #f8fafc;
        }

        .table-erp td {
            font-size: 13px;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-soft);
            color: var(--txt-main);
            font-weight: 600;
            vertical-align: middle;
        }

        .table-erp tr:hover td {
            background-color: #f1f5f9;
            cursor: pointer;
        }

    .bkg-ref {
        color: var(--atilson-purple);
        font-family: 'SFMono-Regular', Consolas, monospace;
        font-weight: 900;
    }

    .status-badge {
        font-size: 10px;
        font-weight: 800;
        padding: 6px 12px;
        border-radius: 6px;
        text-transform: uppercase;
        border: 1px solid transparent;
        display: inline-block;
    }
</style>

<div class="container-fluid pt-4 pb-5 px-4" style="max-width: 1700px;">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4 fade-in">
        <div>
            <h1 style="font-size: 28px; font-weight: 900; color: var(--atilson-dark); margin: 0; letter-spacing: -1px;">¡Hola, @(User.Identity?.Name ?? "Equipo Atilson")!</h1>
            <p class="text-muted fw-bold m-0 mt-1" style="font-size: 14px;">Centro de Mando Logístico y Financiero.</p>
        </div>
        <div class="text-end">
            <div style="font-family: 'SFMono-Regular', Consolas, monospace; font-size: 24px; font-weight: 700; color: var(--atilson-purple);" id="systemClock">--:--:--</div>
            <div style="font-size: 11px; font-weight: 800; color: var(--txt-muted); text-transform: uppercase;">@DateTime.Now.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-ES"))</div>
        </div>
    </div>

    <!-- 🚀 3 BOTONES GIGANTES DE ACCESO DIRECTO 🚀 -->
    <div class="row g-4 mb-5 fade-in d-1">
        <!-- BOTÓN OPERACIONES -->
        <div class="col-xl-4 col-md-6">
            <a href="/Operaciones/Index" class="quick-access-btn qa-ops">
                <i class="bi bi-gear-wide-connected qa-icon"></i>
                <div class="qa-content">
                    <h3 class="qa-title">Operaciones</h3>
                    <p class="qa-subtitle">Control de Bookings, Stacking y Matriz</p>
                </div>
            </a>
        </div>

        <!-- BOTÓN FINANZAS -->
        <div class="col-xl-4 col-md-6">
            <a href="/Finanzas/ControlFinanciero" class="quick-access-btn qa-fin">
                <i class="bi bi-wallet2 qa-icon"></i>
                <div class="qa-content">
                    <h3 class="qa-title">Control Financiero</h3>
                    <p class="qa-subtitle">Cruce de Ingresos, Egresos y Profit</p>
                </div>
            </a>
        </div>

        <!-- BOTÓN COMERCIAL -->
        <div class="col-xl-4 col-md-12">
            <a href="/Comercial/Index" class="quick-access-btn qa-com">
                <i class="bi bi-briefcase-fill qa-icon"></i>
                <div class="qa-content">
                    <h3 class="qa-title">Módulo Comercial</h3>
                    <p class="qa-subtitle">Tarifario, Proveedores y Solicitudes</p>
                </div>
            </a>
        </div>
    </div>

    <hr class="mb-5" style="border-top: 2px dashed #cbd5e1; opacity: 0.5;" />

    <!-- TOP KPIs -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 fade-in d-1">
            <div class="data-panel justify-content-center">
                <div class="kpi-title">Volumen Operativo</div>
                <div class="kpi-value">@Model.TotalBookings</div>
                <div><span class="kpi-sub" style="background: #f0f9ff; color: #0284c7; border: 1px solid #bae6fd;"><i class="bi bi-arrow-up-right"></i> Operaciones Activas</span></div>
            </div>
        </div>
        <div class="col-md-3 fade-in d-2">
            <div class="data-panel justify-content-center">
                <div class="kpi-title">Gestión Documental</div>
                <div class="kpi-value" style="color: #d97706;">@Model.CountMatricesPendientes</div>
                <div><span class="kpi-sub" style="background: #fffbeb; color: #d97706; border: 1px solid #fde68a;"><i class="bi bi-clock-history"></i> Matrices Pendientes</span></div>
            </div>
        </div>
        <div class="col-md-3 fade-in d-3">
            <div class="data-panel justify-content-center">
                <div class="kpi-title">Bookings Cancelados</div>
                <div class="kpi-value text-danger">@Model.CountCanceladas</div>
                <div><span class="kpi-sub" style="background: #fef2f2; color: #ef4444; border: 1px solid #fecaca;"><i class="bi bi-dash-circle"></i> No efectuados</span></div>
            </div>
        </div>
        <div class="col-md-3 fade-in d-4">
            <div class="data-panel justify-content-center" style="border-color: @(Model.CantidadCriticos > 0 ? "#fca5a5" : "var(--border-soft)");">
                <div class="kpi-title">Alertas Críticas (Cut-Off)</div>
                <div class="kpi-value" style="color: @(Model.CantidadCriticos > 0 ? "#ef4444" : "var(--txt-main)");">@Model.CantidadCriticos</div>
                <div>
                    @if (Model.CantidadCriticos > 0)
                    {
                        <span class="kpi-sub" style="background: #fef2f2; color: #ef4444; border: 1px solid #fecaca;"><i class="bi bi-cone-striped"></i> Acción Inmediata Requerida</span>
                    }
                    else
                    {
                        <span class="kpi-sub" style="background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0;"><i class="bi bi-check2-all"></i> Sin Vencimientos</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- GRÁFICOS INTERACTIVOS CON DATOS REALES -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4 fade-in d-2">
            <div class="data-panel">
                <div class="panel-header">
                    <h6 class="panel-title"><div class="panel-icon-box"><i class="bi bi-pie-chart-fill"></i></div> Mix de Servicios</h6>
                </div>
                <div class="flex-grow-1 position-relative" style="min-height: 250px;">
                    <canvas id="serviceChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 fade-in d-3">
            <div class="data-panel">
                <div class="panel-header">
                    <h6 class="panel-title"><div class="panel-icon-box" style="background: #f0f9ff; color: #0284c7;"><i class="bi bi-water"></i></div> Control Marítimo (LAR)</h6>
                </div>
                <div class="flex-grow-1 position-relative" style="min-height: 250px;">
                    <canvas id="maritimeChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 fade-in d-4">
            <div class="data-panel">
                <div class="panel-header">
                    <h6 class="panel-title"><div class="panel-icon-box" style="background: #fffbeb; color: #d97706;"><i class="bi bi-bar-chart-steps"></i></div> Workflow General</h6>
                </div>
                <div class="flex-grow-1 position-relative" style="min-height: 250px;">
                    <canvas id="bookingStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTIVIDAD RECIENTE -->
    <div class="row g-4 fade-in d-4 mb-5">
        <div class="col-lg-4">
            <div class="data-panel">
                <div class="panel-header border-bottom pb-3 mb-4">
                    <h6 class="panel-title"><div class="panel-icon-box" style="background: #f0fdf4; color: #16a34a;"><i class="bi bi-folder-check"></i></div> Desempeño Documental</h6>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size: 11px; color: var(--txt-muted); font-weight: 800; text-transform: uppercase;">Matrices Confirmadas</span>
                    <span style="font-size: 12px; color: var(--txt-main); font-weight: 900;">@Model.CountMatricesConfirmadas de @Model.TotalMatrices</span>
                </div>
                <div class="progress mb-2" style="height: 16px; background: #f1f5f9; border-radius: 8px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.PctConfirmadas%; border-radius: 8px;"></div>
                </div>
                <p class="text-end fw-bold m-0" style="font-size: 12px; color: #16a34a;">@Model.PctConfirmadas% Completado</p>

                <div class="mt-auto pt-4">
                    <div class="d-flex align-items-center gap-3 p-3 rounded" style="background: #f8fafc; border: 1px dashed #cbd5e1;">
                        <i class="bi bi-info-circle text-muted fs-4"></i>
                        <span style="font-size: 11px; color: var(--txt-muted); font-weight: 600;">Porcentaje de matrices enviadas y confirmadas por naviera respecto al total de operaciones activas.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="data-panel p-0">
                <div class="panel-header border-bottom p-4 m-0" style="background-color: #fafbfd; border-radius: 16px 16px 0 0;">
                    <h6 class="panel-title m-0"><div class="panel-icon-box" style="background: #f1f5f9; color: var(--txt-main);"><i class="bi bi-list-nested"></i></div> Panel de Operaciones Recientes</h6>
                    <a asp-page="/Operaciones/Index" class="btn btn-sm fw-bold px-4 shadow-sm" style="background-color: var(--atilson-dark); color: white; font-size: 11px; border-radius: 8px;">VER TABLA COMPLETA</a>
                </div>
                <div class="table-responsive">
                    <table class="table-erp m-0">
                        <thead>
                            <tr>
                                <th class="ps-4">N° Booking</th>
                                <th>Cliente Exportador</th>
                                <th>Destino (POD)</th>
                                <th>Fase Operativa</th>
                                <th class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UltimasOperaciones != null && Model.UltimasOperaciones.Any())
                            {
                                @foreach (var op in Model.UltimasOperaciones)
                                {
                                    var estadoFlow = (op.EstadoWorkflow ?? "SOLICITADO").ToUpper();
                                    var estBg = "#f8fafc"; var estTxt = "#64748b"; var estBorder = "transparent";

                                    if (estadoFlow.Contains("SOLICITADO") || estadoFlow.Contains("CONFIRMADO") || estadoFlow.Contains("ENVIO"))
                                    { estBg = "#fefce8"; estTxt = "#d97706"; estBorder = "#fde047"; }
                                    else if (estadoFlow.Contains("EN RUTA") || estadoFlow.Contains("ENTREGADO"))
                                    { estBg = "#f0f9ff"; estTxt = "#0284c7"; estBorder = "#bae6fd"; }
                                    else if (estadoFlow.Contains("EMBARCADO") || estadoFlow.Contains("ZARPE") || estadoFlow.Contains("PROXIMO"))
                                    { estBg = "#faf5ff"; estTxt = "#7e22ce"; estBorder = "#e9d5ff"; }
                                    else if (estadoFlow.Contains("ARRIBADO") || estadoFlow.Contains("FINALIZADO") || estadoFlow.Contains("RETIRADO"))
                                    { estBg = "#f0fdf4"; estTxt = "#16a34a"; estBorder = "#bbf7d0"; }
                                    else if (estadoFlow.Contains("CANCELADO"))
                                    { estBg = "#fef2f2"; estTxt = "#dc2626"; estBorder = "#fecaca"; }

                                    <tr onclick="window.location.href='/Operaciones/Edit?id=@op.Id'">
                                        <td class="bkg-ref ps-4">@op.NumeroBooking</td>
                                        <td>@(op.IdClienteNavigation?.RazonSocial ?? op.IdClienteNavigation?.NombreCliente ?? "S/N")</td>
                                        <td><i class="bi bi-geo-alt-fill text-muted opacity-50 me-1"></i> @(op.IdPuertoDestinoNavigation?.NombrePuerto ?? "TBA")</td>
                                        <td><span class="status-badge" style="background-color: @estBg; color: @estTxt; border: 1px solid @estBorder;">@estadoFlow</span></td>
                                        <td class="text-end pe-4"><i class="bi bi-arrow-right-circle text-muted fs-5"></i></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center text-muted py-5 fw-bold" style="font-size: 12px;">No hay operaciones recientes registradas.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // RELOJ DIGITAL
            function updateClock() {
                const now = new Date();
                let h = now.getHours().toString().padStart(2, '0');
                let m = now.getMinutes().toString().padStart(2, '0');
                let s = now.getSeconds().toString().padStart(2, '0');
                let clockEl = document.getElementById('systemClock');
                if (clockEl) clockEl.innerHTML = `${h}<span>:</span>${m}<span>:</span>${s}`;
            }
            setInterval(updateClock, 1000);
            updateClock();

            // Configuración Global Chart.js
            Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
            Chart.defaults.color = '#64748b';
            Chart.defaults.plugins.tooltip.backgroundColor = '#0f172a';
            Chart.defaults.plugins.tooltip.padding = 12;
            Chart.defaults.plugins.tooltip.cornerRadius = 8;
            Chart.defaults.plugins.tooltip.titleFont = { size: 13, weight: 'bold' };

            // 1. MIX DE SERVICIOS (DOUGHNUT)
            const ctxServ = document.getElementById('serviceChart');
            if (ctxServ) {
                new Chart(ctxServ, {
                    type: 'doughnut',
                    data: {
                        labels: ['Integral', 'Marítimo', 'Transporte', 'Documental'],
                        datasets: [{
                            data: [@Model.CountIntegral, @Model.CountMaritimo, @Model.CountTerrestre, @Model.CountDocumental],
                            backgroundColor: ['#0f172a', '#0ea5e9', '#10b981', '#9333ea'],
                            borderWidth: 4,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false, cutout: '75%',
                        plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20, font: { size: 11, weight: '700' } } } }
                    }
                });
            }

            // 2. ESTADO MARÍTIMO LAR (DOUGHNUT)
            const ctxMar = document.getElementById('maritimeChart');
            if (ctxMar) {
                new Chart(ctxMar, {
                    type: 'doughnut',
                    data: {
                        labels: ['A Tiempo (Sin LAR)', 'Con Late Arrival'],
                        datasets: [{
                            data: [@Model.CountMaritimoATiempo, @Model.CountMaritimoConLAR],
                            backgroundColor: ['#10b981', '#f59e0b'],
                            borderWidth: 4,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false, cutout: '75%',
                        plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20, font: { size: 11, weight: '700' } } } }
                    }
                });
            }

            // 3. ESTATUS DE BOOKINGS (BAR)
            const ctxBkg = document.getElementById('bookingStatusChart');
            if (ctxBkg) {
                new Chart(ctxBkg, {
                    type: 'bar',
                    data: {
                        labels: ['Sol. Naviera', 'Conf. Cliente', 'Canceladas'],
                        datasets: [{
                            label: 'Operaciones',
                            data: [@Model.CountPendienteNaviera, @Model.CountConfirmadoCliente, @Model.CountCanceladas],
                            backgroundColor: ['#f59e0b', '#0ea5e9', '#ef4444'],
                            borderRadius: 8,
                            barPercentage: 0.6
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false }, border: { display: false }, ticks: { font: { size: 11, weight: '700' } } },
                            y: { beginAtZero: true, grid: { borderDash: [4, 4] }, border: { display: false }, ticks: { stepSize: 1 } }
                        }
                    }
                });
            }
        });
    </script>
}