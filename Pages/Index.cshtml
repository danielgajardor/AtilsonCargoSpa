@page
@model AtilsonCargoSpa.Pages.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atilson Cargo - Digital Freight Forwarder</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
            :root {
                /* PALETA CORPORATIVA ATILSON PURA */
                --atilson-purple: #6d2d9e;
                --atilson-purple-light: #9b51e0;
                --atilson-purple-dark: #3b1459;
                --bg-light: #ffffff;
                --bg-soft: #f8fafc;
                --bg-input: #f1f5f9;
                --bg-dark: #0f172a;
                --bg-deep: #020617;
                --text-dark: #0f172a;
                --text-muted: #64748b;
                --text-light: #f8fafc;
                --border-soft: #e2e8f0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-light);
                color: var(--text-dark);
                overflow-x: hidden;
                scroll-behavior: smooth;
            }

            /* ========================================================= */
            /* TOP BAR ELEGANTE (LUMINOSA Y SERIA CON TICKER)            */
            /* ========================================================= */
            .top-bar {
                background-color: var(--bg-deep);
                color: var(--text-muted);
                font-size: 11px;
                font-weight: 700;
                padding: 10px 0;
                border-bottom: 1px solid rgba(255,255,255,0.05);
                position: relative;
                z-index: 1001;
            }

            .social-links a {
                color: var(--text-muted);
                font-size: 14px;
                margin-right: 15px;
                transition: color 0.3s;
            }

                .social-links a:hover {
                    color: var(--atilson-purple-light);
                }

            .contact-top-links a {
                color: var(--text-muted);
                text-decoration: none;
                margin-left: 20px;
                transition: color 0.3s;
            }

                .contact-top-links a:hover {
                    color: #ffffff;
                }

            .contact-top-links i {
                color: var(--atilson-purple-light);
                margin-right: 6px;
                font-size: 13px;
            }

            .ticker-divider {
                width: 1px;
                height: 14px;
                background-color: rgba(255,255,255,0.15);
                margin: 0 15px;
            }

            .news-ticker-text {
                font-weight: 500;
                transition: opacity 0.4s ease;
                text-decoration: none;
            }

                .news-ticker-text:hover {
                    color: var(--atilson-purple-light) !important;
                }

            /* ========================================================= */
            /* NAVBAR GLASSMORPHISM                                      */
            /* ========================================================= */
            .navbar-atilson {
                position: absolute;
                width: 100%;
                top: 40px;
                z-index: 1000;
                padding: 20px 0;
                transition: all 0.4s ease;
                background: transparent;
            }

                .navbar-atilson.scrolled {
                    position: fixed;
                    background: rgba(255, 255, 255, 0.95);
                    backdrop-filter: blur(10px);
                    -webkit-backdrop-filter: blur(10px);
                    padding: 12px 0;
                    top: 0;
                    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
                    border-bottom: 1px solid var(--border-soft);
                }

            .navbar-logo {
                max-height: 45px;
                filter: brightness(0) invert(1);
                transition: all 0.3s ease;
            }

            .navbar-atilson.scrolled .navbar-logo {
                filter: none;
            }

            .navbar-logo:hover {
                transform: scale(1.02);
            }

            .nav-link {
                color: #ffffff !important;
                font-weight: 700;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin: 0 15px;
                transition: all 0.3s;
            }

            .navbar-atilson.scrolled .nav-link {
                color: var(--text-dark) !important;
            }

                .nav-link:hover, .navbar-atilson.scrolled .nav-link:hover {
                    color: var(--atilson-purple) !important;
                }

            .btn-portal {
                background-color: var(--atilson-purple);
                color: white !important;
                font-weight: 800;
                font-size: 12px;
                padding: 10px 24px;
                border-radius: 50px;
                text-transform: uppercase;
                letter-spacing: 1px;
                transition: all 0.3s ease;
                text-decoration: none;
                border: none;
                box-shadow: 0 4px 15px rgba(109, 45, 158, 0.3);
            }

                .btn-portal:hover {
                    background-color: var(--atilson-purple-dark);
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(109, 45, 158, 0.4);
                }

            /* ========================================================= */
            /* HERO CARRUSEL Y WIDGET FIJO                               */
            /* ========================================================= */
            .hero-section {
                position: relative;
                height: 100vh;
                min-height: 750px;
            }

            .hero-carousel, .carousel-inner, .carousel-item {
                height: 100%;
                width: 100%;
                position: absolute;
                top: 0;
                left: 0;
            }

            .carousel-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .carousel-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, rgba(15,23,42,0.85) 0%, rgba(109, 45, 158, 0.65) 100%);
                z-index: 1;
            }

            .carousel-caption-custom {
                position: absolute;
                top: 40%;
                transform: translateY(-50%);
                left: 8%;
                z-index: 2;
                text-align: left;
                max-width: 650px;
            }

            .hero-tag {
                background: var(--atilson-purple);
                color: #ffffff;
                padding: 6px 15px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 2px;
                text-transform: uppercase;
                display: inline-block;
                margin-bottom: 20px;
                box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            }

            .hero-title {
                font-size: 64px;
                font-weight: 900;
                line-height: 1.1;
                letter-spacing: -2px;
                margin-bottom: 20px;
                color: #ffffff;
                text-shadow: 0 4px 15px rgba(0,0,0,0.6);
            }

                .hero-title span {
                    color: #d8b4fe;
                }

            .hero-subtitle {
                font-size: 18px;
                font-weight: 400;
                color: #f1f5f9;
                line-height: 1.6;
                margin-bottom: 40px;
                text-shadow: 0 2px 10px rgba(0,0,0,0.8);
            }

            /* WIDGET FIJO SOBRE EL CARRUSEL */
            .static-tracking-container {
                position: absolute;
                bottom: 20%;
                left: 50%;
                transform: translateX(-50%);
                z-index: 5;
                width: 100%;
                max-width: 650px;
                padding: 0 20px;
            }

            .tracking-widget {
                background: #ffffff;
                padding: 8px;
                border-radius: 12px;
                display: flex;
                box-shadow: 0 20px 40px rgba(0,0,0,0.4);
                width: 100%;
            }

            .tracking-input {
                background: transparent;
                border: none;
                color: var(--text-dark);
                padding: 15px 20px;
                width: 100%;
                outline: none;
                font-weight: 600;
                font-size: 15px;
            }

                .tracking-input::placeholder {
                    color: var(--text-muted);
                    font-weight: 400;
                }

            .tracking-btn {
                background: var(--atilson-purple);
                color: white;
                border: none;
                padding: 0 35px;
                border-radius: 8px;
                font-weight: 800;
                text-transform: uppercase;
                font-size: 13px;
                transition: all 0.3s;
            }

                .tracking-btn:hover {
                    background: var(--atilson-purple-dark);
                }

            /* ========================================================= */
            /* BARRA E-SERVICES (BLANCA IMPECABLE)                       */
            /* ========================================================= */
            .e-services-bar {
                background: #ffffff;
                border-bottom: 1px solid var(--border-soft);
                box-shadow: 0 10px 30px rgba(0,0,0,0.03);
                position: relative;
                z-index: 10;
                margin-top: -5px;
            }

            .service-tab {
                padding: 25px 20px;
                text-align: center;
                color: var(--text-dark);
                text-decoration: none;
                font-weight: 800;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 1px;
                transition: all 0.3s;
                border-right: 1px solid var(--border-soft);
                display: block;
            }

                .service-tab:first-child {
                    border-left: 1px solid var(--border-soft);
                }

                .service-tab:hover {
                    color: var(--atilson-purple);
                    background: var(--bg-soft);
                }

                .service-tab i {
                    display: block;
                    font-size: 28px;
                    margin-bottom: 8px;
                    color: var(--atilson-purple);
                    transition: transform 0.3s;
                }

                .service-tab:hover i {
                    transform: translateY(-3px);
                }

            /* ========================================================= */
            /* SECCIONES (SERVICIOS)                                     */
            /* ========================================================= */
            .section-padding {
                padding: 100px 0;
            }

            .section-header {
                text-align: center;
                margin-bottom: 70px;
            }

            .section-tag {
                color: var(--atilson-purple);
                font-size: 11px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 2px;
                display: block;
                margin-bottom: 10px;
            }

            .section-title {
                font-size: 42px;
                font-weight: 900;
                letter-spacing: -1.5px;
                margin-bottom: 15px;
                color: var(--text-dark);
            }

            .service-card {
                background: #ffffff;
                border: 1px solid var(--border-soft);
                border-radius: 16px;
                padding: 45px 35px;
                transition: all 0.4s ease;
                height: 100%;
                position: relative;
                overflow: hidden;
                box-shadow: 0 4px 10px rgba(0,0,0,0.02);
            }

                .service-card::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 4px;
                    background: var(--atilson-purple);
                    transform: scaleX(0);
                    transform-origin: left;
                    transition: transform 0.4s ease;
                }

                .service-card:hover {
                    transform: translateY(-10px);
                    box-shadow: 0 20px 40px rgba(109, 45, 158, 0.1);
                    border-color: var(--atilson-purple-light);
                }

                    .service-card:hover::before {
                        transform: scaleX(1);
                    }

            .service-icon {
                font-size: 45px;
                color: var(--atilson-purple);
                margin-bottom: 25px;
                display: inline-block;
                transition: transform 0.3s;
            }

            .service-card:hover .service-icon {
                transform: scale(1.05);
            }

            .service-card h3 {
                font-size: 20px;
                font-weight: 800;
                margin-bottom: 15px;
                color: var(--text-dark);
            }

            .service-card p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.7;
                margin: 0;
            }

            /* ========================================================= */
            /* MARKET & NEWS (FONDO GRIS SUAVE)                          */
            /* ========================================================= */
            .news-section {
                background-color: var(--bg-soft);
                border-top: 1px solid var(--border-soft);
                position: relative;
                overflow: hidden;
            }

            .news-slider-wrapper {
                position: relative;
                width: 100%;
                padding: 20px 0;
                overflow: hidden;
            }

            .news-slider-track {
                display: flex;
                gap: 24px;
                transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
                will-change: transform;
            }

            .slider-btn {
                position: absolute;
                top: 45%;
                transform: translateY(-50%);
                width: 50px;
                height: 50px;
                border-radius: 50%;
                background: #ffffff;
                border: 1px solid var(--border-soft);
                color: var(--atilson-purple);
                font-size: 22px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                box-shadow: 0 10px 25px rgba(15, 23, 42, 0.1);
                z-index: 10;
                transition: all 0.3s ease;
            }

                .slider-btn:hover {
                    background: var(--atilson-purple);
                    color: #fff;
                    transform: translateY(-50%) scale(1.1);
                    box-shadow: 0 10px 25px rgba(109, 45, 158, 0.3);
                }

            .slider-btn-prev {
                left: 15px;
            }

            .slider-btn-next {
                right: 15px;
            }

            .news-card {
                min-width: 380px;
                max-width: 380px;
                flex: 0 0 auto;
                background: #ffffff;
                border: 1px solid var(--border-soft);
                border-radius: 16px;
                height: 100%;
                transition: all 0.4s ease;
                display: flex;
                flex-direction: column;
                box-shadow: 0 10px 20px rgba(15, 23, 42, 0.03);
            }

                .news-card:hover {
                    transform: translateY(-8px);
                    box-shadow: 0 20px 40px rgba(109, 45, 158, 0.15);
                    border-color: var(--atilson-purple-light);
                }

            .img-wrapper {
                overflow: hidden;
                border-top-left-radius: 16px;
                border-top-right-radius: 16px;
                height: 220px;
                background-color: var(--border-soft);
            }

            .news-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.6s ease;
            }

            .news-card:hover .news-img {
                transform: scale(1.08);
            }

            .news-content {
                padding: 30px;
                display: flex;
                flex-direction: column;
                flex-grow: 1;
                background: #fff;
                border-bottom-left-radius: 16px;
                border-bottom-right-radius: 16px;
            }

            .news-date {
                font-size: 11px;
                color: var(--atilson-purple);
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 12px;
            }

            .news-title {
                font-size: 18px;
                font-weight: 800;
                margin-bottom: 12px;
                line-height: 1.4;
                color: var(--text-dark);
            }

            .news-desc {
                font-size: 13px;
                color: var(--text-muted);
                line-height: 1.6;
                margin-bottom: 20px;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .news-link {
                margin-top: auto;
                font-size: 12px;
                font-weight: 800;
                color: var(--atilson-purple);
                text-decoration: none;
                text-transform: uppercase;
                display: inline-flex;
                align-items: center;
                transition: all 0.2s;
            }

                .news-link i {
                    margin-left: 8px;
                    transition: margin 0.2s;
                }

                .news-link:hover {
                    color: var(--atilson-purple-dark);
                }

                    .news-link:hover i {
                        margin-left: 15px;
                    }

            @@media (max-width: 768px) {
                .news-card {
                    min-width: 300px;
                    max-width: 300px;
                }

                .slider-btn {
                    display: none;
                }

                .news-slider-wrapper {
                    overflow-x: auto;
                    scroll-snap-type: x mandatory;
                    padding: 10px 20px;
                }

                .news-slider-track {
                    scroll-snap-align: start;
                    transition: none;
                }

                .hero-title {
                    font-size: 42px;
                }

                .static-tracking-container {
                    bottom: 10%;
                }
            }

            /* ========================================================= */
            /* RED GLOBAL (CONTRASTE OSCURO)                             */
            /* ========================================================= */
            .global-section {
                padding: 120px 0;
                background-color: var(--bg-dark);
                position: relative;
                color: white;
                overflow: hidden;
                border-top: 1px solid rgba(255,255,255,0.02);
            }

            .map-container {
                width: 100%;
                height: 100%;
                background-image: url('https://upload.wikimedia.org/wikipedia/commons/8/80/World_map_-_low_resolution.svg');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                opacity: 0.05;
                filter: invert(1);
                position: absolute;
                top: 0;
                left: 0;
                z-index: 0;
            }

            .global-content {
                position: relative;
                z-index: 1;
            }

                .global-content .section-title {
                    color: #ffffff;
                }

            /* ========================================================= */
            /* CONTACTO (FORMULARIO ALTO CONTRASTE)                      */
            /* ========================================================= */
            .contact-section {
                background-color: var(--bg-light);
                border-top: 1px solid var(--border-soft);
            }

            .contact-card {
                background: #ffffff;
                padding: 50px;
                border-radius: 20px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.08);
                border: 1px solid var(--border-soft);
            }

            .contact-icon-box {
                width: 50px;
                height: 50px;
                border-radius: 12px;
                background: rgba(109, 45, 158, 0.1);
                color: var(--atilson-purple);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
            }

            .form-control-custom {
                background: var(--bg-input);
                border: 1px solid var(--border-soft);
                color: var(--text-dark);
                padding: 15px 20px;
                border-radius: 8px;
                font-weight: 500;
                font-size: 14px;
                transition: all 0.3s;
            }

                .form-control-custom:focus {
                    border-color: var(--atilson-purple);
                    box-shadow: 0 0 0 3px rgba(109, 45, 158, 0.15);
                    background: #ffffff;
                    outline: none;
                }

                .form-control-custom::placeholder {
                    color: var(--text-muted);
                }

            .btn-submit {
                background: var(--atilson-purple);
                color: white;
                border: none;
                border-radius: 8px;
                font-weight: 800;
                padding: 15px;
                width: 100%;
                transition: all 0.3s;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

                .btn-submit:hover {
                    background: var(--atilson-purple-dark);
                    transform: translateY(-2px);
                    box-shadow: 0 10px 20px rgba(109, 45, 158, 0.3);
                }

            /* ========================================================= */
            /* FOOTER CORPORATIVO                                        */
            /* ========================================================= */
            .footer-area {
                background-color: var(--bg-deep);
                padding: 80px 0 30px;
                border-top: 1px solid rgba(255,255,255,0.05);
            }

            .footer-logo {
                max-height: 45px;
                filter: brightness(0) invert(1);
                margin-bottom: 25px;
                opacity: 0.9;
            }

            .footer-title {
                color: #fff;
                font-size: 14px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 25px;
            }

            .footer-text {
                color: #cbd5e1;
                font-size: 13px;
                line-height: 1.8;
                opacity: 0.9;
            }

            .footer-link {
                color: #cbd5e1;
                text-decoration: none;
                display: block;
                margin-bottom: 12px;
                font-size: 13px;
                transition: all 0.3s;
                opacity: 0.9;
            }

                .footer-link:hover {
                    color: #fff;
                    padding-left: 5px;
                    opacity: 1;
                }

            .footer-icon {
                color: var(--atilson-purple-light);
                margin-right: 8px;
                font-size: 14px;
            }

            /* BOTÓN WHATSAPP IA (SERIO) */
            .wapp-float {
                position: fixed;
                width: 60px;
                height: 60px;
                bottom: 40px;
                right: 40px;
                background-color: #25d366;
                color: #fff;
                border-radius: 50px;
                text-align: center;
                font-size: 30px;
                box-shadow: 0 10px 20px rgba(37, 211, 102, 0.3);
                z-index: 9999;
                display: flex;
                justify-content: center;
                align-items: center;
                text-decoration: none;
                transition: all 0.3s ease;
                animation: pulse-wapp 2s infinite;
            }

                .wapp-float:hover {
                    background-color: #128c7e;
                    color: #fff;
                    transform: scale(1.1);
                }

            .wapp-tooltip {
                position: absolute;
                right: 75px;
                top: 50%;
                transform: translateY(-50%);
                background: white;
                color: var(--text-dark);
                padding: 10px 18px;
                border-radius: 8px;
                font-size: 12px;
                font-weight: 800;
                white-space: nowrap;
                letter-spacing: 0.5px;
                box-shadow: 0 10px 25px rgba(15, 23, 42, 0.15);
                opacity: 0;
                pointer-events: none;
                transition: all 0.3s ease;
                border: 1px solid var(--border-soft);
            }

                .wapp-tooltip::after {
                    content: '';
                    position: absolute;
                    right: -6px;
                    top: 50%;
                    transform: translateY(-50%);
                    border-width: 6px 0 6px 6px;
                    border-style: solid;
                    border-color: transparent transparent transparent white;
                }

            .wapp-float:hover .wapp-tooltip {
                opacity: 1;
                right: 80px;
            }

            @@keyframes pulse-wapp {
                0% {
                    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
                }

                70% {
                    box-shadow: 0 0 0 15px rgba(37, 211, 102, 0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
                }
            }

            .reveal {
                opacity: 0;
                transform: translateY(30px);
                transition: all 0.8s ease-out;
            }

                .reveal.active {
                    opacity: 1;
                    transform: translateY(0);
                }
    </style>
</head>
<body>

    <div class="top-bar d-none d-lg-block">
        <div class="container d-flex justify-content-between align-items-center">

            <div class="social-links d-flex align-items-center">
                <span class="me-3" style="color: #64748b;">Redes:</span>
                <a href="https://www.linkedin.com/company/atilson-cargo/?originalSubdomain=cl" target="_blank" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                <a href="#" target="_blank" title="Instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" target="_blank" title="Facebook"><i class="bi bi-facebook"></i></a>
            </div>

            <div class="d-flex align-items-center flex-grow-1 justify-content-center mx-3" style="font-size: 11px;">
                <div class="d-flex align-items-center" title="Tipo de Cambio Banco Central">
                    <span class="text-muted me-2"><i class="bi bi-graph-up-arrow"></i></span>
