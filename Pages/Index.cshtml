    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        // 1. SCROLL NAVBAR FIX
        window.addEventListener('scroll', function() {
        const navbar = document.getElementById('navbar');
        const logo = document.getElementById('logo-img');

        if (window.scrollY > 40) {
        navbar.classList.add('scrolled');
        if(logo) logo.style.filter = "none";
        } else {
        navbar.classList.remove('scrolled');
        if(logo) logo.style.filter = "brightness(0) invert(1)";
        }
        });

        // 2. ANIMACIÓN REVEAL Y CONTADORES
        function animateValue(obj, start, end, duration) {
        let startTimestamp = null;
        const step = (timestamp) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        obj.innerHTML = Math.floor(progress * (end - start) + start);
        if (progress < 1) window.requestAnimationFrame(step);
        else obj.innerHTML = end;
        };
        window.requestAnimationFrame(step);
        }

        function reveal() {
        var reveals = document.querySelectorAll(".reveal");
        for (var i = 0; i < reveals.length; i++) {
        var windowHeight = window.innerHeight;
        var elementTop = reveals[i].getBoundingClientRect().top;
        if (elementTop < windowHeight - 50) {
        if (!reveals[i].classList.contains("active")) {
        reveals[i].classList.add("active");
        if (reveals[i].classList.contains("stats-box")) {
        let counters = reveals[i].querySelectorAll(".counter");
        counters.forEach(c => animateValue(c, 0, parseInt(c.getAttribute("data-target")), 2000));
        }
        }
        }
        }
        }
        window.addEventListener("scroll", reveal);
        reveal();

        // ========================================================
        // 3. API FINANCIERA (AHORA CON UF INCLUIDA)
        // ========================================================
        fetch('https://mindicador.cl/api')
        .then(response => response.json())
        .then(data => {
        const formatNum = (num) => new Intl.NumberFormat('es-CL').format(num);
        document.getElementById('top-uf').innerText = '$' + formatNum(data.uf.valor);
        document.getElementById('top-usd').innerText = '$' + formatNum(data.dolar.valor);
        document.getElementById('top-eur').innerText = '$' + formatNum(data.euro.valor);
        })
        .catch(error => {
        console.error("Error cargando indicadores:", error);
        document.getElementById('top-uf').innerText = 'N/D';
        document.getElementById('top-usd').innerText = 'N/D';
        document.getElementById('top-eur').innerText = 'N/D';
        });

        // ========================================================
        // 4. API NOTICIAS (MUNDO MARÍTIMO) CON SLIDER Y TICKER
        // ========================================================
        const newsTrack = document.getElementById('news-track');
        const topTicker = document.getElementById('top-news-ticker');
        const rssUrl = 'https://api.rss2json.com/v1/api.json?rss_url=https%3A%2F%2Fwww.mundomaritimo.cl%2Fnoticias%2Ffeed';

        const fallbackImages = [
        'https://images.unsplash.com/photo-1551281442-f8c5b96791b8?auto=format&fit=crop&w=800&q=80',
        'https://images.unsplash.com/photo-1586528116311-ad8ed7c83a50?auto=format&fit=crop&w=800&q=80',
        'https://images.unsplash.com/photo-1494412651409-8963ce7935a7?auto=format&fit=crop&w=800&q=80',
        'https://images.unsplash.com/photo-1577705998148-ebad79550ee6?auto=format&fit=crop&w=800&q=80',
        'https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=800&q=80',
        'https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=800&q=80'
        ];

        fetch(rssUrl)
        .then(res => res.json())
        .then(data => {
        if (data.status === 'ok' && data.items.length > 0) {
        renderNews(data.items.slice(0, 9));
        startTopTicker(data.items.slice(0, 5));
        } else {
        throw new Error("No items");
        }
        })
        .catch(error => {
        console.error('Error RSS, usando Fallback:', error);
        const defaultNews = [
        { title: "Atilson Cargo presenta su ecosistema ERP.", pubDate: "Hoy", description: "Lanzamiento oficial de la plataforma para potenciar el comercio exterior.", link: "#", imgIndex: 0 },
        { title: "Impacto tecnológico en fletes marítimos.", pubDate: "Ayer", description: "Cómo la IA y la automatización están reduciendo costos operativos globales.", link: "#", imgIndex: 1 },
        { title: "Trazabilidad 24/7 en la cadena de frío.", pubDate: "Hace 3 días", description: "Control total de temperatura para resguardar la fruta de exportación.", link: "#", imgIndex: 3 },
        { title: "Nuevas regulaciones aduaneras 2026.", pubDate: "Hace 1 semana", description: "La digitalización documental y su rol en la agilidad portuaria.", link: "#", imgIndex: 4 }
        ];
        renderFallbackNews(defaultNews);
        startTopTicker(defaultNews);
        });

        function startTopTicker(articles) {
        if(!topTicker || articles.length === 0) return;
        let tickerIndex = 0;
        topTicker.innerText = articles[0].title;
        topTicker.href = articles[0].link;

        setInterval(() => {
        topTicker.style.opacity = 0;
        setTimeout(() => {
        tickerIndex = (tickerIndex + 1) % articles.length;
        topTicker.innerText = articles[tickerIndex].title;
        topTicker.href = articles[tickerIndex].link;
        topTicker.style.opacity = 1;
        }, 400);
        }, 6000);
        }

        function renderNews(articles) {
        newsTrack.innerHTML = '';

        articles.forEach((article, index) => {
        let dateStr = article.pubDate.substring(0, 10);

        let imgUrl = "";
        if (article.thumbnail && article.thumbnail !== "") {
        imgUrl = article.thumbnail;
        } else if (article.enclosure && article.enclosure.link) {
        imgUrl = article.enclosure.link;
        } else {
        let tempDiv = document.createElement('div');
        tempDiv.innerHTML = article.description || article.content;
        let imgTag = tempDiv.querySelector('img');
        if (imgTag && imgTag.src) { imgUrl = imgTag.src; }
        else { imgUrl = fallbackImages[index % fallbackImages.length]; }
        }

        let tempText = document.createElement('div');
        tempText.innerHTML = article.description || "";
        let cleanDesc = tempText.textContent || tempText.innerText || "";
        let shortDesc = cleanDesc.length > 120 ? cleanDesc.substring(0, 120) + "..." : cleanDesc;

        const html = `
        <div class="news-card">
        <div class="img-wrapper">
        <img src="${imgUrl}" alt="Noticia Logística" class="news-img" onerror="this.src='${fallbackImages[index % fallbackImages.length]}'">
        </div>
        <div class="news-content">
        <span class="news-date"><i class="bi bi-calendar3"></i> ${dateStr}</span>
        <h3 class="news-title">${article.title}</h3>
        <p class="news-desc">${shortDesc}</p>
        <a href="${article.link}" target="_blank" class="news-link">LEER ARTÍCULO <i class="bi bi-arrow-right"></i></a>
        </div>
        </div>`;
        newsTrack.insertAdjacentHTML('beforeend', html);
        });
        initSlider();
        }

        function renderFallbackNews(articles) {
        newsTrack.innerHTML = '';
        articles.forEach(article => {
        const html = `
        <div class="news-card">
        <div class="img-wrapper">
        <img src="${fallbackImages[article.imgIndex]}" alt="Noticia Logística" class="news-img">
        </div>
        <div class="news-content">
        <span class="news-date"><i class="bi bi-calendar3"></i> ${article.pubDate}</span>
        <h3 class="news-title">${article.title}</h3>
        <p class="news-desc">${article.description}</p>
        <a href="${article.link}" class="news-link">MÁS INFORMACIÓN <i class="bi bi-arrow-right"></i></a>
        </div>
        </div>`;
        newsTrack.insertAdjacentHTML('beforeend', html);
        });
        initSlider();
        }

        function initSlider() {
        const btnNextNews = document.getElementById('btn-next-news');
        const btnPrevNews = document.getElementById('btn-prev-news');

        let currentScrollPosition = 0;
        const cardWidth = 380 + 24;

        if (btnNextNews && btnPrevNews && newsTrack) {
        btnNextNews.addEventListener('click', () => {
        const maxScroll = newsTrack.scrollWidth - newsTrack.parentElement.clientWidth;
        if (currentScrollPosition < maxScroll) {
        currentScrollPosition += cardWidth;
        if (currentScrollPosition > maxScroll) currentScrollPosition = maxScroll;
        newsTrack.style.transform = `translateX(-${currentScrollPosition}px)`;
        }
        });

        btnPrevNews.addEventListener('click', () => {
        if (currentScrollPosition > 0) {
        currentScrollPosition -= cardWidth;
        if (currentScrollPosition < 0) currentScrollPosition = 0;
        newsTrack.style.transform = `translateX(-${currentScrollPosition}px)`;
        }
        });
        }
        }
        });
    </script>
</body>
</html>