@page
@model AtilsonCargoSpa.Pages.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atilson Cargo - Digital Freight Forwarder</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            /* PALETA CORPORATIVA ATILSON PURA */
            --atilson-purple: #6d2d9e;
            --atilson-purple-light: #9b51e0;
            --atilson-purple-dark: #3b1459;
            --atilson-purple-glow: rgba(109, 45, 158, 0.25);
            --bg-light: #ffffff;
            --bg-soft: #f8fafc;
            --bg-input: #f1f5f9;
            --bg-dark: #0f172a;
            --bg-deep: #020617;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --text-light: #f8fafc;
            --border-soft: #e2e8f0;
            --border-glass: rgba(255, 255, 255, 0.08);
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --shadow-md: 0 10px 25px -3px rgba(15, 23, 42, 0.08), 0 4px 10px -2px rgba(15, 23, 42, 0.04);
            --shadow-hover: 0 25px 50px -12px rgba(109, 45, 158, 0.15);
        }

        html {
            scroll-padding-top: 80px; /* Evita que el menú tape el contenido al hacer clic en enlaces */
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            overflow-x: hidden;
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::selection {
            background-color: var(--atilson-purple-light);
            color: white;
        }

        /* ========================================================= */
        /* TOP BAR ELEGANTE (LUMINOSA Y SERIA CON TICKER)            */
        /* ========================================================= */
        .top-bar {
            background-color: var(--bg-deep);
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-glass);
            position: relative;
            z-index: 1001;
            letter-spacing: 0.5px;
        }

        .social-links a {
            color: var(--text-muted);
            font-size: 14px;
            margin-right: 18px;
            transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s;
            display: inline-block;
        }

        .social-links a:hover {
            color: var(--atilson-purple-light);
            transform: translateY(-2px);
        }

        .contact-top-links a {
            color: var(--text-muted);
            text-decoration: none;
            margin-left: 24px;
            transition: color 0.3s;
            font-weight: 500;
        }

        .contact-top-links a:hover {
            color: #ffffff;
        }

        .contact-top-links i {
            color: var(--atilson-purple-light);
            margin-right: 8px;
            font-size: 13px;
        }

        .ticker-divider {
            width: 1px;
            height: 14px;
            background-color: var(--border-glass);
            margin: 0 20px;
        }

        /* Indicador de conexión en vivo (Punto verde parpadeante) */
        .live-indicator {
            width: 6px;
            height: 6px;
            background-color: #10b981;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
            box-shadow: 0 0 8px #10b981;
            animation: pulse-live 2s infinite;
        }

        @@keyframes pulse-live {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.8); }
            100% { opacity: 1; transform: scale(1); }
        }

        .news-ticker-text {
            font-weight: 500;
            transition: opacity 0.4s ease, color 0.3s;
            text-decoration: none;
            letter-spacing: 0.2px;
            color: #cbd5e1 !important;
        }

        .news-ticker-text:hover {
            color: var(--atilson-purple-light) !important;
        }

        /* ========================================================= */
        /* NAVBAR GLASSMORPHISM AVANZADO                             */
        /* ========================================================= */
        .navbar-atilson {
            position: absolute;
            width: 100%;
            top: 45px;
            z-index: 1000;
            padding: 24px 0;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            background: transparent;
        }

        .navbar-atilson.scrolled {
            position: fixed;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 16px 0;
            top: 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.5);
        }

        .navbar-logo {
            max-height: 42px;
            filter: brightness(0) invert(1);
            transition: all 0.4s ease;
        }

        .navbar-atilson.scrolled .navbar-logo {
            filter: brightness(0);
        }

        .navbar-logo:hover {
            transform: scale(1.03);
        }

        .nav-link {
            color: #ffffff !important;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            margin: 0 20px;
            transition: all 0.3s;
            position: relative;
            padding-bottom: 5px;
        }

        .navbar-atilson.scrolled .nav-link {
            color: var(--text-dark) !important;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: var(--atilson-purple);
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .nav-link:hover, .navbar-atilson.scrolled .nav-link:hover {
            color: var(--atilson-purple) !important;
            opacity: 1;
        }

        .btn-portal {
            background: linear-gradient(135deg, var(--atilson-purple) 0%, var(--atilson-purple-light) 100%);
            color: white !important;
            font-weight: 800;
            font-size: 13px;
            padding: 12px 30px;
            border-radius: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-decoration: none;
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 8px 16px var(--atilson-purple-glow);
            position: relative;
            overflow: hidden;
        }

        .btn-portal::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .btn-portal:hover::before {
            left: 100%;
        }

        .btn-portal:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(109, 45, 158, 0.4);
        }

        /* ========================================================= */
        /* HERO CARRUSEL & WIDGET                                    */
        /* ========================================================= */
        .hero-section {
            position: relative;
            height: 100vh;
            min-height: 800px;
            overflow: hidden;
            background-color: var(--bg-deep); /* Previene destellos al cargar */
        }

        .hero-carousel, .carousel-inner, .carousel-item {
            height: 100%;
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }

        .carousel-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            /* Zoom (Ken Burns) eliminado para mayor profesionalismo y claridad visual */
        }

        .carousel-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, rgba(2, 6, 23, 0.95) 0%, rgba(109, 45, 158, 0.5) 100%);
            z-index: 1;
        }

        .carousel-caption-custom {
            position: absolute;
            top: 45%;
            transform: translateY(-50%);
            left: 8%;
            z-index: 2;
            text-align: left;
            max-width: 750px;
        }

        .hero-tag {
            background: rgba(109, 45, 158, 0.2);
            border: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(8px);
            color: #ffffff;
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .hero-title {
            font-size: 76px;
            font-weight: 900;
            line-height: 1.05;
            letter-spacing: -2px;
            margin-bottom: 25px;
            color: #ffffff;
        }

        .hero-title span {
            background: linear-gradient(to right, #e9d5ff, #a855f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-subtitle {
            font-size: 20px;
            font-weight: 400;
            color: #cbd5e1;
            line-height: 1.6;
            margin-bottom: 50px;
            max-width: 650px;
        }

        /* WIDGET FIJO SOBRE EL CARRUSEL */
        .static-tracking-container {
            position: absolute;
            bottom: 12%;
            left: 50%;
            transform: translateX(-50%);
            z-index: 5;
            width: 100%;
            max-width: 800px;
            padding: 0 20px;
        }

        .tracking-widget {
            background: #ffffff;
            padding: 8px;
            border-radius: 12px;
            display: flex;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
            width: 100%;
            border: 1px solid rgba(255,255,255,0.8);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
        }
        
        .tracking-widget:focus-within {
            transform: translateY(-5px);
            box-shadow: 0 30px 60px -10px rgba(109, 45, 158, 0.4);
        }

        .tracking-input-wrapper {
            position: relative;
            flex-grow: 1;
            display: flex;
            align-items: center;
        }

        .tracking-input-wrapper i {
            position: absolute;
            left: 24px;
            color: var(--text-muted);
            font-size: 18px;
        }

        .tracking-input {
            background: transparent;
            border: none;
            color: var(--text-dark);
            padding: 20px 20px 20px 55px;
            width: 100%;
            outline: none;
            font-weight: 600;
            font-size: 15px;
            letter-spacing: 0.3px;
        }

        .tracking-input::placeholder {
            color: #94a3b8;
            font-weight: 500;
        }

        .tracking-btn {
            background: var(--atilson-purple);
            color: white;
            border: none;
            padding: 0 45px;
            border-radius: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 14px;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .tracking-btn:hover {
            background: var(--atilson-purple-dark);
            box-shadow: 0 8px 20px var(--atilson-purple-glow);
        }

        /* ========================================================= */
        /* BARRA E-SERVICES                                          */
        /* ========================================================= */
        .e-services-bar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-soft);
            box-shadow: var(--shadow-sm);
            position: relative;
            z-index: 10;
        }

        .service-tab {
            padding: 35px 20px;
            text-align: center;
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 800;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            transition: all 0.4s ease;
            border-right: 1px solid var(--border-soft);
            display: block;
            position: relative;
            overflow: hidden;
            background: #ffffff;
        }

        .service-tab::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            width: 100%; height: 3px;
            background: var(--atilson-purple);
            transform: translateY(3px);
            transition: transform 0.3s ease;
        }

        .service-tab:first-child { border-left: 1px solid var(--border-soft); }

        .service-tab:hover {
            color: var(--atilson-purple);
            background: var(--bg-soft);
        }
        .service-tab:hover::after {
            transform: translateY(0);
        }

        .service-tab i {
            display: block;
            font-size: 32px;
            margin-bottom: 14px;
            color: #94a3b8;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .service-tab:hover i {
            color: var(--atilson-purple);
            transform: translateY(-4px) scale(1.1);
        }

        /* ========================================================= */
        /* SECCIONES COMUNES                                         */
        /* ========================================================= */
        .section-padding { padding: 130px 0; }

        .section-header { text-align: center; margin-bottom: 80px; }

        .section-tag {
            color: var(--atilson-purple);
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            display: block;
            margin-bottom: 16px;
        }

        .section-title {
            font-size: 46px;
            font-weight: 900;
            letter-spacing: -1.5px;
            margin-bottom: 24px;
            color: var(--text-dark);
        }

        .section-subtitle {
            font-size: 17px;
            color: var(--text-muted);
            line-height: 1.8;
            max-width: 650px;
            margin: 0 auto;
        }

        /* ========================================================= */
        /* TARJETAS DE SERVICIOS                                     */
        /* ========================================================= */
        .service-card {
            background: #ffffff;
            border: 1px solid var(--border-soft);
            border-radius: 16px;
            padding: 55px 45px;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            height: 100%;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            z-index: 1;
        }

        .service-card::after {
            content: "";
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 4px;
            background: linear-gradient(90deg, var(--atilson-purple), var(--atilson-purple-light));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
            border-color: transparent;
        }
        
        .service-card:hover::after { transform: scaleX(1); }

        .service-icon {
            font-size: 46px;
            color: var(--atilson-purple);
            margin-bottom: 30px;
            display: inline-block;
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            background: var(--bg-soft);
            width: 80px;
            height: 80px;
            line-height: 80px;
            text-align: center;
            border-radius: 16px;
        }

        .service-card:hover .service-icon {
            transform: scale(1.1) translateY(-5px);
            background: var(--atilson-purple);
            color: white;
            box-shadow: 0 10px 20px var(--atilson-purple-glow);
        }

        .service-card h3 {
            font-size: 21px;
            font-weight: 800;
            margin-bottom: 16px;
            color: var(--text-dark);
            letter-spacing: -0.5px;
            transition: color 0.3s;
        }

        .service-card p {
            font-size: 15px;
            color: var(--text-muted);
            line-height: 1.7;
            margin: 0;
        }

        /* ========================================================= */
        /* MARKET & NEWS                                             */
        /* ========================================================= */
        .news-section {
            background-color: var(--bg-soft);
            border-top: 1px solid var(--border-soft);
            position: relative;
            overflow: hidden;
        }

        .news-slider-wrapper {
            position: relative;
            width: 100%;
            padding: 30px 0;
            overflow: hidden;
        }

        .news-slider-track {
            display: flex;
            gap: 30px;
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
            will-change: transform;
        }

        .slider-btn {
            position: absolute;
            top: 45%;
            transform: translateY(-50%);
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: #ffffff;
            border: 1px solid var(--border-soft);
            color: var(--atilson-purple);
            font-size: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: var(--shadow-md);
            z-index: 10;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .slider-btn:hover {
            background: var(--atilson-purple);
            color: #fff;
            transform: translateY(-50%) scale(1.1);
            box-shadow: 0 15px 30px var(--atilson-purple-glow);
            border-color: var(--atilson-purple);
        }

        .slider-btn-prev { left: 10px; }
        .slider-btn-next { right: 10px; }

        .news-card {
            min-width: 380px;
            max-width: 380px;
            flex: 0 0 auto;
            background: #ffffff;
            border: 1px solid var(--border-soft);
            border-radius: 16px;
            height: 100%;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .news-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
            border-color: transparent;
        }

        .img-wrapper {
            overflow: hidden;
            height: 220px;
            background-color: var(--border-soft);
            position: relative;
        }
        
        .img-wrapper::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; width: 100%; height: 60%;
            background: linear-gradient(to top, rgba(15,23,42,0.6), transparent);
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .news-card:hover .img-wrapper::after {
            opacity: 1;
        }

        .news-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
        }

        .news-card:hover .news-img {
            transform: scale(1.08);
        }

        .news-content {
            padding: 35px 30px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            background: #fff;
        }

        .news-date {
            font-size: 11px;
            color: var(--atilson-purple);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
        }

        .news-date i { margin-right: 6px; font-size: 13px; }

        .news-title {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 16px;
            line-height: 1.4;
            color: var(--text-dark);
            letter-spacing: -0.3px;
        }

        .news-desc {
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 25px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .news-link {
            margin-top: auto;
            font-size: 12px;
            font-weight: 800;
            color: var(--atilson-purple);
            text-decoration: none;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            transition: all 0.3s;
            letter-spacing: 1px;
        }

        .news-link i {
            margin-left: 8px;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .news-link:hover { color: var(--atilson-purple-dark); }
        .news-link:hover i { transform: translateX(6px); }

        /* ========================================================= */
        /* RED GLOBAL (FONDO EN MOVIMIENTO)                          */
        /* ========================================================= */
        .global-section {
            padding: 140px 0;
            background-color: var(--bg-deep);
            position: relative;
            color: white;
            overflow: hidden;
        }

        /* MAPA CON ANIMACIÓN DE PANEO INFINITO - Mantenido intacto */
        .map-container {
            width: 200%;
            height: 100%;
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/8/80/World_map_-_low_resolution.svg');
            background-size: contain;
            background-position: center;
            background-repeat: repeat-x;
            opacity: 0.05;
            filter: invert(1);
            position: absolute;
            top: 0;
            left: 0;
            z-index: 0;
            animation: panMap 60s linear infinite;
        }

        @@keyframes panMap {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .global-content {
            position: relative;
            z-index: 1;
        }

        .global-content .section-title {
            color: #ffffff;
            font-size: 52px;
        }
        
        .stat-box h4 {
            font-weight: 900; 
            font-size: 56px; 
            color: white;
            margin-bottom: 5px;
            letter-spacing: -2px;
        }

        /* ========================================================= */
        /* CONTACTO (FORMULARIO ALTO CONTRASTE)                      */
        /* ========================================================= */
        .contact-section {
            background-color: var(--bg-light);
            border-top: 1px solid var(--border-soft);
        }

        .contact-card {
            background: #ffffff;
            padding: 55px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-soft);
        }

        .contact-icon-box {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: var(--bg-soft);
            color: var(--atilson-purple);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            transition: all 0.3s;
            border: 1px solid var(--border-soft);
        }
        
        .contact-icon-box:hover {
            background: var(--atilson-purple);
            color: white;
            transform: scale(1.05);
            border-color: transparent;
        }

        .form-control-custom {
            background: var(--bg-input);
            border: 1px solid transparent;
            color: var(--text-dark);
            padding: 16px 20px;
            border-radius: 8px;
            font-weight: 500;
            font-size: 15px;
            transition: all 0.3s;
        }

        .form-control-custom:focus {
            border-color: var(--atilson-purple-light);
            box-shadow: 0 0 0 4px rgba(109, 45, 158, 0.1);
            background: #ffffff;
            outline: none;
        }

        .form-control-custom::placeholder { color: #94a3b8; }

        .btn-submit {
            background: var(--atilson-purple);
