<!-- SCRIPTS DE ANIMACIÓN Y MODAL -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Animaciones Reveal (Scroll)
            function reveal() {
                var reveals = document.querySelectorAll(".reveal");
                for (var i = 0; i < reveals.length; i++) {
                    var windowHeight = window.innerHeight;
                    var elementTop = reveals[i].getBoundingClientRect().top;
                    if (elementTop < windowHeight - 50) {
                        reveals[i].classList.add("active");
                    }
                }
            }
            window.addEventListener("scroll", reveal);
            reveal(); // Llamada inicial
        });

        // Simulación de búsqueda de Itinerarios (Sin mostrar precios de costos)
        function buscarItinerarios() {
            // En la vida real aquí haríamos un fetch() a la API de SeaRoutes/Vizion
            document.getElementById('resultadoItinerarios').style.display = 'block';
        }

        // Redirección al cotizador autocompletando la ruta
        function cotizarRuta(origen, destino) {
            let baseUrl = '/PortalCliente/SolicitarReserva';
            window.location.href = `${baseUrl}?origenQ=${encodeURIComponent(origen)}&destinoQ=${encodeURIComponent(destino)}`;
        }
    </script>
}