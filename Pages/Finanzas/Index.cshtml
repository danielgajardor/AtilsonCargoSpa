@page
@model AtilsonCargoSpa.Pages.Finanzas.IndexModel
@{
    ViewData["Title"] = "Main Board Financiero";
}

<style>
    /* VARIABLES CORPORATIVAS ATILSON */
    :root {
        --atilson-slate-900: #0f172a;
        --atilson-slate-500: #64748b;
        --atilson-bg-soft: #f8fafc;
        --atilson-border: #e2e8f0;
    }

    body {
        background-color: #f8fafc;
    }

    /* MENU DE NAVEGACIÓN PRINCIPAL UNIFICADO */
    .workspace-nav {
        display: flex;
        gap: 2px;
        background: #ffffff;
        padding: 6px;
        border-radius: 8px;
        border: 1px solid var(--atilson-border);
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }

    .ws-btn {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 10px 20px;
        border-radius: 6px;
        color: var(--atilson-slate-500);
        text-decoration: none;
        transition: all 0.2s;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .ws-btn:hover {
            background: var(--atilson-bg-soft);
            color: var(--atilson-slate-900);
        }

        .ws-btn.active {
            background: var(--atilson-slate-900);
            color: #ffffff;
            box-shadow: 0 2px 5px rgba(15, 23, 42, 0.15);
        }

    /* MOCKUP PARA LAS TARJETAS KPI VACÍAS */
    .kpi-mock {
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: 110px;
        justify-content: center;
    }

    .kpi-mock-title {
        height: 10px;
        width: 50%;
        background: #e2e8f0;
        border-radius: 4px;
    }

    .kpi-mock-value {
        height: 24px;
        width: 70%;
        background: #f1f5f9;
        border-radius: 6px;
    }

    /* MOCKUP PARA LA GRILLA VACÍA */
    .fin-table-wrapper {
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid var(--atilson-border);
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .table-main-grid {
        margin-bottom: 0;
        width: 100%;
        border-collapse: collapse;
    }

        .table-main-grid > thead > tr > th {
            font-size: 10px;
            text-transform: uppercase;
            color: var(--atilson-slate-500);
            font-weight: 700;
            background-color: #f1f5f9;
            border-bottom: 2px solid #cbd5e1;
            padding: 12px 20px;
            letter-spacing: 0.5px;
        }

    .mock-row {
        border-bottom: 1px solid var(--atilson-border);
        height: 50px;
    }

    .mock-cell {
        height: 14px;
        background: #f1f5f9;
        border-radius: 4px;
        margin-left: 20px;
        margin-right: 20px;
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- HEADER HOMOLOGADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-size: 24px; font-weight: 900; color: var(--atilson-slate-900); margin: 0; letter-spacing: -0.5px;">MAIN BOARD FINANCIERO</h1>
            <p class="text-muted small m-0 fw-medium mt-1">Centro de mando gerencial y analítica de rentabilidad.</p>
        </div>
    </div>

    <!-- MENÚ UNIFICADO (Main Board marcado como 'active') -->
    <div class="d-flex mb-4">
        <div class="workspace-nav">
            <a asp-page="/Finanzas/Index" class="ws-btn active"><i class="bi bi-grid-1x2-fill"></i> Main Board</a>
            <a asp-page="/Finanzas/ControlFinanciero" class="ws-btn"><i class="bi bi-sliders"></i> Control Financiero</a>
            <a asp-page="/Finanzas/OrdenesCompra" class="ws-btn"><i class="bi bi-receipt"></i> Órdenes de Compra</a>
            <a asp-page="/Finanzas/Facturacion" class="ws-btn"><i class="bi bi-file-earmark-spreadsheet-fill"></i> Facturación</a>
        </div>
    </div>

    <!-- SECCIÓN: TARJETAS KPI (BOCETO) -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="kpi-mock">
                <div class="kpi-mock-title"></div>
                <div class="kpi-mock-value"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-mock">
                <div class="kpi-mock-title"></div>
                <div class="kpi-mock-value"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-mock">
                <div class="kpi-mock-title"></div>
                <div class="kpi-mock-value"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-mock">
                <div class="kpi-mock-title"></div>
                <div class="kpi-mock-value"></div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN: GRILLA PRINCIPAL (BOCETO) -->
    <div class="fin-table-wrapper">
        <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center bg-white">
            <h6 class="m-0 fw-bold text-dark" style="font-size: 13px;">
                <i class="bi bi-bar-chart-line-fill me-2 text-primary"></i>(ESPACIO RESERVADO)
            </h6>
        </div>

        <div class="table-responsive">
            <table class="table-main-grid">
                <thead>
                    <tr>
                        <th style="width: 25%;" class="ps-4">Operación / Booking</th>
                        <th style="width: 25%;">Cliente</th>
                        <th style="width: 15%;" class="text-end">Ingresos</th>
                        <th style="width: 15%;" class="text-end">Egresos</th>
                        <th style="width: 20%;" class="text-end pe-4">Rentabilidad</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Filas fantasma para visualizar el volumen -->
                    <tr class="mock-row">
                        <td><div class="mock-cell w-50"></div></td>
                        <td><div class="mock-cell w-75"></div></td>
                        <td><div class="mock-cell w-50 ms-auto"></div></td>
                        <td><div class="mock-cell w-50 ms-auto"></div></td>
                        <td><div class="mock-cell w-50 ms-auto me-4"></div></td>
                    </tr>
                    <tr class="mock-row">
                        <td><div class="mock-cell w-50"></div></td>
                        <td><div class="mock-cell w-75"></div></td>
                        <td><div class="mock-cell w-50 ms-auto"></div></td>
                        <td><div class="mock-cell w-50 ms-auto"></div></td>
                        <td><div class="mock-cell w-50 ms-auto me-4"></div></td>
                    </tr>
                    <tr class="mock-row">
                        <td><div class="mock-cell w-50"></div></td>
                        <td><div class="mock-cell w-75"></div></td>
                        <td><div class="mock-cell w-50 ms-auto"></div></td>
                        <td><div class="mock-cell w-50 ms-auto"></div></td>
                        <td><div class="mock-cell w-50 ms-auto me-4"></div></td>
                    </tr>
                </tbody>
            </table>

            <!-- Mensaje de construcción -->
            <div class="px-4 py-4 bg-light text-center text-muted" style="font-size: 11px; font-style: italic;">
                Página en construcción. Los datos y funcionalidades se implementarán próximamente.
            </div>
        </div>
    </div>

</div>