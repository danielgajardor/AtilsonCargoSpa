@page
@model AtilsonCargoSpa.Pages.Finanzas.NotaCobroModel
@{
    ViewData["Title"] = $"Nota de Cobro {Model.NumeroNotaCobro}";
    Layout = null; // Quitamos el layout para que sea un PDF limpio
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                font-family: 'Arial', sans-serif;
                background-color: #e2e8f0;
                color: #000;
                font-size: 13px;
            }

            .hoja-carta {
                width: 21.59cm;
                min-height: 27.94cm;
                padding: 2cm;
                margin: 1cm auto;
                background: white;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }

            .text-atilson-blue {
                color: #1e3a8a;
            }

            .table-cobros th {
                background-color: #f8fafc;
                border-bottom: 2px solid #000;
                padding: 10px;
                font-size: 12px;
            }

            .table-cobros td {
                border-bottom: 1px solid #cbd5e1;
                padding: 10px;
            }

            .footer-legal {
                border: 1px solid #000;
                padding: 15px;
                font-size: 11px;
                margin-top: 30px;
            }

            @@media print {
                body {
                    background-color: white;
                    margin: 0;
                }

                .hoja-carta {
                    box-shadow: none;
                    margin: 0;
                    padding: 1cm;
                    width: 100%;
                    height: auto;
                }

                .no-print {
                    display: none !important;
                }
            }
    </style>
</head>
<body>
    <div class="text-center mt-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4">🖨️ Imprimir / Descargar PDF</button>
        <a href="/Finanzas/ControlFinanciero" class="btn btn-outline-secondary ms-2">Volver</a>
    </div>

    <div class="hoja-carta">
        <!-- CABECERA DE LA EMPRESA -->
        <div class="row border-bottom border-2 border-dark pb-3 mb-4">
            <div class="col-7">
                <h1 class="text-atilson-blue mb-0" style="font-weight: 900; font-size: 34px; letter-spacing: -1px;">ATILSON</h1>
                <p class="mb-0 fw-bold" style="font-size: 14px; letter-spacing: 1px;">SERVICIOS LOGISTICOS</p>
                <div class="mt-3" style="font-size: 11px; line-height: 1.4;">
                    <strong>Atilson CARGO SPA</strong><br />
                    Rut: 77.287.565-7<br />
                    Giro: Actividades de consultoría de gestión; otras actividades...<br />
                    Dirección: Prat 814, Oficina 503, Valparaíso
                </div>
            </div>
            <div class="col-5 text-end">
                <h2 class="fw-bold mb-1" style="font-size: 18px;">Nota de Cobro N° : @Model.NumeroNotaCobro</h2>
                <p class="mb-0"><strong>Fecha de Emisión :</strong> @DateTime.Now.ToString("dd MMMM yyyy").ToUpper()</p>
            </div>
        </div>

        <!-- DATOS DEL CLIENTE -->
        <div class="row mb-4" style="line-height: 1.6;">
            <div class="col-2 fw-bold">
                Señor(es)<br />Dirección<br />Ciudad
            </div>
            <div class="col-6">
                : @(Model.Operacion.IdClienteNavigation?.RazonSocial ?? "N/A")<br />
                : @(Model.Operacion.IdClienteNavigation?.Direccion ?? "N/A")<br />
                : VALPARAISO
            </div>
            <div class="col-1 fw-bold">
                Rut<br />Giro
            </div>
            <div class="col-3">
                : @(Model.Operacion.IdClienteNavigation?.Rut ?? "N/A")<br />
                : EXPORTADOR
            </div>
        </div>

        <!-- DATOS DEL BOOKING -->
        <div class="mb-4">
            <h5 class="fw-bold text-decoration-underline" style="font-size: 14px;">Costos asociados</h5>
            <div class="row" style="line-height: 1.6;">
                <div class="col-3 fw-bold">Naviera/ Nave<br />Reserva<br />Contenedor</div>
                <div class="col-9">
                    : @(Model.Operacion.IdNavieraNavigation?.NombreNaviera ?? "N/A") // @(Model.Operacion.Nave ?? "N/A")<br />
                    : @(Model.Operacion.NumeroBooking)<br />
                    : @(Model.Operacion.NumeroContenedor ?? "POR ASIGNAR") // @(Model.Operacion.NumeroSello ?? "")
                </div>
            </div>
        </div>

        <!-- TABLA DE COBROS -->
        <table class="table table-borderless table-cobros w-100 mb-5">
            <thead>
                <tr>
                    <th style="width: 55%;">Descripción del cobro</th>
                    <th class="text-center" style="width: 15%;">CANT</th>
                    <th class="text-end" style="width: 15%;">VALOR</th>
                    <th class="text-end" style="width: 15%;">VALOR TOTAL</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CobrosConsolidados)
                {
                    <tr>
                        <td><strong>@item.Concepto</strong></td>
                        <td class="text-center">1</td>
                        <td class="text-end">@Model.MonedaPrincipal @item.MontoNeto.ToString("N0")</td>
                        <td class="text-end">@Model.MonedaPrincipal @item.MontoNeto.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="border-top border-2 border-dark">
                    <td colspan="2"></td>
                    <td class="text-end fw-bold" style="font-size: 16px;">TOTAL</td>
                    <td class="text-end fw-bold" style="font-size: 16px;">@Model.MonedaPrincipal @Model.TotalCobro.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>

        <!-- PIE DE PÁGINA (LEGAL Y PAGOS) -->
        <div class="footer-legal">
            <strong>Remitir a: Atilson cargo Spa</strong><br />
            Rut: 77.287.565-7<br />
            Cuenta corriente en pesos.<br />
            Banco ITAU N° 221241901<br />
            Email: departamento.finanzas@atilson.com<br /><br />
            <strong>Importante:</strong> Estimado Cliente la nota de cobro no es un documento tributario, es solo un compendio de los gastos que ha incurrido la empresa emisora por su cuenta.
        </div>
    </div>
</body>
</html>