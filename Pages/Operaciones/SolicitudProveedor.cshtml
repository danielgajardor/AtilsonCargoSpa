@page
@model AtilsonCargoSpa.Pages.Operaciones.SolicitudProveedorModel
@{
    ViewData["Title"] = "Generador de Solicitudes";
    var op = Model.Operacion;
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root { --txt-main: #0f172a; --txt-muted: #64748b; --border-soft: #e2e8f0; --bg-soft: #f8fafc; }
    
    .email-card { background: #ffffff; border-radius: 8px; border: 1px solid var(--border-soft); overflow: hidden; margin-bottom: 24px; box-shadow: 0 4px 10px rgba(0,0,0,0.03); }
    .email-header-bar { background: var(--bg-soft); padding: 12px 20px; border-bottom: 1px solid var(--border-soft); display: flex; align-items: center; font-weight: 800; font-size: 11px; color: var(--txt-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .email-header-bar i { font-size: 14px; margin-right: 8px; }
    
    .email-row { display: flex; border-bottom: 1px solid var(--border-soft); padding: 10px 20px; align-items: center; }
    .email-label { font-size: 12px; font-weight: 700; color: var(--txt-muted); width: 70px; }
    .email-input { border: none; outline: none; width: 100%; font-size: 13px; color: var(--txt-main); font-weight: 600; background: transparent; font-family: 'Segoe UI', Arial, sans-serif; }
    .email-input:focus { border-bottom: 1px solid var(--atilson-dark); padding-bottom: 1px; margin-bottom: -2px; }
    
    .email-body-wrapper { padding: 20px; }
    
    /* MODIFICADO: Fuente de correo real y más altura */
    .email-textarea { width: 100%; border: none; outline: none; font-size: 13px; min-height: 400px; resize: vertical; color: #333; font-family: Arial, Helvetica, sans-serif; line-height: 1.5; }
    
    .email-actions { background: var(--bg-soft); padding: 15px 20px; border-top: 1px solid var(--border-soft); display: flex; gap: 10px; justify-content: flex-end; }
</style>

<div class="container-fluid py-4" style="max-width: 1200px;">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-size: 22px; font-weight: 800; color: var(--txt-main); margin: 0; letter-spacing: -0.5px;"><i class="bi bi-envelope-paper me-2" style="color: var(--atilson-dark);"></i> GENERADOR DE CORREOS</h1>
            <p class="text-muted small m-0 fw-medium">Op: @op.NumeroBooking | Formatos oficiales automatizados</p>
        </div>
        <a asp-page="./Index" class="btn btn-light border btn-sm px-4 py-2 fw-bold shadow-sm text-muted">VOLVER AL BOARD</a>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="email-card border-top border-4" style="border-top-color: #f59e0b;">
                <div class="email-header-bar" style="color: #d97706;"><i class="bi bi-truck"></i> Solicitud Transporte Terrestre</div>
                
                <div class="email-row">
                    <div class="email-label">Para:</div>
                    <input type="email" id="toTransporte" class="email-input" value="@Model.CorreoTransporte" placeholder="operaciones@transporte.cl" />
                </div>
                <div class="email-row">
                    <div class="email-label">Asunto:</div>
                    <input type="text" id="subTransporte" class="email-input" value="@Model.AsuntoTransporte" />
                </div>
                
                <div class="email-body-wrapper">
                    <textarea id="txtTransporte" class="email-textarea">@Model.TextoTransporte</textarea>
                </div>
                
                <div class="email-actions">
                    <button onclick="copiarTexto('txtTransporte', this)" class="btn btn-light border btn-sm fw-bold text-muted px-3"><i class="bi bi-copy"></i> Copiar Todo</button>
                    <button onclick="abrirCorreo('toTransporte', 'subTransporte', 'txtTransporte')" class="btn btn-dark btn-sm fw-bold px-4" style="background-color: var(--atilson-dark); border: none;"><i class="bi bi-send-fill me-2"></i> ABRIR EN OUTLOOK/GMAIL</button>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="email-card border-top border-4" style="border-top-color: #10b981;">
                <div class="email-header-bar" style="color: #059669;"><i class="bi bi-file-earmark-check"></i> Solicitud Trámite Aduanero</div>
                
                <div class="email-row">
                    <div class="email-label">Para:</div>
                    <input type="email" id="toAduana" class="email-input" value="@Model.CorreoAduana" placeholder="operaciones@agencia-aduana.cl" />
                </div>
                <div class="email-row">
                    <div class="email-label">Asunto:</div>
                    <input type="text" id="subAduana" class="email-input" value="@Model.AsuntoAduana" />
                </div>
                
                <div class="email-body-wrapper">
                     <textarea id="txtDocumental" class="email-textarea">@Model.TextoDoc</textarea>
                </div>

                <div class="email-actions">
                    <button onclick="copiarTexto('txtDocumental', this)" class="btn btn-light border btn-sm fw-bold text-muted px-3"><i class="bi bi-copy"></i> Copiar Todo</button>
                    <button onclick="abrirCorreo('toAduana', 'subAduana', 'txtDocumental')" class="btn btn-dark btn-sm fw-bold px-4" style="background-color: var(--atilson-dark); border: none;"><i class="bi bi-send-fill me-2"></i> ABRIR EN OUTLOOK/GMAIL</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copiarTexto(idTextarea, btn) {
        var copyText = document.getElementById(idTextarea);
        copyText.select();
        copyText.setSelectionRange(0, 99999); 
        navigator.clipboard.writeText(copyText.value);
        
        var originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2-all"></i> ¡Copiado!';
        btn.classList.replace('btn-light', 'btn-success');
        btn.classList.replace('text-muted', 'text-white');
        
        setTimeout(() => { 
            btn.innerHTML = originalText; 
            btn.classList.replace('btn-success', 'btn-light');
            btn.classList.replace('text-white', 'text-muted');
        }, 2000);
    }

    function abrirCorreo(idTo, idSub, idBody) {
        var to = document.getElementById(idTo).value;
        var subject = document.getElementById(idSub).value;
        var body = document.getElementById(idBody).value;
        
        var mailtoLink = "mailto:" + to + "?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
        window.location.href = mailtoLink;
    }
</script>