<button type="submit" id="realSubmitBtn" form="frmOperacion" style="display: none;"></button>

@section Scripts {
    
    @if (TempData["ErrorBooking"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: '¡Operación Denegada!',
                    text: '@TempData["ErrorBooking"]',
                    icon: 'error',
                    confirmButtonColor: 'var(--atilson-dark)',
                    confirmButtonText: 'Entendido'
                });
            });
        </script>
    }

    <script>
        function calcularDif(inicioStr, finStr) {
            if(!inicioStr || !finStr) return { text: "0h 0m", hours: 0, isExtra: false };
            let d1 = new Date(inicioStr); let d2 = new Date(finStr);
            let diffMs = d2 - d1;
            if(diffMs < 0) return { text: "Error de fechas", hours: 0, isExtra: false };
            let diffMins = Math.floor(diffMs / 60000);
            let h = Math.floor(diffMins / 60); let m = diffMins % 60;
            return { text: `${h}h ${m}m`, hours: h + (m/60), isExtra: h >= 2 }; 
        }

        document.addEventListener("DOMContentLoaded", function () {
            
            // --- MOTOR DEL WIZARD ---
            const ddlServicio = document.getElementById('ddlServicio');
            const tabs = document.querySelectorAll('.nav-link');
            const panes = document.querySelectorAll('.tab-pane');
            const btnPrev = document.getElementById('btnPrev');
            const btnNext = document.getElementById('btnNext');
            const btnResumen = document.getElementById('btnResumen');
            
            let activeTabs = []; 
            let currentIndex = 0;

            function updateWizardNav() {
                tabs.forEach(t => t.classList.remove('active'));
                panes.forEach(p => p.classList.remove('active'));

                if (activeTabs.length > 0) {
                    const currentTabId = activeTabs[currentIndex];
                    const currentTab = document.getElementById(currentTabId);
                    const currentPaneId = currentTab.getAttribute('data-target');
                    const currentPane = document.getElementById(currentPaneId);

                    currentTab.classList.add('active');
                    currentPane.classList.add('active');
                }

                btnPrev.style.visibility = currentIndex > 0 ? 'visible' : 'hidden';
                
                if (currentIndex === activeTabs.length - 1) {
                    btnNext.style.display = 'none';
                    btnResumen.style.display = 'inline-flex';
                } else {
                    btnNext.style.display = 'inline-flex';
                    btnResumen.style.display = 'none';
                }
            }

            function actualizarModulos() {
                if (!ddlServicio) return;
                
                const valTexto = ddlServicio.options[ddlServicio.selectedIndex]?.text.toUpperCase() || '';
                const valNum = ddlServicio.value;

                const liTer = document.getElementById('nav-item-terrestre');
                const liMar = document.getElementById('nav-item-maritimo');
                const liDoc = document.getElementById('nav-item-documental');

                activeTabs = ['tab-general']; 
                
                if (!valNum) {
                    liTer.style.display = 'none';
                    liMar.style.display = 'none';
                    liDoc.style.display = 'none';
                } else {
                    let esMaritimo = valTexto.includes('MARÍTIMO') || valTexto.includes('INTEGRAL') || valTexto.includes('MAR.');
                    let esTerrestre = valTexto.includes('TERRESTRE') || valTexto.includes('INTEGRAL') || valTexto.includes('TERR.');
                    let esDocumental = valTexto.includes('DOC') || valTexto.includes('INTEGRAL');

                    liTer.style.display = esTerrestre ? 'block' : 'none';
                    liMar.style.display = esMaritimo ? 'block' : 'none';
                    liDoc.style.display = esDocumental ? 'block' : 'none';

                    // Respetando el orden de Edit
                    if (esMaritimo) activeTabs.push('tab-maritimo');
                    if (esTerrestre) activeTabs.push('tab-terrestre');
                    if (esDocumental) activeTabs.push('tab-documental');

                    const astMaritimo = document.querySelector('.req-maritimo-asterisk');
                    document.querySelectorAll('.req-naviera, .req-carga').forEach(el => {
                        if(esMaritimo) { 
                            el.classList.add('req-activa'); 
                            if(astMaritimo) astMaritimo.style.display = 'inline';
                        } 
                        else { 
                            el.classList.remove('req-activa'); 
                            if(astMaritimo) astMaritimo.style.display = 'none';
                        }
                    });
                }
                
                activeTabs.push('tab-incidencias');
                if(currentIndex >= activeTabs.length) currentIndex = activeTabs.length - 1;
                
                updateWizardNav();
            }

            if (ddlServicio) {
                ddlServicio.addEventListener('change', actualizarModulos);
                actualizarModulos();
            }

            btnNext.addEventListener('click', () => {
                if (currentIndex < activeTabs.length - 1) {
                    currentIndex++;
                    updateWizardNav();
                }
            });

            btnPrev.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                    updateWizardNav();
                }
            });

            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    const id = this.id;
                    const index = activeTabs.indexOf(id);
                    if (index !== -1) {
                        currentIndex = index;
                        updateWizardNav();
                    }
                });
            });

            // --- AUTOCOMPLETADO DE TERMINALES SEGÚN POL ---
            const inpPol = document.getElementById('inpPol');
            const inpTerminal = document.getElementById('inpTerminal');
            const selTerminal = document.getElementById('selTerminal');

            if (inpPol && inpTerminal && selTerminal) {
                inpPol.addEventListener('change', function() {
                    const polText = this.options[this.selectedIndex]?.text.toUpperCase() || '';
                    
                    if (polText.includes('SAN ANTONIO')) {
                        inpTerminal.style.display = 'none';
                        selTerminal.style.display = 'block';
                        selTerminal.innerHTML = '<option value="">-- Seleccionar Terminal --</option><option value="STI">STI</option><option value="DP WORLD">DP WORLD</option><option value="PUERTO CENTRAL">PUERTO CENTRAL</option><option value="OTRO">OTRO...</option>';
                        inpTerminal.value = ''; 
                    } else if (polText.includes('VALPARAISO') || polText.includes('VALPARAÍSO')) {
                        selTerminal.style.display = 'none';
                        inpTerminal.style.display = 'block';
                        inpTerminal.value = 'TPS';
                    } else if (polText.includes('SAN VICENTE')) {
                        selTerminal.style.display = 'none';
                        inpTerminal.style.display = 'block';
                        inpTerminal.value = 'SVTI';
                    } else {
                        selTerminal.style.display = 'none';
                        inpTerminal.style.display = 'block';
                        inpTerminal.value = '';
                    }
                });

                selTerminal.addEventListener('change', function() {
                    if (this.value === 'OTRO') {
                        selTerminal.style.display = 'none';
                        inpTerminal.style.display = 'block';
                        inpTerminal.value = '';
                        inpTerminal.focus();
                    } else {
                        inpTerminal.value = this.value;
                    }
                });
            }

            // --- LÓGICA DE TRANSBORDO ---
            const selectTransbordo = document.getElementById('selectTransbordo');
            if (selectTransbordo) {
                selectTransbordo.addEventListener('change', function() {
                    const divPuertoTransbordo = document.getElementById('divPuertoTransbordo');
                    const inputTransbordo = document.getElementById('Operacione_Transbordo');
                    if (this.value === 'TRANSBORDO') {
                        if(divPuertoTransbordo) divPuertoTransbordo.style.display = 'block';
                    } else {
                        if(divPuertoTransbordo) divPuertoTransbordo.style.display = 'none';
                        if(inputTransbordo) inputTransbordo.value = '';
                    }
                });
            }

            // --- LÓGICA CARGA Y REEFER ---
            function actualizarCarga(container) {
                if (!container) return;
                const ddlTipoCarga = container.querySelector('.select-tipo-carga');
                const ddlCondicionReefer = container.querySelector('.select-condicion-reefer');
                const divCondicionReefer = container.querySelector('.div-condicion-reefer');
                const ddlUnidad = container.querySelector('.select-unidad');
                const panelReefer = container.querySelector('.panel-reefer');
                const divOpcionesFresh = container.querySelector('.div-opciones-fresh');
                const selectAtmosfera = container.querySelector('.select-atmosfera');
                const divConvencional = container.querySelector('.div-convencional');
                const divAC = container.querySelector('.div-ac');

                const val = ddlTipoCarga?.options[ddlTipoCarga.selectedIndex]?.text.toUpperCase() || '';
                const pre = ddlUnidad?.getAttribute('data-val-pre') || '';
                
                if (val.includes('DRY')) {
                    if (divCondicionReefer) divCondicionReefer.style.display = 'none';
                    if (panelReefer) panelReefer.style.display = 'none';
                    if (ddlUnidad) ddlUnidad.innerHTML = `
                        <option value="20' DRY STD" ${pre==="20' DRY STD"?"selected":""}>20' DRY STD</option>
                        <option value="40' DRY STD" ${pre==="40' DRY STD"?"selected":""}>40' DRY STD</option>
                        <option value="40' DRY HC" ${pre==="40' DRY HC"?"selected":""}>40' DRY HC</option>
                        <option value="PALLETS" ${pre==="PALLETS"?"selected":""}>Carga Suelta / Pallets</option>
                    `;
                } 
                else if (val.includes('REEFER')) {
                    if (divCondicionReefer) divCondicionReefer.style.display = 'block';
                    if (panelReefer) panelReefer.style.display = 'block';
                    
                    if (ddlCondicionReefer && ddlCondicionReefer.value === 'FROZEN') {
                        if(ddlUnidad) ddlUnidad.innerHTML = '<option value="40\' REEFER" selected>40\' REEFER</option>';
                        if(divOpcionesFresh) divOpcionesFresh.style.display = 'none'; 
                    } else {
                        if(ddlUnidad) ddlUnidad.innerHTML = `<option value="20' REEFER" ${pre==="20' REEFER"?"selected":""}>20' REEFER</option><option value="40' REEFER" ${pre==="40' REEFER"?"selected":""}>40' REEFER</option>`;
                        if(divOpcionesFresh) divOpcionesFresh.style.display = 'flex';
                        
                        if (selectAtmosfera && selectAtmosfera.value === 'AC') {
                            if(divConvencional) divConvencional.style.display = 'none'; 
                            if(divAC) divAC.style.display = 'flex';
                        } else {
                            if(divConvencional) divConvencional.style.display = 'flex'; 
                            if(divAC) divAC.style.display = 'none';
                        }
                    }
                } else {
                    if(divCondicionReefer) divCondicionReefer.style.display = 'none'; 
                    if(panelReefer) panelReefer.style.display = 'none';
                    if(ddlUnidad) ddlUnidad.innerHTML = '<option value="">Seleccione Carga Primero</option>';
                }
            }

            const contenedorContainer = document.getElementById('contenedores-container');
            if (contenedorContainer) {
                contenedorContainer.addEventListener('change', function(e) {
                    if (e.target.classList.contains('select-tipo-carga') || e.target.classList.contains('select-condicion-reefer') || e.target.classList.contains('select-atmosfera')) {
                        actualizarCarga(e.target.closest('.contenedor-item'));
                    }
                });
            }

            // --- AÑADIR CONTENEDORES EXTRA ---
            let contadorContenedores = document.querySelectorAll('.contenedor-item').length;
            const btnAgregar = document.getElementById('btnAgregarContenedor');
            if (btnAgregar) {
                btnAgregar.addEventListener('click', function() {
                    contadorContenedores++;
                    const container = document.getElementById('contenedores-container');
                    const html = `
                    <div class="contenedor-item position-relative">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3 btn-eliminar-contenedor" title="Eliminar"></button>
                        <h6 class="erp-label mb-3" style="color: var(--atilson-dark); font-size: 11px;">UNIDAD ${contadorContenedores} (Adicional)</h6>
                        <div class="row g-3">
                            <div class="col-md-2">
                                <label class="erp-label">Tipo Carga <span class="text-danger req-maritimo-asterisk" style="display:none;">*</span></label>
                                <select name="ContenedoresExtra[${contadorContenedores}].IdTipoCarga" class="form-select erp-input fw-bold req-carga select-tipo-carga">
                                    <option value="">-- Seleccionar --</option>
                                    <option value="1">DRY</option>
                                    <option value="2">REEFER</option>
                                </select>
                            </div>
                            <div class="col-md-2 div-condicion-reefer" style="display: none;">
                                <label class="erp-label">Condición Reefer</label>
                                <select name="ContenedoresExtra[${contadorContenedores}].CondicionReefer" class="form-select erp-input select-condicion-reefer">
                                    <option value="FRESH">Fresh</option>
                                    <option value="FROZEN">Frozen</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="erp-label">Tipo Unidad <span class="text-danger">*</span></label>
                                <select name="ContenedoresExtra[${contadorContenedores}].TipoContenedor" class="form-select erp-input select-unidad req-general">
                                    <option value="">Carga Primero</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="erp-label">N° Contenedor</label>
                                <input name="ContenedoresExtra[${contadorContenedores}].NumeroContenedor" class="form-control erp-input text-uppercase input-contenedor" placeholder="S/N..." />
                            </div>
                            <div class="col-md-3">
                                <label class="erp-label">Commodity <span class="text-danger">*</span></label>
                                <input name="ContenedoresExtra[${contadorContenedores}].Commodity" class="form-control erp-input text-uppercase req-general" placeholder="Ej: Vino..." />
                            </div>
                            
                            <div class="col-md-12 mt-3 div-evidencia" style="display: none;">
                                <label class="erp-label text-danger fw-bold"><i class="bi bi-paperclip"></i> Respaldo Físico (EIR o Foto)</label>
                                <input type="file" name="EvidenciaExtra_${contadorContenedores}" class="form-control erp-input input-evidencia" accept=".pdf, .jpg, .jpeg, .png" style="background-color: #fff;" />
                            </div>
                        </div>
                        <div class="panel-reefer" style="display: none;">
                            <h6 class="erp-label mb-3" style="color: var(--atilson-dark);"><i class="bi bi-snow"></i> Parámetros Reefer</h6>
                            <div class="row g-3">
                                <div class="col-md-2"><label class="erp-label">Temp (°C)</label><input type="number" step="0.1" class="form-control erp-input" name="ContenedoresExtra[${contadorContenedores}].TempSeteada" placeholder="0.0" /></div>
                                <div class="col-md-10 row g-3 m-0 div-opciones-fresh">
                                    <div class="col-md-3"><label class="erp-label">Atmósfera</label><select class="form-select erp-input select-atmosfera" name="ContenedoresExtra[${contadorContenedores}].TipoAtmosfera"><option value="CONV">Sin atmósfera</option><option value="AC">Controlada</option></select></div>
                                    <div class="col-md-9 row g-3 m-0 div-convencional"><div class="col-md-4"><label class="erp-label">Ventilación</label><input type="text" class="form-control erp-input" name="ContenedoresExtra[${contadorContenedores}].Ventilacion" placeholder="15" /></div><div class="col-md-4"><label class="erp-label">Humedad (%)</label><input type="number" class="form-control erp-input" name="ContenedoresExtra[${contadorContenedores}].Humedad" placeholder="80" /></div></div>
                                    <div class="col-md-9 row g-3 m-0 div-ac" style="display: none;"><div class="col-md-4"><label class="erp-label">Marca AC</label><select class="form-select erp-input" name="ContenedoresExtra[${contadorContenedores}].MarcaAc"><option value="Extrafresh">Extrafresh</option><option value="Liventus">Liventus</option><option value="Starcool">Starcool</option></select></div><div class="col-md-4"><label class="erp-label text-danger">O2 (%)</label><input type="text" class="form-control erp-input" name="ContenedoresExtra[${contadorContenedores}].NivelO2" placeholder="5" /></div><div class="col-md-4"><label class="erp-label text-danger">CO2 (%)</label><input type="text" class="form-control erp-input" name="ContenedoresExtra[${contadorContenedores}].NivelCO2" placeholder="10" /></div></div>
                                </div>
                            </div>
                        </div>
                    </div>`;
                    container.insertAdjacentHTML('beforeend', html);
                    const newCont = container.lastElementChild;
                    
                    // Aseguramos que la regla de asteriscos (naviera requerida) aplique al nuevo si es que estamos en modo marítimo
                    const isMar = document.getElementById('tab-maritimo').classList.contains('active') || document.getElementById('nav-item-maritimo').style.display === 'block';
                    if (isMar) {
                        newCont.querySelectorAll('.req-carga').forEach(el => el.classList.add('req-activa'));
                        const ast = newCont.querySelector('.req-maritimo-asterisk');
                        if (ast) ast.style.display = 'inline';
                    }

                    newCont.querySelectorAll('.input-contenedor').forEach(i => i.addEventListener('input', function() { validarEvidencia(this); }));
                });
            }

            if (contenedorContainer) {
                contenedorContainer.addEventListener('click', function(e) {
                    if(e.target.classList.contains('btn-eliminar-contenedor')) { 
                        e.target.closest('.contenedor-item').remove(); 
                    }
                });
            }

            // Disparar lógica de carga inicial para los contenedores que ya vienen de la BD
            document.querySelectorAll('.contenedor-item').forEach(item => actualizarCarga(item));

            // LÓGICA EVIDENCIA CONTENEDOR (EIR)
            function validarEvidencia(inp) {
                const b = inp.closest('.contenedor-item');
                const c = b.querySelector('.input-contenedor'); 
                const d = b.querySelector('.div-evidencia'); 
                const f = b.querySelector('.input-evidencia');
                const h = b.querySelector('.has-evidence-flag')?.value === 'true';

                if (c && c.value.trim() !== '') {
                    if(d) d.style.display = 'block';
                    if (!h && f) f.setAttribute('required', 'required'); 
                } else {
                    if(d) d.style.display = 'none'; 
                    if(f) f.removeAttribute('required');
                }
            }
            document.querySelectorAll('.input-contenedor').forEach(i => { i.addEventListener('input', function() { validarEvidencia(this); }); });
            document.querySelectorAll('.input-contenedor').forEach(i => { validarEvidencia(i); }); // Disparo inicial


            // --- LÓGICA DE TIEMPOS ---
            function actualizarTiempos() {
                let inPlanta = document.getElementById('inpLlegadaPlanta')?.value;
                let outPlanta = document.getElementById('inpSalidaPlanta')?.value;
                if(inPlanta && outPlanta) {
                    let pData = calcularDif(inPlanta, outPlanta);
                    let txtPlanta = document.getElementById('txtTiempoPlanta');
                    let bPlanta = document.getElementById('badgePlanta');
                    if (txtPlanta) txtPlanta.innerText = pData.text;
                    if (bPlanta) bPlanta.style.backgroundColor = pData.isExtra ? '#fee2e2' : 'var(--bg-soft)';
                    if (txtPlanta) txtPlanta.style.color = pData.isExtra ? '#dc2626' : 'var(--txt-main)';
                }

                let inPuerto = document.getElementById('inpLlegadaPuerto')?.value;
                let outPuerto = document.getElementById('inpSalidaPuerto')?.value;
                if(inPuerto && outPuerto) {
                    let puData = calcularDif(inPuerto, outPuerto);
                    let txtPuerto = document.getElementById('txtTiempoPuerto');
                    let bPuerto = document.getElementById('badgePuerto');
                    if (txtPuerto) txtPuerto.innerText = puData.text;
                    if (bPuerto) bPuerto.style.backgroundColor = puData.isExtra ? '#fee2e2' : 'var(--bg-soft)';
                    if (txtPuerto) txtPuerto.style.color = puData.isExtra ? '#dc2626' : 'var(--txt-main)';
                }
            }
            document.querySelectorAll('.calc-tiempo').forEach(i => i.addEventListener('input', actualizarTiempos));
            actualizarTiempos();

            // --- LÓGICA MATRIZ Y PREPAID/COLLECT ---
            const inpPago = document.getElementById('inpPago');
            function evaluarCondicionPago() {
                if(!inpPago) return;
                const p = inpPago.value;
                const aPrepaid = document.getElementById('alertaPrepaid');
                const aCollect = document.getElementById('alertaCollect');
                if (p === "1" || p === "2") { 
                    if(aPrepaid) aPrepaid.classList.remove('d-none'); if(aCollect) aCollect.classList.add('d-none');
                } else if (p === "3" || p === "4" || p === "5") { 
                    if(aCollect) aCollect.classList.remove('d-none'); if(aPrepaid) aPrepaid.classList.add('d-none');
                } else {
                    if(aPrepaid) aPrepaid.classList.add('d-none'); if(aCollect) aCollect.classList.add('d-none');
                }
            }
            if(inpPago) { inpPago.addEventListener('change', evaluarCondicionPago); evaluarCondicionPago(); }

            const chkMatriz = document.getElementById('chkMatriz');
            if(chkMatriz) {
                chkMatriz.addEventListener('change', function() {
                    const div = document.getElementById('divEvidenciaMatriz'); 
                    const file = document.getElementById('fileMatriz');
                    if (this.checked) {
                        if(div) div.style.display = 'block';
                        if (file && !document.querySelector('a[href^="/uploads/evidencias"][href*="Matriz"]')) { file.setAttribute('required', 'required'); }
                    } else {
                        if(div) div.style.display = 'none'; if(file) file.removeAttribute('required');
                    }
                });
            }

            // --- LÓGICA LAR ---
            const inpEstadoLar = document.getElementById('inpEstadoLar');
            function toggleLar() {
                const divFechaLar = document.querySelector('.div-fecha-lar');
                const divEvidenciaLar = document.querySelector('.div-evidencia-lar');
                const fileLar = document.getElementById('fileLar');
                if (inpEstadoLar && (inpEstadoLar.value.includes("AUTORIZADO") || inpEstadoLar.value.includes("INGRESADO"))) {
                    if(divFechaLar) divFechaLar.style.display = 'block'; 
                    if(divEvidenciaLar) divEvidenciaLar.style.display = 'block';
                    if (fileLar && !document.querySelector('a[href^="/uploads/evidencias"][href*="LAR"]')) { fileLar.setAttribute('required', 'required'); }
                } else {
                    if(divFechaLar) divFechaLar.style.display = 'none'; 
                    if(divEvidenciaLar) divEvidenciaLar.style.display = 'none';
                    if(fileLar) fileLar.removeAttribute('required');
                }
            }
            if (inpEstadoLar) { inpEstadoLar.addEventListener('change', toggleLar); toggleLar(); }


            // --- VALIDACIONES, SWEETALERT Y RESUMEN FINAL ---
            btnResumen.addEventListener('click', function() {
                let errores = [];
                document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

                // Campos estáticos requeridos
                const reqGen = document.querySelectorAll('.req-general');
                reqGen.forEach(el => {
                    if(!el.value) { el.classList.add('is-invalid'); errores.push(el.previousElementSibling.innerText.replace('*','').trim()); }
                });

                // Campos dinámicos requeridos (Solo si aplica)
                const reqDyn = document.querySelectorAll('.req-activa');
                reqDyn.forEach(el => {
                    if(!el.value) { el.classList.add('is-invalid'); errores.push(el.previousElementSibling.innerText.replace('*','').trim()); }
                });

                if (errores.length > 0) {
                    Swal.fire({
                        title: 'Faltan Datos Obligatorios',
                        html: '<p class="text-muted small">Por favor complete los siguientes campos (marcados en rojo):</p><ul class="text-start mb-0" style="font-size:13px; font-weight:600; color:#ef4444;"><li>' + errores.join('</li><li>') + '</li></ul>',
                        icon: 'warning',
                        confirmButtonColor: 'var(--atilson-dark)',
                        confirmButtonText: 'Revisar Formulario'
                    });
                } else {
                    // Si todo está OK, llenamos el modal de resumen
                    document.getElementById('resBooking').innerText = document.getElementById('inpBooking').value.toUpperCase();
                    
                    const cbCli = document.getElementById('inpCliente');
                    document.getElementById('resCliente').innerText = cbCli.options[cbCli.selectedIndex]?.text || "S/N";
                    
                    const cbServ = document.getElementById('ddlServicio');
                    document.getElementById('resServicio').innerText = cbServ.options[cbServ.selectedIndex]?.text || "S/N";
                    
                    const cbMov = document.getElementById('inpMovimiento');
                    document.getElementById('resMov').innerText = cbMov.value ? cbMov.options[cbMov.selectedIndex].text : "N/A";
                    
                    const cbPago = document.getElementById('inpPago');
                    document.getElementById('resPago').innerText = cbPago.options[cbPago.selectedIndex]?.text || "S/N";

                    // Resumen Contenedores
                    let unidadesHTML = "";
                    document.querySelectorAll('.contenedor-item').forEach((item, index) => {
                        const tCarga = item.querySelector('.select-tipo-carga');
                        const tUni = item.querySelector('.select-unidad');
                        const comm = item.querySelector('#inpCommodity') || item.querySelector('input[name*="Commodity"]');
                        
                        let tipoTxt = tCarga.value ? tCarga.options[tCarga.selectedIndex].text : "-";
                        let uniTxt = tUni.value || "-";
                        let commTxt = comm.value.toUpperCase() || "GENERAL";
                        
                        unidadesHTML += `> UNIDAD ${index+1}: [${tipoTxt}] ${uniTxt} | ${commTxt}<br/>`;
                    });
                    document.getElementById('resUnidades').innerHTML = unidadesHTML;

                    // Mostramos Modal de Resumen
                    var modalConfirmacion = new bootstrap.Modal(document.getElementById('modalConfirmacion'));
                    modalConfirmacion.show();
                }
            });

            // Enviar formulario al confirmar en el modal
            document.getElementById('btnConfirmarSubmit').addEventListener('click', function() {
                // Deshabilitar botón para evitar doble envío
                this.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> PROCESANDO...';
                this.style.pointerEvents = 'none';
                document.getElementById('realSubmitBtn').click();
            });

        });

        // --- SISTEMA DE LOGS DE ETA / ETD (HISTORIAL) ---
        let updatesCountEta = @(Model.Operacione.EtaPod.HasValue ? 1 : 0);
        let updatesCountEtd = @(Model.Operacione.EtdPol.HasValue ? 1 : 0);
        
        window.registrarCambioEta = function() {
            if(updatesCountEta >= 3) {
                Swal.fire('Límite Alcanzado', 'Solo se permiten 3 actualizaciones de ETA en el historial.', 'warning');
                return;
            }
            const nuevaFecha = document.getElementById('currentEta').value;
            if(!nuevaFecha) {
                Swal.fire('Atención', 'Seleccione una nueva fecha de ETA primero.', 'info');
                return;
            }

            Swal.fire({
                title: 'Motivo del Cambio de ETA',
                input: 'text',
                inputPlaceholder: 'Ej: Roleo de carga, congestión en puerto...',
                showCancelButton: true,
                confirmButtonText: 'Registrar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    updatesCountEta++;
                    const container = document.getElementById('etaHistoryContainer');
                    if(updatesCountEta === 1 || container.innerText.includes('Sin cambios')) {
                        container.innerHTML = '<span class="fw-bold d-block mb-1 text-muted" style="font-size: 10px; text-transform: uppercase;">Historial de Cambios (Máx 3):</span>';
                    }
                    
                    const f = new Date();
                    const hoy = f.toLocaleDateString() + ' ' + f.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    
                    const htmlLog = `<div class="text-danger fw-bold border-bottom border-warning pb-1 mb-1 mt-1" style="font-size:10px;">
                        <i class="bi bi-arrow-right-short"></i> Nuevo ETA: ${nuevaFecha} | Motivo: ${result.value} <br><span class="text-muted fw-normal">Registrado el: ${hoy}</span>
                    </div>`;
                    
                    container.insertAdjacentHTML('beforeend', htmlLog);
                    
                    // Guarda el HTML generado en el input oculto para enviarlo al backend
                    const hiddenInput = document.getElementById('hiddenEtaHistory');
                    if(hiddenInput) hiddenInput.value += htmlLog;
                    
                    Swal.fire('Registrado', 'El cambio de ETA se guardará al confirmar la edición de la operación.', 'success');
                }
            });
        }

        window.registrarCambioEtd = function() {
            if(updatesCountEtd >= 3) {
                Swal.fire('Límite Alcanzado', 'Solo se permiten 3 actualizaciones de ETD en el historial.', 'warning');
                return;
            }
            const nuevaFecha = document.getElementById('currentEtd').value;
            if(!nuevaFecha) {
                Swal.fire('Atención', 'Seleccione una nueva fecha de ETD primero.', 'info');
                return;
            }

            Swal.fire({
                title: 'Motivo del Cambio de ETD',
                input: 'text',
                inputPlaceholder: 'Ej: Retraso en zarpe, clima, rolleo...',
                showCancelButton: true,
                confirmButtonText: 'Registrar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    updatesCountEtd++;
                    const container = document.getElementById('etdHistoryContainer');
                    if(updatesCountEtd === 1 || container.innerText.includes('Sin cambios')) {
                        container.innerHTML = '<span class="fw-bold d-block mb-1 text-muted" style="font-size: 10px; text-transform: uppercase;">Historial de Cambios (Máx 3):</span>';
                    }
                    
                    const f = new Date();
                    const hoy = f.toLocaleDateString() + ' ' + f.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    
                    const htmlLog = `<div class="etd-history-item fw-bold border-bottom border-success pb-1 mb-1 mt-1" style="font-size:10px;">
                        <i class="bi bi-arrow-right-short"></i> Nuevo ETD: ${nuevaFecha} | Motivo: ${result.value} <br><span class="text-muted fw-normal">Registrado el: ${hoy}</span>
                    </div>`;
                    
                    container.insertAdjacentHTML('beforeend', htmlLog);
                    
                    const hiddenInput = document.getElementById('hiddenEtdHistory');
                    if(hiddenInput) hiddenInput.value += htmlLog;
                    
                    Swal.fire('Registrado', 'El cambio de ETD se guardará al confirmar la edición de la operación.', 'success');
                }
            });
        }
    </script>
}