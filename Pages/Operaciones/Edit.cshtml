                          <option value="Uso Días Detention">Uso Días Detention</option>
                          <option value="Días de Plug (Reefer)">Días de Plug (Reefer)</option>
                          <option value="Gate Out / Gate In">Gate Out / Gate In</option>
                          <option value="Cancelación / Roleo Reserva">Cancelación / Roleo Reserva</option>
                      </optgroup>
                      <optgroup label="Documental y Aduana">
                          <option value="Escáner de Aduana">Escáner de Aduana</option>
                          <option value="Corrección de BL">Corrección de BL</option>
