@page "{id:int}"
@model AtilsonCargoSpa.Pages.Operaciones.ReservaPdfModel
@{
    Layout = null;
    var op = Model.Operacion;
    var tr = Model.Transporte;

    var nombreCliente = !string.IsNullOrWhiteSpace(op.IdClienteNavigation?.NombreCliente) ? op.IdClienteNavigation.NombreCliente : op.IdClienteNavigation?.RazonSocial;
    var rutCliente = op.IdClienteNavigation?.Rut ?? "No Registrado";

    var condicionPago = op.CondicionPago switch
    {
        1 => "PREPAID",
        2 => "FULL PREPAID",
        3 => "COLLECT",
        4 => "FULL COLLECT",
        5 => "ELSEWHERE",
        _ => "TBA"
    };

    string tipoCargaStr = op.IdTipoCarga == 2 ? "REEFER" : "DRY";
    string unidadPrincipal = op.TipoContenedor ?? "40' HC";
    bool esReefer = op.IdTipoCarga == 2 || (op.Unidadestecnicas != null && op.Unidadestecnicas.Any(u => u.IdTipoCarga == 2));
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Booking_Confirm_@op.NumeroBooking</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
            :root {
                --purple-deep: #2c1b4d;
                --purple-mid: #6d2d9e;
                --purple-light: #ede9f6;
                --purple-faint: #f7f5fb;
                --red-strong: #be123c;
                --red-faint: #fff1f5;
                --text-main: #0f172a;
                --text-secondary: #334155;
                --text-muted: #64748b;
                --border: #e2e8f0;
                --bg-subtle: #f8fafc;
                --white: #ffffff;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                font-size: 11px;
                color: var(--text-main);
                background: var(--white);
                -webkit-font-smoothing: antialiased;
            }

            /* ── LAYOUT ── */
            .page {
                max-width: 820px;
                margin: 0 auto;
                padding: 0;
            }

            /* ── CABECERA ── */
            .header {
                background: var(--purple-deep);
                padding: 28px 40px 24px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
            }

            .header-left img {
                height: 38px;
                filter: brightness(0) invert(1);
                display: block;
                margin-bottom: 8px;
            }

            .header-left p {
                font-size: 8.5px;
                font-weight: 600;
                color: rgba(255,255,255,0.45);
                text-transform: uppercase;
                letter-spacing: 1.8px;
            }

            .header-right {
                text-align: right;
                display: flex;
                gap: 18px;
                align-items: flex-start;
            }

            .header-right-text h1 {
                font-size: 10px;
                font-weight: 700;
                color: rgba(255,255,255,0.55);
                text-transform: uppercase;
                letter-spacing: 2px;
                margin-bottom: 6px;
            }

            .booking-number {
                font-size: 22px;
                font-weight: 900;
                color: var(--white);
                letter-spacing: -0.5px;
                line-height: 1;
                margin-bottom: 8px;
            }

            .issue-date {
                font-size: 9px;
                font-weight: 500;
                color: rgba(255,255,255,0.45);
            }

            .qr-wrap {
                background: var(--white);
                border-radius: 6px;
                padding: 5px;
                width: 58px;
                height: 58px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .qr-wrap img {
                    width: 48px;
                    height: 48px;
                }

            /* ── BANDA ACCENT ── */
            .accent-band {
                height: 4px;
                background: linear-gradient(90deg, var(--purple-mid) 0%, #a855f7 60%, #c084fc 100%);
            }

            /* ── CUERPO ── */
            .body {
                padding: 32px 40px 40px;
            }

            /* ── SECCIONES ── */
            .section {
                margin-bottom: 28px;
            }

            .section-header {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 14px;
                padding-bottom: 8px;
                border-bottom: 1px solid var(--border);
            }

            .section-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--purple-mid);
                flex-shrink: 0;
            }

            .section-title {
                font-size: 9px;
                font-weight: 800;
                color: var(--purple-mid);
                text-transform: uppercase;
                letter-spacing: 1.5px;
            }

            /* ── GRIDS DE DATOS ── */
            .data-grid {
                display: flex;
                flex-wrap: wrap;
            }

            .data-item {
                display: flex;
                flex-direction: column;
                padding-right: 20px;
                padding-bottom: 14px;
            }

            .w-25 {
                width: 25%;
            }

            .w-33 {
                width: 33.33%;
            }

            .w-50 {
                width: 50%;
            }

            .w-100 {
                width: 100%;
            }

            .data-label {
                font-size: 8px;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.6px;
                margin-bottom: 3px;
            }

            .data-value {
                font-size: 12px;
                font-weight: 600;
                color: var(--text-main);
                text-transform: uppercase;
                line-height: 1.3;
            }

                .data-value.large {
                    font-size: 14px;
                    font-weight: 800;
                }

            /* ── TARJETA CLIENTE ── */
            .client-card {
                background: var(--purple-faint);
                border: 1px solid var(--purple-light);
                border-left: 3px solid var(--purple-mid);
                border-radius: 6px;
                padding: 14px 18px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 28px;
            }

            .client-card-left .label {
                font-size: 8px;
                font-weight: 700;
                color: var(--purple-mid);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 4px;
            }

            .client-card-left .name {
                font-size: 16px;
                font-weight: 900;
                color: var(--purple-deep);
                text-transform: uppercase;
                letter-spacing: -0.3px;
            }

            .client-card-right {
                text-align: right;
                display: flex;
                gap: 28px;
            }

            .client-meta .label {
                font-size: 8px;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.6px;
                margin-bottom: 3px;
            }

            .client-meta .value {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-main);
                text-transform: uppercase;
            }

            /* ── HITOS (3 COLUMNAS) ── */
            .milestones {
                display: flex;
                border: 1px solid var(--border);
                border-radius: 8px;
                overflow: hidden;
                margin-bottom: 28px;
            }

            .milestone-col {
                flex: 1;
                padding: 14px 18px;
                background: var(--bg-subtle);
            }

                .milestone-col.center {
                    background: var(--red-faint);
                    border-left: 1px solid var(--border);
                    border-right: 1px solid var(--border);
                }

            .milestone-col-title {
                font-size: 8.5px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                margin-bottom: 10px;
                color: var(--purple-deep);
            }

            .milestone-col.center .milestone-col-title {
                color: var(--red-strong);
            }

            .milestone-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 4px 0;
            }

                .milestone-row + .milestone-row {
                    border-top: 1px solid var(--border);
                }

            .milestone-tag {
                font-size: 8px;
                font-weight: 800;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .milestone-col.center .milestone-tag {
                color: var(--red-strong);
            }

            .milestone-date {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-main);
            }

            .milestone-col.center .milestone-date {
                font-weight: 800;
                color: var(--red-strong);
            }

            /* ── TABLA CONTENEDORES ── */
            .cargo-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid var(--border);
                border-radius: 8px;
                overflow: hidden;
            }

                .cargo-table thead tr {
                    background: var(--purple-deep);
                }

                .cargo-table thead th {
                    padding: 10px 14px;
                    font-size: 8.5px;
                    font-weight: 700;
                    color: rgba(255,255,255,0.7);
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    text-align: left;
                }

                .cargo-table tbody tr {
                    border-top: 1px solid var(--border);
                }

                    .cargo-table tbody tr:nth-child(even) {
                        background: var(--bg-subtle);
                    }

                .cargo-table tbody td {
                    padding: 11px 14px;
                    font-size: 11px;
                    font-weight: 600;
                    color: var(--text-main);
                    text-transform: uppercase;
                }

            /* ── REEFER ── */
            .reefer-grid {
                display: flex;
                gap: 0;
                border: 1px solid #bae6fd;
                border-radius: 8px;
                overflow: hidden;
                background: #f0f9ff;
            }

            .reefer-item {
                flex: 1;
                padding: 12px 16px;
                border-right: 1px solid #bae6fd;
            }

                .reefer-item:last-child {
                    border-right: none;
                }

            .reefer-label {
                font-size: 8px;
                font-weight: 700;
                color: #0284c7;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                margin-bottom: 3px;
            }

            .reefer-value {
                font-size: 13px;
                font-weight: 800;
                color: #0c4a6e;
                text-transform: uppercase;
            }

            /* ── PIE ── */
            .footer {
                margin-top: 36px;
                padding-top: 18px;
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .footer-left {
                font-size: 8.5px;
                color: var(--text-muted);
                line-height: 1.6;
            }

                .footer-left strong {
                    color: var(--purple-mid);
                    font-weight: 700;
                }

            .footer-badge {
                background: var(--purple-faint);
                border: 1px solid var(--purple-light);
                border-radius: 20px;
                padding: 5px 12px;
                font-size: 8px;
                font-weight: 800;
                color: var(--purple-mid);
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            /* ── PRINT ── */
            @@media print {
                body {
                    background: #fff;
                }

                .page {
                    max-width: 100%;
                }

                * {
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }

                @@page {
                    margin: 8mm 10mm;
                }
            }
    </style>
</head>
<body>
    <div class="page">

        <!-- CABECERA -->
        <div class="header">
            <div class="header-left">
                <img src="/img/Atilson.png" alt="Atilson" />
                <p>Global Logistics Solutions</p>
            </div>
            <div class="header-right">
                <div class="header-right-text">
                    <h1>Confirmación de Reserva</h1>
                    <div class="booking-number">@op.NumeroBooking</div>
                    <div class="issue-date">Emitido el @DateTime.Now.ToString("dd MMM yyyy · HH:mm")</div>
                </div>
                <div class="qr-wrap">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@op.NumeroBooking&color=2c1b4d" alt="QR" />
                </div>
            </div>
        </div>

        <div class="accent-band"></div>

        <div class="body">

            <!-- CLIENTE -->
            <div class="client-card">
                <div class="client-card-left">
                    <div class="label">Cliente / Exportador</div>
                    <div class="name">@nombreCliente</div>
                </div>
                <div class="client-card-right">
                    <div class="client-meta">
                        <div class="label">RUT</div>
                        <div class="value">@rutCliente</div>
                    </div>
                    <div class="client-meta">
                        <div class="label">Término de Flete</div>
                        <div class="value">@condicionPago</div>
                    </div>
                </div>
            </div>

            <!-- RUTA E ITINERARIO -->
            <div class="section">
                <div class="section-header">
                    <div class="section-dot"></div>
                    <div class="section-title">Ruta e Itinerario Marítimo</div>
                </div>
                <div class="data-grid">
                    <div class="data-item w-25">
                        <span class="data-label">Puerto Origen (POL)</span>
                        <span class="data-value">@(op.IdPuertoOrigenNavigation?.NombrePuerto ?? "TBA")</span>
                        <span class="data-label" style="margin-top: 10px;">Zarpe Estimado (ETD)</span>
                        <span class="data-value">@(op.EtdPol?.ToString("dd-MM-yyyy") ?? "TBA")</span>
                    </div>
                    <div class="data-item w-25">
                        <span class="data-label">Puerto Destino (POD)</span>
                        <span class="data-value">@(op.IdPuertoDestinoNavigation?.NombrePuerto ?? "TBA")</span>
                        <span class="data-label" style="margin-top: 10px;">Arribo Estimado (ETA)</span>
                        <span class="data-value">@(op.EtaPod?.ToString("dd-MM-yyyy") ?? "TBA")</span>
                    </div>
                    <div class="data-item w-25">
                        <span class="data-label">Naviera Asignada</span>
                        <span class="data-value">@(op.IdNavieraNavigation?.NombreNaviera ?? "TBA")</span>
                        <span class="data-label" style="margin-top: 10px;">Transbordo</span>
                        <span class="data-value">@(string.IsNullOrWhiteSpace(op.Transbordo) ? "DIRECTO" : op.Transbordo)</span>
                    </div>
                    <div class="data-item w-25">
                        <span class="data-label">Vessel / Voyage (Nave)</span>
                        <span class="data-value">@(string.IsNullOrWhiteSpace(op.Nave) ? "POR CONFIRMAR" : op.Nave)</span>
                    </div>
                </div>
            </div>

            <!-- HITOS -->
            <div class="milestones">
                <div class="milestone-col">
                    <div class="milestone-col-title">Stacking</div>
                    <div class="milestone-row">
                        <span class="milestone-tag">IN</span>
                        <span class="milestone-date">@(op.FechaStacking?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                    <div class="milestone-row">
                        <span class="milestone-tag">OUT</span>
                        <span class="milestone-date">@(op.CutOffMatriz?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                </div>
                <div class="milestone-col center">
                    <div class="milestone-col-title">Cut-Off Documental</div>
                    <div class="milestone-row">
                        <span class="milestone-tag">Fecha Límite</span>
                        <span class="milestone-date">@(op.CutOffMatriz?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                </div>
                <div class="milestone-col">
                    <div class="milestone-col-title">Late Arrival</div>
                    <div class="milestone-row">
                        <span class="milestone-tag">LAR</span>
                        <span class="milestone-date">@(op.LateArrival?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                    <div class="milestone-row">
                        <span class="milestone-tag">ELAR</span>
                        <span class="milestone-date">@(op.ElarDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                </div>
            </div>

            <!-- EQUIPO Y CARGA -->
            <div class="section">
                <div class="section-header">
                    <div class="section-dot"></div>
                    <div class="section-title">Detalle de Unidades y Equipo</div>
                </div>
                <div class="data-grid" style="margin-bottom: 14px;">
                    <div class="data-item w-50">
                        <span class="data-label">Tipo de Movimiento</span>
                        <span class="data-value">CY / CY</span>
                    </div>
                    <div class="data-item w-50">
                        <span class="data-label">Depósito Retiro Vacíos</span>
                        <span class="data-value">@(string.IsNullOrWhiteSpace(tr?.DepositoRetiro) ? "TBA" : tr.DepositoRetiro)</span>
                    </div>
                </div>

                <table class="cargo-table">
                    <thead>
                        <tr>
                            <th style="width:8%;">Cant.</th>
                            <th style="width:24%;">Equipo</th>
                            <th style="width:20%;">Condición</th>
                            <th style="width:48%;">Producto (Commodity)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>01</td>
                            <td>@unidadPrincipal @tipoCargaStr</td>
                            <td>
                                @if (op.IdTipoCarga == 2)
                                {
                                    <span>@(op.CondicionReefer ?? "FRESH") / @(op.Temperatura)°C</span>
                                }
                                else
                                {

                                    <span>Carga Seca</span>
                                }
                            </td>
                            <td>@(op.Commodity ?? "No especificado")</td>
                        </tr>
                        @if (op.Unidadestecnicas != null && op.Unidadestecnicas.Any())
                        {
                            foreach (var u in op.Unidadestecnicas)
                            {
                                <tr>
                                    <td>01</td>
                                    <td>@u.TipoContenedor @(u.IdTipoCarga == 2 ? "REEFER" : "DRY")</td>
                                    <td>
                                        @if (u.IdTipoCarga == 2)
                                        {
                                            <span>@(u.CondicionReefer ?? "FRESH") / @(u.Temperatura)°C</span>
                                        }
                                        else
                                        {

                                            <span>Carga Seca</span>
                                        }
                                    </td>
                                    <td>@(u.Commodity ?? "No especificado")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- REEFER -->
            @if (esReefer)
            {
                <div class="section">
                    <div class="section-header">
                        <div class="section-dot" style="background:#0284c7;"></div>
                        <div class="section-title" style="color:#0284c7;">Parámetros Técnicos de Frío</div>
                    </div>
                    <div class="reefer-grid">
                        <div class="reefer-item">
                            <div class="reefer-label">Humedad</div>
                            <div class="reefer-value">@(op.Humedad?.ToString() ?? "N/A")%</div>
                        </div>
                        <div class="reefer-item">
                            <div class="reefer-label">Ventilación</div>
                            <div class="reefer-value">@(op.Ventilacion?.ToString() ?? "Cerrada") CBM</div>
                        </div>
                        <div class="reefer-item">
                            <div class="reefer-label">Tipo Atmósfera</div>
                            <div class="reefer-value">@(op.Atmosfera == "AC" ? "Controlada (AC)" : "Convencional")</div>
                        </div>
                        <div class="reefer-item">
                            <div class="reefer-label">Proveedor A/C</div>
                            <div class="reefer-value">@(op.Atmosfera == "AC" ? (op.MarcaAc ?? "Por definir") : "N/A")</div>
                        </div>
                    </div>
                </div>
            }

            <!-- PIE -->
            <div class="footer">
                <div class="footer-left">
                    Documento generado automáticamente por la plataforma de operaciones.<br>
                    Fechas sujetas a normativas de la naviera. Consultas: <strong>www.atilson.com</strong>
                </div>
                <div class="footer-badge">Atilson Cargo SpA</div>
            </div>

            <!-- ILUSTRACIÓN DECORATIVA -->
            <div style="margin-top: 40px; text-align: center;">
                <svg viewBox="0 0 560 200" xmlns="http://www.w3.org/2000/svg" style="width: 420px; display: inline-block;">

                    <!-- AGUA -->
                    <path d="M0 168 Q35 158 70 168 Q105 178 140 168 Q175 158 210 168 Q245 178 280 168 Q315 158 350 168 Q385 178 420 168 Q455 158 490 168 Q525 178 560 168 L560 200 L0 200 Z" fill="#ede9f6" />
                    <path d="M0 178 Q40 168 80 178 Q120 188 160 178 Q200 168 240 178 Q280 188 320 178 Q360 168 400 178 Q440 188 480 178 Q520 168 560 178 L560 200 L0 200 Z" fill="#d8b4fe" opacity="0.4" />

                    <!-- CASCO -->
                    <path d="M60 162 L500 162 L520 172 L40 172 Z" fill="#2c1b4d" />
                    <path d="M75 148 L485 148 L500 162 L60 162 Z" fill="#3b2465" />
                    <!-- quilla -->
                    <path d="M40 172 L520 172 Q510 182 280 186 Q50 182 40 172 Z" fill="#2c1b4d" />

                    <!-- SUPERESTRUCTURA / PUENTE -->
                    <rect x="368" y="98" width="88" height="50" rx="3" fill="#2c1b4d" />
                    <rect x="378" y="86" width="68" height="16" rx="2" fill="#3b2465" />
                    <!-- ventanas puente -->
                    <rect x="376" y="107" width="14" height="9" rx="1.5" fill="#6d2d9e" />
                    <rect x="395" y="107" width="14" height="9" rx="1.5" fill="#6d2d9e" />
                    <rect x="414" y="107" width="14" height="9" rx="1.5" fill="#6d2d9e" />
                    <rect x="433" y="107" width="14" height="9" rx="1.5" fill="#6d2d9e" />
                    <rect x="376" y="122" width="14" height="9" rx="1.5" fill="#4c1d8a" opacity="0.6" />
                    <rect x="395" y="122" width="14" height="9" rx="1.5" fill="#4c1d8a" opacity="0.6" />
                    <rect x="414" y="122" width="14" height="9" rx="1.5" fill="#4c1d8a" opacity="0.6" />
                    <rect x="433" y="122" width="14" height="9" rx="1.5" fill="#4c1d8a" opacity="0.6" />
                    <!-- chimenea -->
                    <rect x="400" y="60" width="22" height="28" rx="3" fill="#2c1b4d" />
                    <rect x="404" y="52" width="14" height="10" rx="2" fill="#3b2465" />
                    <!-- humo sutil -->
                    <circle cx="411" cy="46" r="5" fill="#e9d5ff" opacity="0.4" />
                    <circle cx="416" cy="38" r="4" fill="#e9d5ff" opacity="0.25" />
                    <circle cx="420" cy="30" r="3" fill="#e9d5ff" opacity="0.15" />

                    <!-- CONTENEDORES FILA INFERIOR -->
                    <rect x="80" y="122" width="54" height="26" rx="2" fill="#6d2d9e" />
                    <rect x="137" y="122" width="54" height="26" rx="2" fill="#2c1b4d" />
                    <rect x="194" y="122" width="54" height="26" rx="2" fill="#7c3aed" />
