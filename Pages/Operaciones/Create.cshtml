        setTimeout(() => {
        formInputs.forEach(input => {
        if (parsed[input.name] && input.id !== 'ddlServicio') {
        input.value = parsed[input.name];
        input.dispatchEvent(new Event('change', { bubbles: true }));
        }
        });
        Swal.fire('Restaurado', 'Tus datos han sido cargados.', 'success');
        }, 300);

        } else {
        localStorage.removeItem('AtilsonDraftOperacion');
        }
        });
