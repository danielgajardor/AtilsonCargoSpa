        // --- 5. AUTO GUARDADO (LOCAL STORAGE) ---
        const formInputs = document.querySelectorAll(
        '#frmOperacion input:not([type="hidden"]):not([type="file"]), #frmOperacion select, #frmOperacion textarea'
        );

        const savedData = localStorage.getItem('AtilsonDraftOperacion');
        if (savedData) {
        Swal.fire({
        title: 'Borrador Encontrado',
        text: 'Tienes una operación a medio completar. ¿Deseas restaurar los datos?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sí, restaurar',
        cancelButtonText: 'No, empezar de cero',
        confirmButtonColor: 'var(--atilson-primary)'
        }).then((result) => {
        if (result.isConfirmed) {
        let parsed = JSON.parse(savedData);

        const ddlServ = document.getElementById('ddlServicio');
        if (parsed[ddlServ?.name] && ddlServ) {
        ddlServ.value = parsed[ddlServ.name];
        ddlServ.dispatchEvent(new Event('change', { bubbles: true }));
