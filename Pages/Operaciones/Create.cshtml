        // =========================================================================
        // NUEVA INTELIGENCIA: TERRESTRE VS MARÍTIMO (Países y Puertos)
        // =========================================================================
        window.originalTerrestreOptions = [];

        window.poblarPuertosTerrestre = function() {
        const paisSelect = document.getElementById('inpPaisOrigen');
        const selPuerto = document.getElementById('inpPuertoTerrestre');
        const txtPuerto = document.getElementById('inpPuertoTerrestreOtro');
        if (!paisSelect || !selPuerto) return;

        const paisFiltrar = removeAccents(paisSelect.value);
        let optionsHTML = '<option value="">-- Seleccionar Puerto --</option>';

        if (paisFiltrar === 'OTROS') {
        selPuerto.style.display = 'none';
        selPuerto.setAttribute('disabled', 'disabled');
        if (txtPuerto) {
        txtPuerto.style.display = 'block';
        txtPuerto.removeAttribute('disabled');
        }
        } else {
        selPuerto.style.display = 'block';
        selPuerto.removeAttribute('disabled');
        if (txtPuerto) {
        txtPuerto.style.display = 'none';
        txtPuerto.setAttribute('disabled', 'disabled');
        }

        window.originalTerrestreOptions.forEach(opt => {
        if(!opt.value) return;
        let paisOption = removeAccents(opt.pais);
        if (paisOption === paisFiltrar || paisOption.includes(paisFiltrar)) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        }
        });
        selPuerto.innerHTML = optionsHTML;
        selPuerto.value = "";
        window.actualizarTerminalTerrestre();
        }
        };

        window.syncTransporteIntelligence = function() {
        const ddlServicio = document.getElementById('ddlServicio');
        if (!ddlServicio) return;

        const valTexto = removeAccents(ddlServicio.options[ddlServicio.selectedIndex]?.text || '');
        let esMaritimo = valTexto.includes('MAR') || valTexto.includes('INTEGRAL');
        let esTerrestre = valTexto.includes('TER') || valTexto.includes('INTEGRAL');

        const selPuertoTerrestre = document.getElementById('inpPuertoTerrestre');
        const txtPuertoTerrestre = document.getElementById('inpPuertoTerrestreOtro');

        if (esTerrestre) {
        if (!esMaritimo) {
        if (selPuertoTerrestre) {
        selPuertoTerrestre.removeAttribute('readonly');
        selPuertoTerrestre.style.pointerEvents = 'auto';
        selPuertoTerrestre.style.backgroundColor = '#f8fafc';
        }
        window.poblarPuertosTerrestre();
        } else {
        if (selPuertoTerrestre) {
        selPuertoTerrestre.style.display = 'block';
        selPuertoTerrestre.setAttribute('readonly', 'readonly');
        selPuertoTerrestre.style.pointerEvents = 'none';
        selPuertoTerrestre.style.backgroundColor = '#e2e8f0';

        let optionsHTML = '<option value="">-- Traído desde Marítimo --</option>';
        if (window.originalTerrestreOptions) {
        window.originalTerrestreOptions.forEach(opt => {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        });
        }
        selPuertoTerrestre.innerHTML = optionsHTML;
        }
        if (txtPuertoTerrestre) {
        txtPuertoTerrestre.style.display = 'none';
        txtPuertoTerrestre.setAttribute('disabled', 'disabled');
        }

        const polSelect = document.getElementById('inpPol');
        const podSelect = document.getElementById('inpPod');
        if (modoActual === 'EXP' && polSelect) {
        window.syncPuertoTerrestre(polSelect);
        } else if (modoActual === 'IMP' && podSelect) {
        window.syncPuertoTerrestre(podSelect);
        }
        }
        }
        };

        window.syncPuertoTerrestre = function(selectElement) {
        const selTerrestre = document.getElementById('inpPuertoTerrestre');
        if(!selTerrestre) return;

        if (!selectElement || !selectElement.value) {
        selTerrestre.value = "";
        window.actualizarTerminalTerrestre();
        return;
        }

        let nombrePuertoMaritimo = selectElement.options[selectElement.selectedIndex].text;
        selTerrestre.value = "";

        Array.from(selTerrestre.options).forEach(opt => {
        let val = removeAccents(opt.value);
        let target = removeAccents(nombrePuertoMaritimo);
        if (val.includes(target) || target.includes(val)) {
        selTerrestre.value = opt.value;
        }
        });
        window.actualizarTerminalTerrestre();
        };

        document.addEventListener("DOMContentLoaded", function () {
        const ptTerSelect = document.getElementById('inpPuertoTerrestre');
        if (ptTerSelect) {
        Array.from(ptTerSelect.options).forEach(opt => {
        if(opt.value) window.originalTerrestreOptions.push({value: opt.value, text: opt.text, pais: opt.getAttribute('data-pais')});
        });
        }

        const ddlServicio = document.getElementById('ddlServicio');
        if(ddlServicio) ddlServicio.addEventListener('change', window.syncTransporteIntelligence);

        setTimeout(() => window.syncTransporteIntelligence(), 300);
        });
    </script>
}