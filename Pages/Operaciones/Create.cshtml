        if(inpTerrestre) { inpTerrestre.classList.remove('d-none'); inpTerrestre.disabled = false; inpTerrestre.name = "TerminalTerrestreStr"; inpTerrestre.value = 'SVTI'; inpTerrestre.readOnly = true; }
        } else {
        selT.classList.add('d-none'); selT.disabled = true; selT.name = "";
        inpT.classList.remove('d-none'); inpT.disabled = false; inpT.name = "TerminalMaritimoStr";
        inpT.value = ''; inpT.readOnly = false;
        if(selTerrestre) { selTerrestre.classList.add('d-none'); selTerrestre.disabled = true; selTerrestre.name = ""; }
        if(inpTerrestre) { inpTerrestre.classList.remove('d-none'); inpTerrestre.disabled = false; inpTerrestre.name = "TerminalTerrestreStr"; inpTerrestre.value = ''; inpTerrestre.readOnly = false; }
        inpT.onkeyup = function() { if(inpTerrestre) inpTerrestre.value = this.value; };
        }
        };

