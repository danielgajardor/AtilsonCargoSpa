        btnGuardar.disabled = true;

        const formData = new FormData(document.getElementById('frmOperacion'));
        formData.set('GenerarPdfDirecto', 'true');

        localStorage.removeItem('AtilsonDraftOperacion');

        try {
        const response = await fetch(window.location.pathname, {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const data = await response.json();

        if (!data.success) {
        Swal.fire({
        title: 'Error al guardar',
