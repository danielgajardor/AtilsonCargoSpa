@section Scripts {
    <script>
        // =========================================================================
        // MAGIA ATILSON: AUTO-LLENADO PROFUNDO POR PDF (AJAX)
        // =========================================================================
        const pdfUploader = document.getElementById('pdfUploader');
        if (pdfUploader) {
        pdfUploader.addEventListener('change', async function(e) {
        const file = e.target.files[0];
        if (!file) return;

        Swal.fire({
        title: 'Leyendo Documento...',
        text: 'Extrayendo Cliente, Booking, Puertos y Fechas...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
        });

        const formData = new FormData();
        formData.append('archivoPdf', file);

        try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const response = await fetch('/Operaciones/Create?handler=ProcesarPdf', {
        method: 'POST',
        body: formData,
        headers: {
        'RequestVerificationToken': token
        }
        });

        if (!response.ok) throw new Error("Error en la respuesta del servidor");

        const result = await response.json();

        if (result.success) {
        // 1. Activar el Servicio Integral por defecto
        const ddlServicio = document.getElementById('ddlServicio');
        if (ddlServicio && !ddlServicio.value) {
        ddlServicio.value = "1"; // EXP INTEGRAL
        ddlServicio.dispatchEvent(new Event('change'));
        }

        // 2. Inyectar Inputs de Texto (Booking, Nave, Commodity, Fechas)
        if (result.data.booking) {
        const inp = document.getElementById('inpBooking');
        if (inp) { inp.value = result.data.booking; inp.dispatchEvent(new Event('change')); }
        }

        if (result.data.nave) {
        const inp = document.getElementById('inpNave');
        if (inp) { inp.value = result.data.nave.replace('PORT','').trim(); inp.dispatchEvent(new Event('change')); }
        }

        if (result.data.commodity) {
        const inp = document.getElementById('inpCommodity');
        if (inp) { inp.value = result.data.commodity; inp.dispatchEvent(new Event('change')); }
        }

        if (result.data.etd) {
        const inp = document.getElementById('inpEtd');
        if (inp) { inp.value = result.data.etd; inp.dispatchEvent(new Event('change')); }
        }

        if (result.data.eta) {
        const inp = document.getElementById('inpEta');
        if (inp) { inp.value = result.data.eta; inp.dispatchEvent(new Event('change')); }
        }

        // 3. Inyectar DropDowns (Naviera y Cliente)
        if (result.data.naviera) {
        const selNaviera = document.getElementById('inpNaviera');
        if (selNaviera) {
        Array.from(selNaviera.options).forEach(opt => {
        if (opt.text.toUpperCase().includes(result.data.naviera.toUpperCase())) {
        selNaviera.value = opt.value;
        selNaviera.dispatchEvent(new Event('change'));
        }
        });
        }
        }

        if (result.data.cliente) {
        const selCliente = document.getElementById('inpCliente');
        if (selCliente) {
        let clienteEncontrado = false;
        Array.from(selCliente.options).forEach(opt => {
        if (opt.text.toUpperCase().includes(result.data.cliente.toUpperCase())) {
        selCliente.value = opt.value;
        selCliente.dispatchEvent(new Event('change'));
        clienteEncontrado = true;
        }
        });
        // Si no hay match exacto, busca la primera palabra (ej. PROMAR)
        if(!clienteEncontrado) {
        let primeraPalabra = result.data.cliente.split(' ')[0];
        Array.from(selCliente.options).forEach(opt => {
        if (opt.text.toUpperCase().includes(primeraPalabra.toUpperCase()) && primeraPalabra.length > 3) {
        selCliente.value = opt.value;
        selCliente.dispatchEvent(new Event('change'));
        }
        });
        }
        }
        }

        // 4. Inyectar Puertos (POL y POD)
        if (result.data.pol) {
        const selPol = document.getElementById('inpPol');
        if (selPol) {
        Array.from(selPol.options).forEach(opt => {
        if (opt.text.toUpperCase().includes(result.data.pol.toUpperCase())) {
        selPol.value = opt.value;
        selPol.dispatchEvent(new Event('change'));
        }
        });
        }
        }

        if (result.data.pod) {
        const selPod = document.getElementById('inpPod');
        if (selPod) {
        Array.from(selPod.options).forEach(opt => {
        if (opt.text.toUpperCase().includes(result.data.pod.toUpperCase())) {
        selPod.value = opt.value;
        selPod.dispatchEvent(new Event('change'));
        }
        });
        }
        }

        // 5. Inyectar Tipo de Carga y Contenedor
        if (result.data.tipoCarga) {
        const selCarga = document.getElementById('inpCarga');
        if (selCarga) {
        selCarga.value = result.data.tipoCarga;
        selCarga.dispatchEvent(new Event('change', { bubbles: true }));

