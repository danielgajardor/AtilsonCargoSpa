        let originalPolOptions = [];
        let originalPodOptions = [];
        let originalDepositoOptions = []; // <--- AÑADIDO
        let modoActual = 'EXP';

        function removeAccents(str) {
        if (!str) return "";
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase();
        }

        window.poblarPuertosOrigen = function() {
        const paisSelect = document.getElementById('inpPaisOrigen');
        const selPuerto = document.getElementById('inpPol');
        if (!paisSelect || !selPuerto) return;

        const paisFiltrar = removeAccents(paisSelect.value);
        let optionsHTML = '<option value="">-- Seleccionar Puerto --</option>';

        originalPolOptions.forEach(opt => {
        if(!opt.value) return;
        let paisOption = removeAccents(opt.pais);

        if (modoActual === 'EXP') {
        if (paisFiltrar === 'OTROS' && paisOption !== 'CHILE' && paisOption !== 'PERU') {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        } else if (paisOption === paisFiltrar || paisOption.includes(paisFiltrar)) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        }
        } else {
        if (paisFiltrar === 'OTROS' || paisOption === paisFiltrar) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        }
        }
        });
        selPuerto.innerHTML = optionsHTML;
        selPuerto.value = "";
        if (modoActual === 'EXP') window.actualizarTerminalMaritimo();

        if (typeof window.poblarPuertosTerrestre === 'function') {
        window.poblarPuertosTerrestre();
        }
        };

        window.poblarPuertosDestino = function() {
        const paisSelect = document.getElementById('inpPaisDestino');
        const selPuerto = document.getElementById('inpPod');
        if (!paisSelect || !selPuerto) return;

        const paisFiltrar = removeAccents(paisSelect.value);
        let optionsHTML = '<option value="">-- Seleccionar Puerto --</option>';

        originalPodOptions.forEach(opt => {
        if(!opt.value) return;
        let paisOption = removeAccents(opt.pais);

        if (modoActual === 'IMP') {
        if (paisFiltrar === 'OTROS' && paisOption !== 'CHILE' && paisOption !== 'PERU') {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        } else if (paisOption === paisFiltrar || paisOption.includes(paisFiltrar)) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        }
        } else {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        }
        });
        selPuerto.innerHTML = optionsHTML;
        selPuerto.value = "";
        if (modoActual === 'IMP') window.actualizarTerminalMaritimoImpo();
        };

        window.poblarDepositos = function() {
        const paisSelectExp = document.getElementById('inpPaisOrigen');
        const paisSelectImp = document.getElementById('inpPaisDestino');
        const selDeposito = document.getElementById('inpDepositoRetiro');
        if (!selDeposito) return;

        let paisFiltrar = "CHILE"; // Por defecto

        // Detectar de dónde leer el país según si es Expo o Impo
        if (modoActual === 'EXP' && paisSelectExp) {
        paisFiltrar = removeAccents(paisSelectExp.value);
        } else if (modoActual === 'IMP' && paisSelectImp) {
        paisFiltrar = removeAccents(paisSelectImp.value);
        }

        let optionsHTML = '<option value="">Seleccionar...</option>';

        originalDepositoOptions.forEach(opt => {
        if(!opt.value) return;
        let paisOption = removeAccents(opt.pais);

        // Filtramos: Si coincide el país lo mostramos. Si es "OTROS", mostramos todo para no dejar vacío.
        if (paisOption === paisFiltrar || paisOption.includes(paisFiltrar)) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        } else if (paisFiltrar === 'OTROS' || !paisFiltrar) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text}</option>`;
        }
        });

        selDeposito.innerHTML = optionsHTML;
        selDeposito.value = "";
        };

        window.syncPuertoTerrestre = function(selectElement) {
        const selTerrestre = document.getElementById('inpPuertoTerrestre');
        if(!selTerrestre || !selectElement.value) return;

        let nombrePuertoMaritimo = selectElement.options[selectElement.selectedIndex].text;

        Array.from(selTerrestre.options).forEach(opt => {
        if (removeAccents(opt.value).includes(removeAccents(nombrePuertoMaritimo))) {
        selTerrestre.value = opt.value;
        }
        });
        window.actualizarTerminalTerrestre();
        };

        window.autoCompletarPlanta = function() {
        var selPlanta = document.getElementById('inpPlanta');
        var inpZona = document.getElementById('inpZonaCarga');
        if(selPlanta && inpZona) {
        var opt = selPlanta.options[selPlanta.selectedIndex];
        inpZona.value = opt ? (opt.getAttribute('data-zona') || "").toUpperCase() : "";
        }
        };

        window.configurarPuertosPorMovimiento = function(esExpo, esImpo) {
        const inpPaisOrigen = document.getElementById('inpPaisOrigen');
        const inpPaisDestino = document.getElementById('inpPaisDestino');
        if (!inpPaisOrigen || !inpPaisDestino) return;

        modoActual = esExpo ? 'EXP' : (esImpo ? 'IMP' : 'EXP');

        inpPaisOrigen.innerHTML = '<option value="">-- SELECCIONAR --</option>';
        inpPaisDestino.innerHTML = '<option value="">-- SELECCIONAR --</option>';

        const paisesInternacionales = ['CHINA', 'ESTADOS UNIDOS', 'ALEMANIA', 'ESPAÑA', 'BRASIL', 'ARGENTINA', 'MEXICO', 'COLOMBIA', 'JAPON', 'COREA DEL SUR', 'INDIA', 'OTROS'];

        if (modoActual === 'EXP') {
        inpPaisOrigen.innerHTML += '<option value="Chile">CHILE</option><option value="Perú">PERÚ</option><option value="Otros">OTROS</option>';
        inpPaisOrigen.value = 'Chile';

        document.getElementById('divPaisDestinoContainer').classList.add('d-none');
        document.getElementById('divTerminalImpo').classList.add('d-none');

        document.getElementById('divTerminalExpo').classList.remove('d-none');
        document.getElementById('divPolSelectContainer').className = 'col-md-7';
        document.getElementById('divPodSelectContainer').className = 'col-md-12';

        let optionsHTML = '<option value="">-- Seleccionar Puerto --</option>';
        let addedDest = new Set();
        originalPodOptions.forEach(opt => {
        let txtClean = removeAccents(opt.text);
        if(opt.value && !addedDest.has(txtClean)) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.pais}">${opt.text.toUpperCase()}</option>`;
        addedDest.add(txtClean);
        }
        });
        document.getElementById('inpPod').innerHTML = optionsHTML;
        document.getElementById('inpPod').onchange = null;
        document.getElementById('inpPol').onchange = function() { window.actualizarTerminalMaritimo(); window.syncPuertoTerrestre(this); };

        } else {
        paisesInternacionales.forEach(p => { inpPaisOrigen.innerHTML += `<option value="${p}">${p}</option>`; });
        inpPaisDestino.innerHTML += '<option value="Chile">CHILE</option><option value="Perú">PERÚ</option><option value="Otros">OTROS</option>';

        inpPaisOrigen.value = 'CHINA';
        inpPaisDestino.value = 'Chile';

        document.getElementById('divPaisDestinoContainer').classList.remove('d-none');
        document.getElementById('divTerminalImpo').classList.remove('d-none');

        document.getElementById('divTerminalExpo').classList.add('d-none');
        document.getElementById('divPolSelectContainer').className = 'col-md-12';
        document.getElementById('divPodSelectContainer').className = 'col-md-12';

        document.getElementById('inpPol').onchange = null;
        document.getElementById('inpPod').onchange = function() { window.actualizarTerminalMaritimoImpo(); window.syncPuertoTerrestre(this); };

        window.poblarPuertosDestino();
        }

        // ... final de configurarPuertosPorMovimiento
        window.poblarPuertosOrigen();
        window.actualizarTerminalMaritimo();
        window.actualizarTerminalMaritimoImpo();
        window.poblarDepositos(); // <--- AÑADIDO
        };

        window.actualizarTerminalMaritimo = function() {
        const selT = document.getElementById('selTerminalMaritimo');
        const inpT = document.getElementById('inpTerminalMaritimo');
        const selTerrestre = document.getElementById('selTerminalTerrestre');
        const inpTerrestre = document.getElementById('inpTerminalTerrestre');

        if (modoActual !== 'EXP') {
        if(selT) { selT.name = ""; selT.disabled = true; }
        if(inpT) { inpT.name = ""; inpT.disabled = true; }
        return;
        }

        const polSelect = document.getElementById('inpPol');
        if(!polSelect || !selT || !inpT) return;

        const text = polSelect.selectedIndex > 0 ? removeAccents(polSelect.options[polSelect.selectedIndex].text) : "";

        if (text.includes('VALPARAISO')) {
        selT.classList.add('d-none'); selT.disabled = true; selT.name = "";
        inpT.classList.remove('d-none'); inpT.disabled = false; inpT.name = "TerminalMaritimoStr";
        inpT.value = 'TPS'; inpT.readOnly = true;
        if(selTerrestre) { selTerrestre.classList.add('d-none'); selTerrestre.disabled = true; selTerrestre.name = ""; }
        if(inpTerrestre) { inpTerrestre.classList.remove('d-none'); inpTerrestre.disabled = false; inpTerrestre.name = "TerminalTerrestreStr"; inpTerrestre.value = 'TPS'; inpTerrestre.readOnly = true; }
        } else if (text.includes('SAN ANTONIO')) {
        selT.innerHTML = '<option value="">-- Terminal --</option><option value="STI">STI</option><option value="DPW">DPW</option>';
        selT.classList.remove('d-none'); selT.disabled = false; selT.name = "TerminalMaritimoDDL";
        inpT.classList.add('d-none'); inpT.disabled = true; inpT.name = ""; inpT.value = '';
        if(selTerrestre) {
        selTerrestre.innerHTML = '<option value="">-- Terminal --</option><option value="STI">STI</option><option value="DPW">DPW</option>';
        selTerrestre.classList.remove('d-none'); selTerrestre.disabled = false; selTerrestre.name = "TerminalTerrestreDDL";
