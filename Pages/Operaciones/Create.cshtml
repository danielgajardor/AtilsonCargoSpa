        document.addEventListener("DOMContentLoaded", function () {

        // --- 1. CARGA INICIAL DE DATOS ---
        const polSelect = document.getElementById('inpPol');
        const podSelect = document.getElementById('inpPod');
        const depSelect = document.getElementById('inpDepositoRetiro');

        if(polSelect) {
        Array.from(polSelect.options).forEach(opt => {
        if(opt.value) originalPolOptions.push({value: opt.value, text: opt.text, pais: opt.getAttribute('data-pais')});
        });
        polSelect.innerHTML = '<option value="">-- País Primero --</option>';
        }

        if(podSelect) {
        let addedDest = new Set();
        let optionsHTML = '<option value="">-- Seleccionar Puerto --</option>';

        if(depSelect) {
        Array.from(depSelect.options).forEach(opt => {
        if(opt.value) originalDepositoOptions.push({value: opt.value, text: opt.text, pais: opt.getAttribute('data-pais')});
        });
        }

        Array.from(podSelect.options).forEach(opt => {
        let txtClean = removeAccents(opt.text);
        if(opt.value && !addedDest.has(txtClean)) {
        optionsHTML += `<option value="${opt.value}" data-pais="${opt.getAttribute('data-pais')}">${opt.text.toUpperCase()}</option>`;
        originalPodOptions.push({value: opt.value, text: opt.text, pais: opt.getAttribute('data-pais')});
        addedDest.add(txtClean);
        }
        });
        podSelect.innerHTML = optionsHTML;
        }

        // --- 2. LÓGICA DEL WIZARD (Pestañas y Módulos) ---
        const ddlServicio = document.getElementById('ddlServicio');
        const tabs = document.querySelectorAll('.nav-link');
        const panes = document.querySelectorAll('.tab-pane');
        const btnPrev = document.getElementById('btnPrev');
        const btnNext = document.getElementById('btnNext');
        const btnResumen = document.getElementById('btnResumen');

        let activeTabs = [];
        let currentIndex = 0;

        function updateWizardNav() {
        tabs.forEach(t => t.classList.remove('active'));
        panes.forEach(p => p.classList.remove('active'));

        if (activeTabs.length > 0) {
        const currentTabId = activeTabs[currentIndex];
        const currentTab = document.getElementById(currentTabId);
        const currentPaneId = currentTab.getAttribute('data-target');
        const currentPane = document.getElementById(currentPaneId);

        if(currentTab) currentTab.classList.add('active');
        if(currentPane) currentPane.classList.add('active');
        }

        if(btnPrev) btnPrev.style.visibility = currentIndex > 0 ? 'visible' : 'hidden';

        if (currentIndex === activeTabs.length - 1) {
        if(btnNext) btnNext.style.display = 'none';
        if(btnResumen) btnResumen.style.display = 'inline-flex';
        } else {
        if(btnNext) btnNext.style.display = 'inline-flex';
        if(btnResumen) btnResumen.style.display = 'none';
        }
        }

        function actualizarModulos() {
        if (!ddlServicio) return;

        const valTexto = removeAccents(ddlServicio.options[ddlServicio.selectedIndex]?.text || '');
        const valNum = ddlServicio.value;

        const liMar = document.getElementById('nav-item-maritimo');
        const liTer = document.getElementById('nav-item-terrestre');
        const liDoc = document.getElementById('nav-item-documental');

        activeTabs = ['tab-general'];

        const bookingField = document.getElementById('bookingFieldWrapper');
        const maritimoRow = document.getElementById('maritimoRow');
        const terrestreContainer = document.getElementById('terrestreBookingContainer');
        const documentalContainer = document.getElementById('documentalBookingContainer');
        const baseInfoRow = document.getElementById('baseInfoRow');
        const colCliente = document.getElementById('colCliente');

        const restOfGeneralFields = document.getElementById('restOfGeneralFields');
        const wizardFooterControls = document.getElementById('wizardFooterControls');

        if (!valNum) {
        liTer.style.display = 'none'; liMar.style.display = 'none'; liDoc.style.display = 'none';
        if(restOfGeneralFields) restOfGeneralFields.style.display = 'none';
        if(wizardFooterControls) wizardFooterControls.style.display = 'none';
        bookingField.classList.add('d-none');
        } else {
        if(restOfGeneralFields) restOfGeneralFields.style.display = 'block';
        if(wizardFooterControls) wizardFooterControls.style.display = 'flex';

        let esMaritimo = valTexto.includes('MAR') || valTexto.includes('INTEGRAL');
        let esTerrestre = valTexto.includes('TER') || valTexto.includes('INTEGRAL');
        let esDocumental = valTexto.includes('DOC') || valTexto.includes('INTEGRAL');
        let esExpo = valTexto.includes('EXP');
        let esImpo = valTexto.includes('IMP');

        window.configurarPuertosPorMovimiento(esExpo, esImpo);

        liMar.style.display = esMaritimo ? 'block' : 'none';
        liTer.style.display = esTerrestre ? 'block' : 'none';
        liDoc.style.display = esDocumental ? 'block' : 'none';

        if (esMaritimo) activeTabs.push('tab-maritimo');
        if (esTerrestre) activeTabs.push('tab-terrestre');
        if (esDocumental) activeTabs.push('tab-documental');

        bookingField.classList.remove('d-none');
        if (esMaritimo && maritimoRow) {
        maritimoRow.prepend(bookingField);
        } else if (esTerrestre && terrestreContainer) {
        terrestreContainer.appendChild(bookingField);
        } else if (esDocumental && documentalContainer) {
        documentalContainer.appendChild(bookingField);
        } else if (baseInfoRow) {
        baseInfoRow.insertBefore(bookingField, colCliente);
        }

        const astMaritimo = document.querySelector('.req-maritimo-asterisk');
        document.querySelectorAll('.req-naviera, .req-carga').forEach(el => {
        if(esMaritimo) {
        el.classList.add('req-activa');
        if(astMaritimo) astMaritimo.style.display = 'inline';
        } else {
        el.classList.remove('req-activa');
        if(astMaritimo) astMaritimo.style.display = 'none';
        }
        });

        document.querySelectorAll('.select-tipo-carga').forEach(sel => {
        sel.dispatchEvent(new Event('change', { bubbles: true }));
        });
        }
        currentIndex = 0; updateWizardNav();
        }

        if(ddlServicio) {
        ddlServicio.addEventListener('change', actualizarModulos);
        actualizarModulos();
        }

        if(btnNext) { btnNext.addEventListener('click', () => { if (currentIndex < activeTabs.length - 1) { currentIndex++; updateWizardNav(); } }); }
        if(btnPrev) { btnPrev.addEventListener('click', () => { if (currentIndex > 0) { currentIndex--; updateWizardNav(); } }); }

