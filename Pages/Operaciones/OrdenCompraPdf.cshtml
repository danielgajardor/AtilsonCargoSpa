@page "{id:int}"
@model AtilsonCargoSpa.Pages.Operaciones.OrdenCompraPdfModel
@{
    Layout = null;
    var op = Model.Operacion;
    var tr = Model.Terrestre;
    var txs = Model.TransaccionesTerrestres;
    var culture = new System.Globalization.CultureInfo("es-CL");

    string ocNumber = Model.NumeroOC;

    // Rescate dinámico del proveedor amarrado a esta OC específica
    var primerProv = txs.FirstOrDefault(t => t.IdProveedorNavigation != null)?.IdProveedorNavigation;
    string proveedorNombre = primerProv != null ? primerProv.NombreProveedor.ToUpper() : (!string.IsNullOrWhiteSpace(tr.EmpresaTransporte) ? tr.EmpresaTransporte.ToUpper() : "PROVEEDOR SIN ASIGNAR");
    string proveedorRut = primerProv != null && !string.IsNullOrWhiteSpace(primerProv.Rut) ? primerProv.Rut : (!string.IsNullOrWhiteSpace(tr.RutTransporte) ? tr.RutTransporte : "S/R");

    string proveedorCiudad = !string.IsNullOrWhiteSpace(tr.ZonaCarga) ? tr.ZonaCarga.ToUpper() : "S/C";
    string direccionCarga = !string.IsNullOrWhiteSpace(op.IdClienteNavigation?.RazonSocial) ? op.IdClienteNavigation.RazonSocial.ToUpper() : "S/N";
    string lugarCarga = !string.IsNullOrWhiteSpace(tr.PlantaCarga) ? tr.PlantaCarga.ToUpper() : "S/N";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Orden_Compra_@ocNumber</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
            :root {
                --purple-deep: #2c1b4d;
                --purple-mid: #6d2d9e;
                --purple-light: #ede9f6;
                --purple-faint: #f7f5fb;
                --text-main: #0f172a;
                --text-secondary: #334155;
                --text-muted: #64748b;
                --border: #e2e8f0;
                --bg-subtle: #f8fafc;
                --white: #ffffff;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                font-size: 11px;
                color: var(--text-main);
                background: var(--white);
                -webkit-font-smoothing: antialiased;
            }

            .page {
                max-width: 820px;
                margin: 0 auto;
                padding: 0;
            }

            /* CABECERA */
            .header {
                background: var(--purple-deep);
                padding: 28px 40px 24px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
            }

            .header-left img {
                height: 38px;
                filter: brightness(0) invert(1);
                display: block;
                margin-bottom: 8px;
            }

            .header-left p {
                font-size: 8.5px;
                font-weight: 600;
                color: rgba(255,255,255,0.45);
                text-transform: uppercase;
                letter-spacing: 1.8px;
            }

            .header-right {
                text-align: right;
                display: flex;
                gap: 18px;
                align-items: flex-start;
            }

            .header-right-text h1 {
                font-size: 10px;
                font-weight: 700;
                color: rgba(255,255,255,0.55);
                text-transform: uppercase;
                letter-spacing: 2px;
                margin-bottom: 6px;
            }

            .booking-number {
                font-size: 22px;
                font-weight: 900;
                color: var(--white);
                letter-spacing: -0.5px;
                line-height: 1;
                margin-bottom: 8px;
            }

            .issue-date {
                font-size: 9px;
                font-weight: 500;
                color: rgba(255,255,255,0.45);
            }

            .qr-wrap {
                background: var(--white);
                border-radius: 6px;
                padding: 5px;
                width: 58px;
                height: 58px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .qr-wrap img {
                    width: 48px;
                    height: 48px;
                }

            .accent-band {
                height: 4px;
                background: linear-gradient(90deg, var(--purple-mid) 0%, #a855f7 60%, #c084fc 100%);
            }

            .body {
                padding: 32px 40px 40px;
            }

            .section {
                margin-bottom: 28px;
            }

            .section-header {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 14px;
                padding-bottom: 8px;
                border-bottom: 1px solid var(--border);
            }

            .section-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--purple-mid);
                flex-shrink: 0;
            }

            .section-title {
                font-size: 9px;
                font-weight: 800;
                color: var(--purple-mid);
                text-transform: uppercase;
                letter-spacing: 1.5px;
            }

            /* PROVEEDOR CARD */
            .client-card {
                background: var(--purple-faint);
                border: 1px solid var(--purple-light);
                border-left: 3px solid var(--purple-mid);
                border-radius: 6px;
                padding: 14px 18px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 28px;
            }

            .client-card-left .label {
                font-size: 8px;
                font-weight: 700;
                color: var(--purple-mid);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 4px;
            }

            .client-card-left .name {
                font-size: 16px;
                font-weight: 900;
                color: var(--purple-deep);
                text-transform: uppercase;
                letter-spacing: -0.3px;
            }

            .client-card-right {
                text-align: right;
                display: flex;
                gap: 28px;
            }

            .client-meta .label {
                font-size: 8px;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.6px;
                margin-bottom: 3px;
            }

            .client-meta .value {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-main);
                text-transform: uppercase;
            }

            /* DATOS GENERALES */
            .data-grid {
                display: flex;
                flex-wrap: wrap;
                background: var(--bg-subtle);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 15px;
                margin-bottom: 20px;
            }

            .data-item {
                display: flex;
                flex-direction: column;
                padding-right: 20px;
                width: 25%;
            }

            .data-label {
                font-size: 8px;
                font-weight: 700;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.6px;
                margin-bottom: 3px;
            }

            .data-value {
                font-size: 11px;
                font-weight: 700;
                color: var(--text-main);
                text-transform: uppercase;
                line-height: 1.3;
            }

            /* TABLA ITEMS */
            .cargo-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid var(--border);
                border-radius: 8px;
                overflow: hidden;
                margin-bottom: 28px;
            }

                .cargo-table thead tr {
                    background: var(--purple-deep);
                }

                .cargo-table thead th {
                    padding: 10px 14px;
                    font-size: 8.5px;
                    font-weight: 700;
                    color: rgba(255,255,255,0.7);
                    text-transform: uppercase;
                    letter-spacing: 0.8px;
                    text-align: left;
                }

                .cargo-table tbody tr {
                    border-top: 1px solid var(--border);
                }

                    .cargo-table tbody tr:nth-child(even) {
                        background: var(--bg-subtle);
                    }

                .cargo-table tbody td {
                    padding: 14px 14px;
                    font-size: 11px;
                    font-weight: 600;
                    color: var(--text-main);
                    vertical-align: top;
                }

            .desc-text {
                font-size: 9.5px;
                color: var(--text-muted);
                margin-top: 4px;
                font-weight: 500;
            }

            /* FOOTER Y TOTALES */
            .summary-container {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                page-break-inside: avoid;
            }

            .instructions {
                width: 55%;
                background: var(--bg-subtle);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 16px;
            }

                .instructions p {
                    margin-bottom: 6px;
                    color: var(--text-secondary);
                }

            .totals-box {
                width: 40%;
                border: 1px solid var(--border);
                border-radius: 8px;
                overflow: hidden;
            }

            .total-row {
                display: flex;
                justify-content: space-between;
                padding: 10px 16px;
                border-bottom: 1px solid var(--border);
                font-size: 12px;
                font-weight: 600;
            }

                .total-row:last-child {
                    border-bottom: none;
                }

                .total-row.grand-total {
                    background: var(--purple-mid);
                    color: white;
                    font-size: 16px;
                    font-weight: 900;
                }

            .print-btn-container {
                text-align: center;
                margin: 20px 0;
            }

            .print-btn {
                background: var(--purple-deep);
                color: white;
                border: none;
                padding: 12px 24px;
                font-size: 12px;
                border-radius: 6px;
                cursor: pointer;
                font-weight: bold;
            }

            @@media print {
                .print-btn-container {
                    display: none;
                }

                body {
                    background: #fff;
                }

                .page {
                    max-width: 100%;
                }

                * {
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }

                @@page {
                    margin: 8mm 10mm;
                }
            }
    </style>
</head>
<body>

    <div class="print-btn-container">
        <button class="print-btn" onclick="window.print()">🖨️ Imprimir / Guardar PDF</button>
    </div>

    <div class="page">
        <div class="header">
            <div class="header-left">
                <img src="/img/Atilson.png" alt="Atilson" />
                <p>Global Logistics Solutions</p>
                <p style="text-transform:none; letter-spacing:0; margin-top:2px;">www.atilson.com | +569 89012691</p>
            </div>
            <div class="header-right">
                <div class="header-right-text">
                    <h1>Orden de Compra</h1>
                    <div class="booking-number">@ocNumber</div>
                    <div class="issue-date">Emitido el @DateTime.Now.ToString("dd-MM-yyyy")</div>
                </div>
                <div class="qr-wrap">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@ocNumber&color=2c1b4d" alt="QR" />
                </div>
            </div>
        </div>

        <div class="accent-band"></div>

        <div class="body">

            <div class="client-card">
                <div class="client-card-left">
                    <div class="label">Proveedor (Transportista)</div>
                    <div class="name">@proveedorNombre</div>
                </div>
                <div class="client-card-right">
                    <div class="client-meta">
                        <div class="label">RUT</div>
                        <div class="value">@proveedorRut</div>
                    </div>
                    <div class="client-meta">
                        <div class="label">Ciudad</div>
                        <div class="value">@proveedorCiudad</div>
                    </div>
                </div>
            </div>

            <div class="data-grid">
                <div class="data-item">
                    <span class="data-label">Delivery</span>
                    <span class="data-value">ATILSON CARGO SPA</span>
                </div>
                <div class="data-item">
                    <span class="data-label">Términos de Pago</span>
                    <span class="data-value">A 15 DÍAS T/ELECTRÓNICA</span>
                </div>
                <div class="data-item">
                    <span class="data-label">Solicitado Por</span>
                    <span class="data-value">@(Model.Operacion.UsuarioModificador ?? "OPERACIONES")</span>
                </div>
                <div class="data-item">
                    <span class="data-label">Departamento</span>
                    <span class="data-value">TRANSPORTE</span>
                </div>
            </div>

            <div class="section">
                <div class="section-header">
                    <div class="section-dot"></div>
                    <div class="section-title">Detalle de Servicios a Facturar</div>
                </div>

                <table class="cargo-table">
                    <thead>
                        <tr>
                            <th style="width:25%;">Servicio</th>
                            <th style="width:35%;">Descripción de Ruta / Detalle</th>
                            <th style="width:15%; text-align:right;">P. Unitario</th>
                            <th style="width:10%; text-align:center;">Cant.</th>
                            <th style="width:15%; text-align:right;">Total + IVA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (txs.Any())
                        {
                            foreach (var tx in txs)
                            {
                                decimal totalFila = tx.MontoNeto * 1.19m;
                                <tr>
                                    <td>
                                        <strong>@tx.Concepto</strong>
                                        @if (tx.TarifaManual)
                                        {
                                            <div class="desc-text text-danger" style="font-weight:700;">* Ajuste Comercial</div>
                                        }
                                    </td>
                                    <td>
                                        <strong>TRAMO:</strong> @(tr.ZonaCarga?.ToUpper() ?? "ORIGEN") - @(tr.PuertoEntrega?.ToUpper() ?? "DESTINO")
                                        <div class="desc-text">Lugar de Carga: @direccionCarga</div>
                                        <div class="desc-text">Planta: @lugarCarga</div>
                                        @if (!string.IsNullOrWhiteSpace(tx.JustificacionManual))
                                        {
                                            <div class="desc-text text-danger" style="margin-top: 4px;">Detalle: @tx.JustificacionManual</div>
                                        }
                                    </td>
                                    <td style="text-align:right;">@(tx.Moneda == "CLP" ? "$" : "USD") @tx.MontoNeto.ToString("N0", culture)</td>
                                    <td style="text-align:center;">1</td>
                                    <td style="text-align:right; font-weight:800;">@(tx.Moneda == "CLP" ? "$" : "USD") @totalFila.ToString("N0", culture)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align:center; padding: 20px;">Sin transacciones asignadas</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="5" style="height: 40px;"></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="summary-container">
                <div class="instructions">
                    <div class="section-header" style="margin-bottom:10px; padding-bottom:5px;">
                        <div class="section-title" style="color:var(--text-main);">Instrucciones y Referencias</div>
                    </div>
                    <p><strong>Reserva (BKG):</strong> @(op.NumeroBooking ?? "S/N")</p>
                    <p><strong>Nave:</strong> @(op.Nave ?? "S/N")</p>
                    <p><strong>Contenedor:</strong> @(op.NumeroContenedor ?? "Por asignar")</p>
                    <div style="margin-top: 15px; padding-top: 10px; border-top: 1px dashed var(--border);">
                        <p style="font-size: 9px;"><strong>Autorizado por:</strong> Cristian Prada Puelma / Gerencia Operaciones Atilson Cargo</p>
                    </div>
                </div>

                <div class="totals-box">
                    <div class="total-row">
                        <span>Sub-total Neto</span>
                        <span>@Model.Neto.ToString("C0", culture)</span>
                    </div>
                    <div class="total-row">
                        <span>IVA (19%)</span>
                        <span>@Model.Iva.ToString("C0", culture)</span>
                    </div>
                    <div class="total-row grand-total">
                        <span>TOTAL</span>
                        <span>@Model.Total.ToString("C0", culture)</span>
                    </div>
                </div>
            </div>

            <div style="margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 8.5px; color: var(--text-muted); line-height: 1.6;">
                    Orden de compra generada automáticamente por el módulo financiero.<br>
                    Para facturación, por favor referenciar el número de OC impreso en este documento.
                </div>
                <div style="background: var(--purple-faint); border: 1px solid var(--purple-light); border-radius: 20px; padding: 5px 12px; font-size: 8px; font-weight: 800; color: var(--purple-mid); text-transform: uppercase;">
                    Finanzas · Atilson Cargo SpA
                </div>
            </div>

        </div>
    </div>

    <script>
            window.onload = function() {
                if (window.top === window.self) {
                    window.print();
                }
            };
    </script>
</body>
</html>