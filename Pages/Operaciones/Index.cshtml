            <a asp-page="./Create" class="btn btn-dark fw-bold px-4 shadow-sm" style="background-color: #0f172a; border: none; font-size: 12px; letter-spacing: 0.5px; border-radius: 8px; padding-top: 10px; padding-bottom: 10px;">
                <i class="bi bi-plus-lg me-2"></i> NUEVA OPERACIÓN
            </a>
        </div>
    </div>
    </div>

    <div class="workspace-nav">
        <a asp-page="./Index" class="ws-btn active"><i class="bi bi-grid-fill"></i> Main Board</a>
        <a asp-page="./Maritimo" class="ws-btn"><i class="bi bi-water"></i> Marítimo</a>
        <a asp-page="./Transporte" class="ws-btn"><i class="bi bi-truck"></i> Transporte</a>
        <a asp-page="./Documental" class="ws-btn"><i class="bi bi-file-earmark-check"></i> Documental</a>
        <a asp-page="./Almacenamiento" class="ws-btn"><i class="bi bi-boxes"></i> Almacenamiento</a>
    </div>

    <div class="filter-panel">
        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input type="text" id="liveSearchInput" class="search-input" placeholder="Buscar Booking, Cliente, Contenedor, Nave..." autocomplete="off">
        </div>
        <div class="quick-filters">
            <div class="filter-group shadow-sm">
                <span class="filter-group-icon"><i class="bi bi-file-earmark-text"></i></span>
                <select id="filterMatriz">
                    <option value="all">Matriz: Todas</option>
                    <option value="pend">Matriz: Pendientes</option>
                    <option value="today" class="text-danger fw-bold">Matriz: Vencen Hoy</option>
                </select>
            </div>

            <div class="filter-group shadow-sm">
                <span class="filter-group-icon"><i class="bi bi-truck"></i></span>
                <select id="filterStacking">
                    <option value="all">Stacking: Todos</option>
                    <option value="pend">Stacking: Pendiente Ingreso</option>
                    <option value="today" class="text-danger fw-bold">Stacking: Cierra Hoy (OUT)</option>
                </select>
            </div>

            <button type="button" id="btnResetFilters" title="Limpiar todos los filtros">
                <i class="bi bi-eraser-fill text-muted"></i>
            </button>
        </div>
    </div>

    <div class="table-container">
        <table class="table table-exec" id="opsTable">
            <thead>
                <tr>
                    <th style="min-width: 180px;">Booking / Contenedores</th>
                    <th>Estado Workflow</th>
                    <th>Cliente</th>
                    <th>Servicio Contratado</th>
                    <th>Naviera / Nave</th>
                    <th>Ruta</th>
                    <th>Fechas</th>
                    <th>Control Stacking</th>
                    <th>Matriz BL</th>
                    <th>Gestión LAR</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Operaciones != null && Model.Operaciones.Any())
                {
                    @foreach (var op in Model.Operaciones)
                    {
                        var nombreCortoCliente = !string.IsNullOrWhiteSpace(op.IdClienteNavigation?.NombreCliente) ? op.IdClienteNavigation.NombreCliente : op.IdClienteNavigation?.RazonSocial;
 
var t = op.OperacionesTerrestres?.FirstOrDefault();
var d = op.OperacionesDocumentales?.OrderBy(x => x.Id).FirstOrDefault();

                        var s = op.IdTipoServicio ?? 0;
                        var nombreServicio = s switch
                        {
                            1 => "EXP INTEGRAL",
                            2 => "EXP MAR + TER",
                            3 => "EXP MAR + DOC",
                            4 => "EXP TER + DOC",
                            5 => "EXP MAR",
                            6 => "EXP TER",
                            7 => "EXP DOC",
                            8 => "IMP INTEGRAL",
                            9 => "IMP MAR + TER",
                            10 => "IMP MAR + DOC",
                            11 => "IMP TER + DOC",
                            12 => "IMP MAR",
                            13 => "IMP TER",
                            14 => "IMP DOC",
                            _ => "POR CONFIRMAR"
                        };

                        bool reqMaritimo = new[] { 1, 2, 3, 5, 8, 9, 10, 12 }.Contains(s);
                        bool reqTerrestre = new[] { 1, 2, 4, 6, 8, 9, 11, 13 }.Contains(s);
                        bool reqDocumental = new[] { 1, 3, 4, 7, 8, 10, 11, 14 }.Contains(s);
                        bool reqMatriz = reqMaritimo || reqDocumental;

                        string actMar = reqMaritimo ? "active" : "";
                        string actTer = !reqMaritimo && reqTerrestre ? "active" : "";
                        string actDoc = !reqMaritimo && !reqTerrestre && reqDocumental ? "active" : "";
                        string showMar = reqMaritimo ? "show active" : "";
                        string showTer = !reqMaritimo && reqTerrestre ? "show active" : "";
                        string showDoc = !reqMaritimo && !reqTerrestre && reqDocumental ? "show active" : "";

                        var estadoFlow = (op.EstadoWorkflow ?? "SOLICITADO");
                        var estadoUpper = estadoFlow.ToUpper();
                        var estBg = "#f8fafc"; var estTxt = "#64748b"; var estBorder = "#e2e8f0";

                        if (estadoUpper.Contains("SOLICITADO") || estadoUpper.Contains("CONFIRMADO") || estadoUpper.Contains("ENVIO A CLIENTE") || estadoUpper.Contains("ENVÍO A CLIENTE"))
                        { estBg = "#fef3c7"; estTxt = "#d97706"; estBorder = "#fde68a"; }
                        else if (estadoUpper.Contains("EN RUTA PLANTA") || estadoUpper.Contains("ENTREGADO A STACKING") || estadoUpper.Contains("ARRIBADO A PLANTA") || estadoUpper.Contains("SALIDA DE PLANTA") || estadoUpper.Contains("EN RUTA A PUERTO"))
                        { estBg = "#e0f2fe"; estTxt = "#0284c7"; estBorder = "#bae6fd"; }
                        else if (estadoUpper.Contains("EMBARCADO") || estadoUpper.Contains("ZARPE") || estadoUpper.Contains("PROXIMO ARRIBO") || estadoUpper.Contains("PRÓXIMO ARRIBO"))
                        { estBg = "#f3e8ff"; estTxt = "#7e22ce"; estBorder = "#e9d5ff"; }
                        else if (estadoUpper.Contains("ARRIBADO") || estadoUpper.Contains("CONTENEDOR RETIRADO") || estadoUpper.Contains("FINALIZADO") || estadoUpper.Contains("CERRADO"))
                        { estBg = "#dcfce7"; estTxt = "#16a34a"; estBorder = "#bbf7d0"; }
                        else if (estadoUpper.Contains("CANCELADO"))
                        { estBg = "#fef2f2"; estTxt = "#dc2626"; estBorder = "#fecaca"; }

                        string alertMatrizHtml = ""; string alertStackingHtml = ""; string alertTransporteHtml = "";
                        Model.GenerarAlertasProactivas(op, t, d, reqMaritimo, reqDocumental, reqMatriz, reqTerrestre, out alertMatrizHtml, out alertStackingHtml, out alertTransporteHtml);

                        bool isIngresado = op.ContenedorIngresado;
                        bool hasAlertMatriz = !string.IsNullOrEmpty(alertMatrizHtml);
                        bool hasAlertStacking = !string.IsNullOrEmpty(alertStackingHtml);
                        bool hasAlertTransporte = !string.IsNullOrEmpty(alertTransporteHtml);

                        bool isRowAlert = hasAlertMatriz || (hasAlertStacking && !isIngresado) || hasAlertTransporte;
                        string filaAlertaClass = isRowAlert ? "row-alert" : "";

                        bool matrizOk = d?.MatrizPresentada == true;
                        string classMatriz = reqMatriz ? (matrizOk ? "ok" : "pend") : "text-muted opacity-25";
                        string iconMatriz = reqMatriz ? (matrizOk ? "bi-check-circle-fill" : "bi-x-circle-fill") : "bi-dash";

                        string isMatrizPend = (reqMatriz && !matrizOk).ToString().ToLower();
                        string isStackingPend = (reqMaritimo && !isIngresado).ToString().ToLower();
                        string reqMaritimoStr = reqMaritimo.ToString().ToLower();

                        string dateMatriz = op.CutOffMatriz?.ToString("dd/MM/yy HH:mm") ?? "-";
                        string dateStackingOut = (op.LateArrival ?? op.CutOffMatriz)?.ToString("dd/MM/yy HH:mm") ?? "-";

                        string fechaActualMatriz = "-";
                        if (reqMatriz && d != null && !string.IsNullOrWhiteSpace(d.LogMatriz))
                        {
                            var match = System.Text.RegularExpressions.Regex.Match(d.LogMatriz, @"font-size:9px;['""]>([^<]+)</span");
                            if (match.Success)
                            {
                                fechaActualMatriz = match.Groups[1].Value.Trim();
                            }
                        }

                        string estadoLar = op.EstadoLar ?? "";
                        string classLar = "text-muted opacity-25"; string iconLar = "bi-dash";
                        if (reqMaritimo)
                        {
                            if (estadoLar.Contains("AUTORIZADO") || estadoLar.Contains("INGRESADO")) { classLar = "ok"; iconLar = "bi-check-circle-fill"; }
                            else if (estadoLar.Contains("SOLICITADO")) { classLar = "warn"; iconLar = "bi-clock-fill"; }
                            else { classLar = "text-muted opacity-25"; iconLar = "bi-dash"; }
                        }

                        string classElar = op.ElarDate.HasValue ? "warn" : "text-muted opacity-25";
                        string iconElar = op.ElarDate.HasValue ? "bi-exclamation-circle-fill" : "bi-dash";

                        string valLlegadaPlanta = (t != null && t.LlegadaPlanta != null) ? Convert.ToDateTime(t.LlegadaPlanta).ToString("yyyy-MM-ddTHH:mm") : "";
                        string valSalidaPlanta = (t != null && t.SalidaPlanta != null) ? Convert.ToDateTime(t.SalidaPlanta).ToString("yyyy-MM-ddTHH:mm") : "";
                        string valLlegadaPuerto = (t != null && Convert.ToDateTime(t.LlegadaPuerto).Year > 2000) ? Convert.ToDateTime(t.LlegadaPuerto).ToString("yyyy-MM-ddTHH:mm") : "";
                        string valSalidaPuerto = (t != null && t.SalidaPuerto != null) ? Convert.ToDateTime(t.SalidaPuerto).ToString("yyyy-MM-ddTHH:mm") : "";

                        string FormatearTipoPuro(string tipoConte, int? tipoCarga)
                        {
                            int tcNum = tipoCarga.GetValueOrDefault(1);
                            string tc = (tipoConte ?? "40' HC").Replace("'", "").Replace("REEFER", "RF");
                            if (!tc.Contains("DRY") && !tc.Contains("RF")) tc += (tcNum == 2 ? " RF" : " DRY");
                            return tc;
                        }

                        // --- FILA PRINCIPAL (VISIBLE EN LA TABLA) ---
                        <tr class="row-main op-row @filaAlertaClass row-clickable"
                            data-matriz-pend="@isMatrizPend"
                            data-stacking-pend="@isStackingPend"
                            data-date-matriz="@(op.CutOffMatriz?.ToString("yyyy-MM-ddTHH:mm:ss"))"
                            data-date-stacking="@((op.LateArrival ?? op.CutOffMatriz)?.ToString("yyyy-MM-ddTHH:mm:ss"))"
                            data-req-maritimo="@reqMaritimoStr"
                            data-booking="@op.NumeroBooking"
                            data-cliente="@nombreCortoCliente"
                            data-is-ing="@isIngresado.ToString().ToLower()"
                            onclick="abrirModal(this, event)">

                            <td>
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="icon-alert-wrapper mb-1">
                                            <i class="bi bi-exclamation-triangle-fill icon-alert alert-icon-main" title="Haz clic para revisar las alertas" onclick="abrirOpcionesAlerta(this, event);" style="display: @(isRowAlert ? "inline-block" : "none");"></i>
                                            <div class="alert-data-source d-none">
                                                @if (!string.IsNullOrEmpty(alertMatrizHtml))
                                                {
                                                    <div class="alert-item hover-matriz">@Html.Raw(alertMatrizHtml)</div>
                                                }
                                                @if (!string.IsNullOrEmpty(alertStackingHtml))
                                                {
                                                    <div class="alert-item hover-stacking" style="display: @(isIngresado ? "none" : "block");">@Html.Raw(alertStackingHtml)</div>
                                                }
                                                @if (!string.IsNullOrEmpty(alertTransporteHtml))
                                                {
                                                    <div class="alert-item hover-transporte">@Html.Raw(alertTransporteHtml)</div>
                                                }
                                                <div class="alert-item dynamic-matriz-alert"></div>
                                            </div>
                                        </div>
                                        <span class="booking-txt text-uppercase" style="color: var(--txt-main); display: block;">@op.NumeroBooking</span>
                                    </div>

                                    @{
                                        bool correoEnviado = op.CorreoClienteEnviado ?? false;
                                        int versionCorreo = op.VersionCorreo ?? 1;
                                        bool fueEnviadoAlgunaVez = op.VersionCorreo.HasValue;
                                    }
                                    <div class="ms-2 mt-1 flex-shrink-0">
                                        @if (!correoEnviado && !fueEnviadoAlgunaVez)
                                        {
                                            <span class="email-badge pend" title="Pendiente de envío al cliente"><i class="bi bi-circle-fill"></i> P</span>
                                        }
                                        else if (!correoEnviado && fueEnviadoAlgunaVez)
                                        {
                                            <span class="email-badge pend-red" title="Se modificó la operación tras el envío — pendiente de reenviar v@(versionCorreo + 1)"><i class="bi bi-circle-fill"></i> P (v@(versionCorreo + 1))</span>
                                        }
                                        else if (versionCorreo == 1)
                                        {
                                            <span class="email-badge env" title="Enviado al cliente (V1)"><i class="bi bi-circle-fill"></i> E</span>
                                        }
                                        else
                                        {
                                            <span class="email-badge env" title="Enviado al cliente (v@(versionCorreo))"><i class="bi bi-circle-fill"></i> E (v@(versionCorreo))</span>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2 bg-light border border-light rounded px-2 py-1 mt-1" style="width: fit-content;">
                                    <span class="text-nowrap" style="font-size: 10px; font-weight: 700; color: #64748b;"><i class="bi bi-box me-1"></i> @FormatearTipoPuro(op.TipoContenedor, op.IdTipoCarga)</span>
                                    @if (!string.IsNullOrWhiteSpace(op.NumeroContenedor))
                                    {
                                        <span style="font-size: 11px; font-weight: 800; color: var(--atilson-dark);">@op.NumeroContenedor</span>
                                    }
                                </div>
                            </td>

                            <td class="align-middle text-center" onclick="event.stopPropagation();">
    <div class="dropdown">
        <span class="estado-badge dropdown-toggle shadow-sm" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: @estBg; color: @estTxt; border-color: @estBorder; cursor: pointer;">@estadoUpper</span>
                                    <ul class="dropdown-menu shadow-lg border-0" style="font-size: 11px; font-weight: 700; min-width: 230px; border-radius: 8px;">
                                        <li><h6 class="dropdown-header text-muted fw-bold" style="font-size: 10px;">FASE OPERATIVA (WORKFLOW)</h6></li>
                                        <li><a class="dropdown-item py-2" href="#" onclick="cambiarEstadoOperacion(this, @op.Id, 'Solicitado', false, event)">1. Solicitado (A Naviera)</a></li>
                                        <li><a class="dropdown-item py-2" href="#" onclick="cambiarEstadoOperacion(this, @op.Id, 'Confirmado', false, event)">2. Confirmado (Naviera)</a></li>
                                        <li><a class="dropdown-item py-2" href="#" onclick="cambiarEstadoOperacion(this, @op.Id, 'Envío a Cliente', false, event)">3. Envío a Cliente</a></li>
                                        <li><a class="dropdown-item py-2" href="#" onclick="cambiarEstadoOperacion(this, @op.Id, 'En Ruta Planta', false, event)">4. En Ruta Planta</a></li>
                                        <li><a class="dropdown-item py-2" href="#" onclick="cambiarEstadoOperacion(this, @op.Id, 'Arribado a Planta', true, event)">4.5 Arribado a Planta <i class="bi bi-clock text-muted ms-1"></i></a></li>
                                        <li><a class="dropdown-item py-2" href="#" onclick="cambiarEstadoOperacion(this, @op.Id, 'Salida de Planta', true, event)">5. Salida de Planta <i class="bi bi-clock text-muted ms-1"></i></a></li>
