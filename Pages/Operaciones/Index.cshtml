    /* Formularios y Tarjetas */
    .pro-card { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
    .pro-card-gray { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
    .pro-card-red { background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
    
    .pro-label { font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; display: block; }
    .pro-input { width: 100%; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px 12px; font-size: 13px; color: #111827; background: #f3f4f6; transition: all 0.2s; }
    .edit-mode .pro-input:not([readonly]) { background: #ffffff; }
    .edit-mode .pro-input:not([readonly]):focus { border-color: #3b82f6; outline: none; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    
    /* Trazabilidad (Stepper) */
    .pro-stepper { display: flex; justify-content: space-between; position: relative; margin: 10px 0 30px; padding: 0 20px; }
    .pro-stepper::before { content: ''; position: absolute; top: 12px; left: 30px; right: 30px; height: 2px; background: #e5e7eb; z-index: 1; }
    .pro-step { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 8px; background: #fff; padding: 0 10px; }
    .pro-step-icon { width: 26px; height: 26px; border-radius: 50%; background: #ffffff; border: 2px solid #d1d5db; display: flex; align-items: center; justify-content: center; font-size: 12px; color: transparent; transition: all 0.3s; }
    .pro-step.completed .pro-step-icon { background: #10b981; border-color: #10b981; color: white; }
    .pro-step.rejected .pro-step-icon { background: #ef4444; border-color: #ef4444; color: white; }
    .pro-step-text { font-size: 10px; font-weight: 700; color: #6b7280; text-transform: uppercase; }
    .pro-step.completed .pro-step-text { color: #111827; }

    /* Tablas de Reemisiones */
    .pro-table { width: 100%; border-collapse: collapse; }
    .pro-table th { font-size: 10px; font-weight: 700; color: #94a3b8; text-transform: uppercase; padding-bottom: 10px; border-bottom: 1px solid #e5e7eb; text-align: left; }
    .pro-table td { padding: 12px 0; border-bottom: 1px dashed #e5e7eb; vertical-align: middle; }
    
    /* Botones Clean */
    .pro-btn { font-size: 11px; font-weight: 700; padding: 8px 16px; border-radius: 6px; border: none; cursor: pointer; transition: filter 0.2s; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; }
    .pro-btn:hover { filter: brightness(0.9); color: white; }

   /* =========================================================
       CHECKBOXES PERFECTOS (SIN BUGS VISUALES)
       ========================================================= */
    .pro-check {
        appearance: none !important;
        -webkit-appearance: none !important;
        background-color: #fff !important;
        background-image: none !important;
        margin: 0;
        border: 2px solid #cbd5e1;
        cursor: pointer;
        display: inline-block;
        position: relative;
        flex-shrink: 0;
        width: 18px; height: 18px; border-radius: 4px;
        transition: all 0.2s ease;
    }
    .pro-check:checked { background-color: #0f172a !important; border-color: #0f172a !important; }
    .pro-check:checked::after {
        content: ''; position: absolute; width: 5px; height: 10px;
        border: solid white; border-width: 0 2px 2px 0;
        transform: rotate(45deg); top: 1px; left: 5px;
    }
    
    /* Input de Archivos Minimalista para que no rompa el diseño al editar */
    .pro-file-input {
        font-size: 9px !important;
        padding: 4px !important;
        background: #f8fafc;
        border: 1px dashed #94a3b8;
        border-radius: 4px;
        width: 100%;
        color: #475569;
        cursor: pointer;
        margin-top: 4px;
    }
    .pro-file-input::file-selector-button {
        background: #e2e8f0; border: none; border-radius: 3px;
        color: #334155; font-weight: bold; padding: 2px 6px; margin-right: 6px; cursor: pointer;
    }

    /* =========================================================
       DOCUMENTOS BASE - DISEÑO LINEAL (FULL WIDTH)
       ========================================================= */
    .base-row { display: flex; align-items: center; padding: 12px 20px; border-bottom: 1px solid #f1f5f9; transition: background 0.2s; }
    .base-row:hover { background: #f8fafc; }
    .base-row:last-child { border-bottom: none; }
    
    .mini-stepper { display: flex; align-items: center; gap: 4px; margin-top: 4px; }
    .mini-step { font-size: 8px; font-weight: 800; padding: 2px 6px; border-radius: 4px; background: #e2e8f0; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
    .mini-step.active { background: #10b981; color: #ffffff; }
    .mini-arrow { font-size: 8px; color: #cbd5e1; }

    /* Ocultamos los inputs de archivo por defecto con animación suave para no romper el layout */
    .edit-only-file {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: all 0.3s ease;
        margin-top: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        border: none !important;
        display: block !important;
    }

    .edit-mode .edit-only-file {
        max-height: 40px;
        opacity: 1;
        margin-top: 4px !important;
        padding: 4px !important;
        border: 1px dashed #94a3b8 !important;
    }

    /* =========================================================
       V3: MOTOR DE EDICIÓN FLUIDO Y SIN DESORDEN
       ========================================================= */
    /* Ocultamos los inputs de archivo por defecto sin romper el layout */
    .v3-edit-only {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 0;
    }
    /* Cuando se habilita la edición, los archivos se deslizan suavemente */
    .edit-mode .v3-edit-only {
        max-height: 45px;
        opacity: 1;
        margin-top: 8px;
    }
    
    /* Efecto elegante para los campos de texto cuando se editan */
    .edit-mode .pro-input:not([readonly]) {
        background: #ffffff !important;
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
    }
    .pro-input[readonly] {
        cursor: default;
    }
    /* Ocultar el botón de 3ra planta si ya existe */
    .hide-if-has-p3 { display: none !important; }
</style>

<div class="container-fluid py-4">
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

    <div class="d-flex justify-content-between align-items-center mb-4">
