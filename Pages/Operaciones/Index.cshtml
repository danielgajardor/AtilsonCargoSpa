                                        @if (reqMatriz)
{
    <div class="tab-pane fade" id="quick-matriz-sub-@u.Id">
        <form method="post" action="/Operaciones/Index?handler=UpdateMatriz" enctype="multipart/form-data">
            <input type="hidden" name="__RequestVerificationToken" value="" class="anti-forgery-token-input" />
            <input type="hidden" name="IdOperacion" value="@op.Id" />
            <div class="form-section shadow-sm">
                <div class="section-title-sm mb-3"><span>Gestión de Matriz y B/L</span></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6 border-end border-light">
                        <h6 class="mod-label text-primary fw-bold mb-3"><i class="bi bi-file-earmark-text me-1"></i> Gestión de Matriz</h6>
                        
                        <div class="form-check d-flex align-items-center gap-2 mt-1 mb-3">
                            <input class="cuadradito-check" type="checkbox" name="MatrizPresentada" value="true" @(matrizOk ? "checked" : "") onchange="logMatrizConfirmada('sub-@u.Id', this)" />
                            <label class="form-check-label fw-bold text-dark mb-0" style="font-size: 11px;">MATRIZ CONFIRMADA</label>
                        </div>

                        <div class="mb-3">
                            <label class="mod-label">Evidencia Envío (A Naviera)</label>
                            <input type="file" name="EvidenciaEnvioNaviera" class="erp-input py-1 m-0" accept=".pdf, .jpg, .png"
                                   id="file-envio-naviera-sub-@u.Id"
                                   onchange="onEvidenciaNavieraChange(this, 'sub-@u.Id', '@(op.NumeroBooking ?? "")', '@(op.IdNavieraNavigation?.NombreNaviera ?? "")')" />
                            <div id="btn-envio-naviera-wrapper-sub-@u.Id" class="d-none mt-2">
                                <button type="button" class="btn btn-sm fw-bold w-100 py-2" style="background:#0f172a; color:#fff; border:none; border-radius:6px; font-size:11px;"
                                        onclick="abrirModalEnvioNaviera('sub-@u.Id', '@(op.NumeroBooking ?? "")', '@(op.IdNavieraNavigation?.NombreNaviera ?? "")')">
                                    <i class="bi bi-envelope-arrow-up me-2"></i> Enviar Evidencia a Naviera
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="mod-label text-success fw-bold mb-3"><i class="bi bi-file-earmark-pdf me-1"></i> Gestión de B/L</h6>

                        <div class="mb-3">
                            <label class="mod-label">N° de B/L</label>
                            <div class="input-group input-group-sm shadow-sm">
                                <input type="text" name="NumeroBL" class="form-control erp-input py-1 fw-bold" placeholder="Ej: MSCU1234567" id="input-bl-sub-@u.Id" />
                                <label class="input-group-text bg-white border-start-0 px-3" style="cursor:pointer; border:1px solid #e2e8f0; border-left:none; border-radius:0 6px 6px 0;" title="Adjuntar B/L">
                                    <i class="bi bi-paperclip text-muted" style="font-size:14px;"></i>
                                    <input type="file" name="ArchivoBL" accept=".pdf,.jpg,.png" style="display:none;" id="file-bl-sub-@u.Id" onchange="registrarArchivoBlMatriz(this, 'sub-@u.Id')" />
                                </label>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <div id="bl-file-status-sub-@u.Id" style="font-size:9px; color:#94a3b8;">Sin archivo adjunto</div>
                                <button type="button" id="btn-envio-borrador-sub-@u.Id" class="btn btn-sm btn-outline-primary fw-bold py-0 px-2 d-none" style="font-size: 9px; transition: 0.2s;" onclick="enviarBorradorCliente('sub-@u.Id', '@op.NumeroBooking')">
                                    <i class="bi bi-envelope-check me-1"></i> Enviar Borrador
                                </button>
                            </div>
                        </div>

                        <div class="p-3 border-start border-success border-4 bg-light rounded shadow-sm">
                            <h6 class="mod-label text-success fw-bold mb-3"><i class="bi bi-diagram-3 me-1"></i> TRAZABILIDAD BORRADOR B/L</h6>
                            @{
                                string estDocSub = d?.EstadoDocumental ?? "";
                                bool solNavieraSub = d?.MatrizPresentada == true;
                                bool blAprobadoSub = estDocSub == "B/L APROBADO" || d?.MatrizPresentada == true;
                                bool blCambiosSub = estDocSub == "CAMBIOS B/L" || estDocSub == "RECHAZADO";
                                bool blEnviadoSub = estDocSub == "BORRADOR ENVIADO" || blCambiosSub || blAprobadoSub;

                                string comentariosBase64Sub = "";
                                if (blCambiosSub && !string.IsNullOrEmpty(op.HistorialCorreos)) {
                                    var lineasSub = op.HistorialCorreos.Split('\n');
                                    var lineaCambiosSub = lineasSub.FirstOrDefault(l => l.Contains("solicita los siguientes cambios:"));
                                    if (lineaCambiosSub != null && lineaCambiosSub.Contains("cambios: \"")) {
                                        string txtSub = lineaCambiosSub.Substring(lineaCambiosSub.IndexOf("cambios: \"") + 10).TrimEnd('"');
                                        comentariosBase64Sub = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(txtSub));
                                    }
                                }
                            }
                            <div class="stepper-trazabilidad mb-3" id="stepper-matriz-sub-@u.Id">
                                <div class="step-item @(solNavieraSub ? "completed" : "")" style="width:25%; cursor: default;"><div class="step-circle"><i class="bi bi-check-lg" style="font-size:14px;"></i></div><div class="step-title">Sol. Naviera</div></div>
                                <div class="step-item @(blEnviadoSub ? "completed" : "")" style="width:25%; cursor: default;"><div class="step-circle"><i class="bi bi-check-lg" style="font-size:14px;"></i></div><div class="step-title">Envío Cliente</div></div>
                                @if (blCambiosSub) {
                                    <div class="step-item rejected" style="width:25%; cursor: pointer;" data-comment="@comentariosBase64Sub" onclick="verCambiosCliente(this)" title="Clic para ver comentarios"><div class="step-circle"><i class="bi bi-exclamation-lg" style="font-size:14px;"></i></div><div class="step-title">Cambios Solicitados</div></div>
                                } else {
                                    <div class="step-item" style="width:25%; cursor: default;"><div class="step-circle"><i class="bi bi-check-lg" style="font-size:14px;"></i></div><div class="step-title">Cambios</div></div>
                                }
                                <div class="step-item @(blAprobadoSub ? "completed" : "")" style="width:25%; cursor: default;" id="step-aprob-matriz-sub-@u.Id"><div class="step-circle"><i class="bi bi-check-lg" style="font-size:14px;"></i></div><div class="step-title">OK Final</div></div>
                            </div>
                            @if(blCambiosSub) {
                                <div class="text-center mb-3">
                                    <button type="button" class="btn btn-sm btn-outline-danger fw-bold py-1 px-3 shadow-sm w-100" style="font-size: 10px; border-radius: 6px; background-color: #fef2f2;" data-comment="@comentariosBase64Sub" onclick="verCambiosCliente(this)">
                                        <i class="bi bi-eye-fill me-1"></i> VER CAMBIOS DEL CLIENTE
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="row pt-3 border-top">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mod-label text-warning fw-bold m-0"><i class="bi bi-journal-text me-1"></i> INCIDENCIAS Y REGISTRO DE CAMBIOS</h6>
                            <button type="button" class="btn btn-sm btn-outline-warning fw-bold py-1 shadow-sm edit-only-inline" style="font-size:9px; color:#d97706; border-color:#fcd34d;" onclick="registrarIncidenciaSubcert('matriz', 'sub-@u.Id')">
                                <i class="bi bi-plus-circle me-1"></i> Registrar Cambio
                            </button>
                        </div>
                        <input type="hidden" name="docUpdates.LogMatriz" value="@d?.LogMatriz" />
                        <div id="log-matriz-txt-sub-@u.Id" class="text-muted border rounded p-2 bg-light log-incidencias-wrap" style="font-size:9px; height:120px; overflow-y:auto;">
                            @Html.Raw(!string.IsNullOrEmpty(d?.LogMatriz) ? d?.LogMatriz : "Sin registros.")
                        </div>
                    </div>
                </div>

                <div class="col-12 text-end mt-3 pt-2">
                    <button type="button" class="btn btn-dark btn-sm fw-bold w-100 py-2 shadow-sm" onclick="guardarFormularioModal(this.closest('form'), this)">Guardar Matriz y B/L</button>
                </div>
            </div>
        </form>
    </div>
}
