    @{
        string logSanSub = d?.LogSanitario ?? "";
        string logSanSubUpper = logSanSub.ToUpper();
        bool envSanSub = logSanSubUpper.Contains("ENVÍO A CLIENTE") || logSanSubUpper.Contains("ENVIO A CLIENTE");
        bool envAgaSanSub = logSanSubUpper.Contains("ENVIADO A AGA-SERN");
        bool resSanSub = logSanSubUpper.Contains("RESPUESTA CLIENTE");

        int idxAprobSanSub = logSanSubUpper.IndexOf("APROBADO");
        int idxRechSanSub = logSanSubUpper.IndexOf("RECHAZADO");
        int idxRechCliSanSub = logSanSubUpper.IndexOf("RESPUESTA CLIENTE (RECHAZO)");

        if (idxAprobSanSub == -1) idxAprobSanSub = 999999;
        if (idxRechSanSub == -1) idxRechSanSub = 999999;
        if (idxRechCliSanSub == -1) idxRechCliSanSub = 999999;

        int firstRechazoSanSub = Math.Min(idxRechSanSub, idxRechCliSanSub);

        bool aprobSanSub = (idxAprobSanSub != 999999) && (idxAprobSanSub < firstRechazoSanSub);
        bool rechSanSub = (firstRechazoSanSub != 999999) && (firstRechazoSanSub < idxAprobSanSub);
        bool isRechazoClienteSanSub = (idxRechCliSanSub != 999999) && (idxRechCliSanSub <= firstRechazoSanSub) && rechSanSub;

        string commentSanSub = "";
        if (isRechazoClienteSanSub) {
            int idx1 = logSanSub.IndexOf("<em>\"", idxRechCliSanSub);
            if (idx1 != -1) {
                int idx2 = logSanSub.IndexOf("\"</em>", idx1 + 5);
                if (idx2 != -1) {
                    string txt = logSanSub.Substring(idx1 + 5, idx2 - (idx1 + 5));
                    commentSanSub = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(txt));
                }
            }
        }
    }
