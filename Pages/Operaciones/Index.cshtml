                                @foreach(var cot in Model.NuevasCotizaciones)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-dark">@(cot.FechaSolicitud?.ToString("dd/MM/yyyy HH:mm"))</td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary mb-1">@cot.TipoServicio</span><br>
                                            <span class="text-muted fw-bold" style="font-size: 9px;">@cot.TipoCarga</span>
                                        </td>
                                        <td class="fw-bold text-secondary">
                                            <span class="text-uppercase">@cot.Origen</span> <i class="bi bi-arrow-right mx-1 text-info"></i> <span class="text-uppercase">@cot.Destino</span>
                                        </td>
                                        <td class="text-uppercase text-muted" style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @(string.IsNullOrEmpty(cot.Mercancia) ? "NO ESPECIFICADO" : cot.Mercancia)
                                        </td>
                                        <td class="text-end pe-4">
                                            <button type="button" class="btn btn-sm btn-dark fw-bold px-3 py-1" 
                                                    onclick="verDetalleCotizacion(@cot.Id, '@cot.TipoServicio', '@cot.TipoCarga', '@cot.Origen', '@cot.Destino', '@(cot.Mercancia?.Replace("'","\\'") ?? "")', '@(cot.Comentarios?.Replace("\n", " ").Replace("\r", " ").Replace("'","\\'") ?? "")')" 
                                                    style="font-size: 10px;">
                                                <i class="bi bi-eye-fill me-1"></i> Revisar
                                            </button>
                                        </td>
                                    </tr>
                                }
