                                    @if (reqDocumental)
                                    {
                                        <div class="tab-pane fade @showDoc" id="documental-v3-@op.Id" role="tabpanel">
                <form id="doc-global-form-v3-@op.Id" method="post" action="/Operaciones/Index?handler=QuickEditDocumental" enctype="multipart/form-data">
                    <input type="hidden" name="__RequestVerificationToken" value="" class="anti-forgery-token-input" />
                    <input type="hidden" name="IdOperacion" value="@op.Id" />

                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2" style="border-bottom: 1px solid #e5e7eb;">
                        <div>
                            <h5 class="fw-black text-dark m-0" style="font-size: 18px; letter-spacing: -0.5px;">Gestor Documental Pro</h5>
                            <p class="text-muted m-0 mt-1" style="font-size: 12px;">Arquitectura limpia para gestión de certificados.</p>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="text-muted" style="font-size:10px; font-weight:700;">Cada certificado guarda y notifica a Finanzas de forma independiente.</span>
                        </div>
                    </div>

        @{
                string GetProDot(bool? aplica, string log) {
                    if (aplica == false) return "bg-secondary opacity-25";
                    if (string.IsNullOrEmpty(log)) return "bg-warning";
                    if (log.ToUpper().Contains("RECHAZADO") || log.ToUpper().Contains("❌")) return "bg-danger";
                    if (log.ToUpper().Contains("APROBADO") || log.ToUpper().Contains("RECEPCIÓN CONFIRMADA")) return "bg-success";
                    return "bg-info"; 
                }
                string dAd = (!string.IsNullOrEmpty(d?.DusDin) || !string.IsNullOrEmpty(d?.Din)) ? "bg-success" : "bg-warning";
                string dOr = GetProDot(true, d?.LogOrigen ?? "");
                string dFi = GetProDot(d?.AplicaSag, d?.LogFitosanitario ?? "");
                string dSa = GetProDot(d?.AplicaSernapesca, d?.LogSanitario ?? "");
                string dCa = GetProDot(d?.AplicaSernapesca, d?.LogCaptura ?? "");
                string dBa = (!string.IsNullOrEmpty(d?.LogFactura) || !string.IsNullOrEmpty(d?.LogGuia)) ? "bg-success" : "bg-warning";
            }

            <div class="pro-wrapper">
                
                <div class="pro-sidebar">
                <button type="button" class="pro-nav-btn pro-nav-btn-@op.Id active" id="btn-aduana-@op.Id" onclick="openProTab('@op.Id', 'aduana')"><div class="pro-dot @dAd"></div> Aduana y Trámites</button>
                <button type="button" class="pro-nav-btn pro-nav-btn-@op.Id" id="btn-origen-@op.Id" onclick="openProTab('@op.Id', 'origen')"><div class="pro-dot @dOr"></div> Origen / TLC</button>
                <button type="button" class="pro-nav-btn pro-nav-btn-@op.Id" id="sidebar-btn-fito-@op.Id" onclick="openProTab('@op.Id', 'fito')" style="display: @(d?.AplicaSag == true ? "flex" : "none");">
                    <div class="pro-dot @dFi"></div> Fitosanitario (SAG)
                </button>
                
                <button type="button" class="pro-nav-btn pro-nav-btn-@op.Id" id="sidebar-btn-sani-@op.Id" onclick="openProTab('@op.Id', 'sani')" style="display: @(d?.AplicaSernapesca == true ? "flex" : "none");">
                    <div class="pro-dot @dSa"></div> Sanitario (Sernap.)
                </button>
                <button type="button" class="pro-nav-btn pro-nav-btn-@op.Id" id="sidebar-btn-cap-@op.Id" onclick="openProTab('@op.Id', 'cap')" style="display: @(d?.AplicaSernapesca == true ? "flex" : "none");">
                    <div class="pro-dot @dCa"></div> Cert. Captura
                </button>
                <button type="button" class="pro-nav-btn pro-nav-btn-@op.Id" id="btn-sub-@op.Id" onclick="openProTab('@op.Id', 'sub')"><div class="pro-dot bg-secondary opacity-50"></div> Otros Subcerts</button>
                <button type="button" class="pro-nav-btn pro-nav-btn-@op.Id" id="btn-base-@op.Id" onclick="openProTab('@op.Id', 'base')"><div class="pro-dot @dBa"></div> Documentos Base</button>
            </div>

            <div class="pro-content-area" style="overflow-y: auto; max-height: 600px;">
                
                <div class="pro-pane-@op.Id" id="pane-aduana-@op.Id" style="display: block;">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light">
                        <div>
                            <h3 class="pro-title"><i class="bi bi-bank me-2 text-primary"></i>Aduana y Trámites</h3>
                            <p class="pro-subtitle m-0">Gestión de declaraciones y extracostos aduaneros.</p>
                        </div>
                        <div class="text-end">
                            <a class="btn-edit-inline" style="font-size:11px;" onclick="toggleEditCert('aduana', 'v3-@op.Id', this)"><i class="bi bi-pencil me-1"></i> Editar</a>
                            <div class="btn-save-wrapper d-none d-flex gap-1 mt-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size:10px;" onclick="descartarCert('aduana', 'v3-@op.Id')">Descartar</button>
                                <button type="button" class="btn btn-sm btn-success py-1 px-2" style="font-size:10px;" onclick="guardarCertificadoAjax('aduana', 'v3-@op.Id', false, this)"><i class="bi bi-save me-1"></i> Guardar</button>
                            </div>
                        </div>
                    </div>

                    <div class="pro-card d-flex gap-4 align-items-center mb-4">
                        <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                            <input class="pro-check inline-field" type="checkbox" id="chkSag-v3-@op.Id" name="docUpdates.AplicaSag" value="true" @(d?.AplicaSag == true ? "checked" : "") disabled onchange="handleTipoTramite('v3-@op.Id', 'sag')">
                            <span class="fw-bold text-success" style="font-size:12px; text-transform:uppercase;">Aplica SAG</span>
                        </label>
                        <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                            <input class="pro-check inline-field" type="checkbox" id="chkSerna-v3-@op.Id" name="docUpdates.AplicaSernapesca" value="true" @(d?.AplicaSernapesca == true ? "checked" : "") disabled onchange="handleTipoTramite('v3-@op.Id', 'sernapesca')">
                            <span class="fw-bold text-info" style="font-size:12px; text-transform:uppercase;">Aplica SERNAPESCA</span>
                        </label>
                        <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                            <input class="pro-check inline-field" type="checkbox" id="chkTerr-v3-@op.Id" value="true" @(reqTerrestre ? "checked" : "") disabled>
                            <span class="fw-bold text-secondary" style="font-size:12px; text-transform:uppercase;">TERRESTRE</span>
                        </label>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-5">
                            <label class="pro-label">Agencia de Aduanas</label>
                            <select name="docUpdates.IdAgenciaAduana" class="pro-input fw-bold mb-4" disabled>
                                <option value="">-- Seleccionar Agencia --</option>
                                @if (ViewBag.IdAgenciaAduana != null) {
                                    foreach (var item in (SelectList)ViewBag.IdAgenciaAduana) {
                                        if (d != null && d.IdAgenciaAduana?.ToString() == item.Value) { <option value="@item.Value" selected>@item.Text</option> }
                                        else { <option value="@item.Value">@item.Text</option> }
                                    }
                                }
                            </select>
                            
                            <label class="pro-label">Estado Documental General</label>
                            <input type="text" name="docUpdates.EstadoDocumental" class="pro-input text-uppercase fw-bold" value="@d?.EstadoDocumental" placeholder="Ej: Autorizado..." readonly />
                        </div>
                        <div class="col-md-7">
                            <div class="pro-card-gray m-0 h-100">
                                <div class="d-flex gap-4 mb-3">
                                    <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                                        <input class="pro-check inline-field" type="radio" name="TipoDec_v3_@op.Id" id="radioDus_v3-@op.Id" value="DUS" @(string.IsNullOrEmpty(d?.Din) ? "checked" : "") onchange="toggleDeclaracion('v3-@op.Id')" disabled>
                                        <span class="fw-bold text-primary" style="font-size:12px;">DUS (Exportación)</span>
                                    </label>
                                    <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                                        <input class="pro-check inline-field" type="radio" name="TipoDec_v3_@op.Id" id="radioDin_v3-@op.Id" value="DIN" @(!string.IsNullOrEmpty(d?.Din) ? "checked" : "") onchange="toggleDeclaracion('v3-@op.Id')" disabled>
                                        <span class="fw-bold text-primary" style="font-size:12px;">DIN (Importación)</span>
                                    </label>
                                </div>
                                <div class="row g-3" id="container-dus-v3-@op.Id" style="display: @(string.IsNullOrEmpty(d?.Din) ? "flex" : "none");">
                                    <div class="col-7"><label class="pro-label text-primary">N° DUS</label><input type="text" name="docUpdates.Dus" class="pro-input text-uppercase fw-bold text-primary" value="@d?.DusDin" placeholder="Número..." readonly /></div>
                                    <div class="col-5"><label class="pro-label text-success">Valor Trámite ($)</label><input type="text" inputmode="decimal" name="docUpdates.ValorDus" class="pro-input doc-val-input text-success fw-bold" value="@d?.ValorDus" placeholder="0" readonly /></div>
                                </div>
                                <div class="row g-3" id="container-din-v3-@op.Id" style="display: @(!string.IsNullOrEmpty(d?.Din) ? "flex" : "none");">
                                    <div class="col-7"><label class="pro-label text-primary">N° DIN</label><input type="text" name="docUpdates.Din" class="pro-input text-uppercase fw-bold text-primary" value="@d?.Din" placeholder="Número..." readonly /></div>
                                    <div class="col-5"><label class="pro-label text-success">Valor Trámite ($)</label><input type="text" inputmode="decimal" name="docUpdates.ValorDin" class="pro-input doc-val-input text-success fw-bold" value="@d?.ValorDin" placeholder="0" readonly /></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pro-card-red m-0">
                        <label class="pro-label text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-1"></i> Trámites de Corrección / Extracostos</label>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2">
                                    <input class="pro-check inline-field" type="checkbox" id="chkLeg-v3-@op.Id" name="docUpdates.MatrizPresentada" value="true" @(d?.MatrizPresentada == true ? "checked" : "") disabled onchange="toggleExclusionTramites('v3-@op.Id')">
                                    <label class="form-check-label fw-bold" style="font-size:12px; color:#991b1b;" for="chkLeg-v3-@op.Id">Legalización</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <input class="pro-check inline-field" type="checkbox" id="chkAcl-v3-@op.Id" name="docUpdates.ExtensionDocumental" value="true" @(d?.ExtensionDocumental == true ? "checked" : "") disabled onchange="toggleValorTramite(this, 'val-acl-v3-@op.Id'); toggleExclusionTramites('v3-@op.Id');">
                                    <label class="form-check-label fw-bold" style="font-size:12px; color:#991b1b;" for="chkAcl-v3-@op.Id">Aclaración</label>
                                </div>
                                <div id="val-acl-v3-@op.Id" style="display: @(d?.ExtensionDocumental == true ? "block" : "none");">
                                    <input type="text" inputmode="decimal" name="docUpdates.ValorAclaracion" class="pro-input doc-val-input text-danger fw-bold bg-white" placeholder="Valor $" value="@d?.ValorAclaracion" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <input class="pro-check inline-field" type="checkbox" id="chkCan-v3-@op.Id" name="docUpdates.GuiaVisado" value="true" @(d?.GuiaVisado == true ? "checked" : "") disabled onchange="toggleValorTramite(this, 'val-can-v3-@op.Id'); toggleExclusionTramites('v3-@op.Id');">
                                    <label class="form-check-label fw-bold" style="font-size:12px; color:#991b1b;" for="chkCan-v3-@op.Id">Cancelación</label>
                                </div>
                                <div id="val-can-v3-@op.Id" style="display: @(d?.GuiaVisado == true ? "block" : "none");">
                                    <input type="text" inputmode="decimal" name="docUpdates.ValorCancelacion" class="pro-input doc-val-input text-danger fw-bold bg-white" placeholder="Valor $" value="@d?.ValorCancelacion" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <input class="pro-check inline-field" type="checkbox" id="chkRol-v3-@op.Id" name="docUpdates.Roleo" value="true" @(d?.Roleo == true ? "checked" : "") disabled onchange="toggleValorTramite(this, 'val-rol-v3-@op.Id');">
                                    <label class="form-check-label fw-bold" style="font-size:12px; color:#991b1b;" for="chkRol-v3-@op.Id">Roleo</label>
                                </div>
                                <div id="val-rol-v3-@op.Id" style="display: @(d?.Roleo == true ? "block" : "none");">
                                    <input type="text" inputmode="decimal" name="docUpdates.ValorRoleo" class="pro-input doc-val-input text-danger fw-bold bg-white" placeholder="Valor $" value="@d?.ValorRoleo" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pro-card m-0 mt-3 p-3" id="ivv-container-v3-@op.Id" style="background-color: #f8fafc; border-color: #cbd5e1; opacity: @(d?.GeneracionIvv == true ? "1" : "0.5"); transition: opacity 0.3s;">
                        <div class="d-flex align-items-center gap-2">
                            <input class="pro-check inline-field" type="checkbox" id="chkIvv-v3-@op.Id" name="docUpdates.GeneracionIvv" value="true" @(d?.GeneracionIvv == true ? "checked" : "") disabled onchange="document.getElementById('ivv-container-v3-@op.Id').style.opacity = this.checked ? '1' : '0.5';">
                            <label class="form-check-label fw-bold text-dark" style="font-size:12px; text-transform:uppercase; cursor: pointer;" for="chkIvv-v3-@op.Id">
                                <i class="bi bi-file-earmark-check text-primary me-1"></i> Generación IVV
                            </label>
                        </div>
                    </div>
                </div>

                <div class="pro-pane-@op.Id" id="pane-origen-@op.Id" style="display: none;">
                    @{ 
