@section Scripts {
    @if (TempData["ErrorMsg"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire('Atención', '@Html.Raw(TempData["ErrorMsg"])', 'error');
            });
        </script>
    }
    @if (TempData["SuccessMsg"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: '¡Operación Exitosa!',
                    html: '@Html.Raw(TempData["SuccessMsg"])',
                    icon: 'success',
                    confirmButtonColor: '#10b981'
                });

                @if (TempData["OpenPdfId"] != null)
                {
                    <text>
                    setTimeout(() => {
                        window.open('/Operaciones/ReservaPdf?id=@TempData["OpenPdfId"]', '_blank');
                    }, 1000);
                    </text>
                }
            });
        </script>
    }

<script>
    // ==========================================
    // 0. HELPERS (Contexto del Modal)
    // ==========================================
    function modalCtx() { return document.getElementById('modalDynamicBody'); }
    function mq(selector) { const ctx = modalCtx(); return ctx ? ctx.querySelector(selector) : null; }
    function mqAll(selector) { const ctx = modalCtx(); return ctx ? Array.from(ctx.querySelectorAll(selector)) : []; }

    function isToday(dateString) {
        const d = new Date(dateString);
        const today = new Date();
        return d.getDate() === today.getDate() &&
               d.getMonth() === today.getMonth() &&
               d.getFullYear() === today.getFullYear();
    }

    // ==========================================
    // 1. SINCRONIZACIÓN DE ESTADOS LAR / ELAR
    // ==========================================
    window.syncEstadoLar = function(selectElement, elementId) {
        let hiddenInput = document.getElementById('hidden-ingresado-' + elementId) || mq('#hidden-ingresado-' + elementId);
        if (hiddenInput) {
            hiddenInput.value = (selectElement.value === "V°B° Ingresado a puerto") ? "true" : "false";
        }
        selectElement.style.color = (selectElement.value === "V°B° Ingresado a puerto") ? "#16a34a" : "";
        selectElement.style.fontWeight = (selectElement.value === "V°B° Ingresado a puerto") ? "bold" : "";
    };

    window.syncEstadoLarConFecha = function(selectElement, elementId) {
        window.syncEstadoLar(selectElement, elementId);
        if (selectElement.value === "V°B° Ingresado a puerto") {
            const ahora = new Date();
            const pad = n => String(n).padStart(2, '0');
            const fechaLocal = `${ahora.getFullYear()}-${pad(ahora.getMonth()+1)}-${pad(ahora.getDate())}T${pad(ahora.getHours())}:${pad(ahora.getMinutes())}`;
            const form = selectElement.closest('form');
            if (form) {
                const inputFecha = form.querySelector('input[name="LlegadaPuertoReal"]');
                if (inputFecha && !inputFecha.value) {
                    inputFecha.value = fechaLocal;
                    inputFecha.style.borderColor = "#16a34a";
                    inputFecha.style.background = "#f0fdf4";
                    setTimeout(() => { inputFecha.style.borderColor = ""; inputFecha.style.background = ""; }, 2000);
                }
            }
        }
    };

    // ==========================================
    // 2. INICIALIZACIÓN, FILTROS Y ALERTAS PROACTIVAS
    // ==========================================
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('select[name="EstadoLar"]').forEach(sel => {
            if (sel.value === "V°B° Ingresado a puerto") {
                sel.style.color = "#16a34a";
                sel.style.fontWeight = "bold";
            }
        });
        checkMatrizAlerts();
        actualizarTooltipsAlertas();
        setInterval(checkMatrizAlerts, 60000);

        document.addEventListener('click', function (e) {
            document.querySelectorAll('.autocomplete-items').forEach(list => {
                if (!list.parentElement.contains(e.target)) list.remove();
            });
        });

        document.getElementById('liveSearchInput')?.addEventListener('keyup', doFilters);
        document.getElementById('filterMatriz')?.addEventListener('change', doFilters);
        document.getElementById('filterStacking')?.addEventListener('change', doFilters);
        document.getElementById('btnResetFilters')?.addEventListener('click', function() {
            document.getElementById('liveSearchInput').value = '';
            document.getElementById('filterMatriz').value = 'all';
            document.getElementById('filterStacking').value = 'all';
            doFilters();
        });

        // MAGIA: Bloquear todos los inputs de dinero para Operaciones
        document.querySelectorAll('.doc-val-input').forEach(inp => {
            inp.classList.remove('doc-val-input'); 
            inp.setAttribute('readonly', 'true');
            inp.style.pointerEvents = 'none';
            inp.style.backgroundColor = '#f1f5f9';
            inp.style.color = '#94a3b8';
            inp.type = 'text';
            
            if (inp.value && inp.value !== '0' && inp.value !== '') {
                inp.value = '$ ' + parseInt(inp.value).toLocaleString('es-CL');
            } else {
                inp.placeholder = 'Costeado por Finanzas';
            }
        });
    });

    window.doFilters = function() {
        const term = document.getElementById('liveSearchInput')?.value.toLowerCase() || '';
        const fMatriz = document.getElementById('filterMatriz')?.value || 'all';
        const fStacking = document.getElementById('filterStacking')?.value || 'all';
        
        document.querySelectorAll('.row-main').forEach(row => {
            const text = row.innerText.toLowerCase();
            let show = true;
            
            if (term && !text.includes(term)) show = false;
            
            if (fMatriz === 'pend' && row.getAttribute('data-matriz-pend') !== 'true') show = false;
            if (fMatriz === 'today') {
                const cutOff = row.getAttribute('data-date-matriz');
                if (!cutOff || !isToday(cutOff)) show = false;
            }
            
            if (fStacking === 'pend' && row.getAttribute('data-stacking-pend') !== 'true') show = false;
            if (fStacking === 'today') {
                const outDate = row.getAttribute('data-date-stacking');
                if (!outDate || !isToday(outDate)) show = false;
            }
            
            row.style.display = show ? 'table-row' : 'none';
            
            let next = row.nextElementSibling;
            while(next && next.classList.contains('row-sub')) {
                next.style.display = show ? 'table-row' : 'none';
                next = next.nextElementSibling;
            }
        });
    };

    function checkMatrizAlerts() {
        let now = new Date();
        document.querySelectorAll('.cut-off-txt').forEach(span => {
            let cutOffStr = span.getAttribute('data-cutoff');
            if (!cutOffStr) return;
            let cutOff = new Date(cutOffStr);
            let diffHrs = (cutOff - now) / 3600000;
            let row = span.closest('tr');
            let isPend = row && row.getAttribute('data-matriz-pend') === "true";
            let alertContainer = row ? row.querySelector('.dynamic-matriz-alert') : null;

            if (isPend && diffHrs <= 24 && alertContainer) {
                let msg = "", bg = "";
                if (diffHrs > 12)      { msg = `[INFO] MATRIZ Vence en ${Math.round(diffHrs)} hrs.`; bg = "bg-info text-info border-info"; }
                else if (diffHrs > 3)  { msg = `[ALERTA] MATRIZ Vence en ${Math.round(diffHrs)} hrs.`; bg = "bg-warning text-warning border-warning"; }
                else if (diffHrs > 1)  { msg = `[CRÍTICO] MATRIZ Vence en menos de 3 hrs.`; bg = "bg-warning text-warning border-warning"; }
                else if (diffHrs > 0)  { msg = `[PELIGRO] MATRIZ Vence en menos de 1 HR.`; bg = "bg-danger text-danger border-danger"; }
                else                   { msg = `[VENCIDO] MATRIZ ATRASADA.`; bg = "bg-danger text-white border-danger"; }

                alertContainer.innerHTML = `<div class='p-2 mb-2 rounded bg-opacity-10 border border-opacity-25 ${bg}' style='font-size: 11px;'><strong><i class='bi bi-clock-history me-1'></i>${msg}</strong></div>`;
                let iconAlert = row.querySelector('.alert-icon-main');
                if (iconAlert) { iconAlert.style.display = 'inline-block'; row.classList.add('row-alert'); }
            } else if (alertContainer) {
                alertContainer.innerHTML = "";
            }
        });
        actualizarTooltipsAlertas();
    }

    window.actualizarTooltipsAlertas = function() {
        document.querySelectorAll('tr.op-row').forEach(row => {
            const icon = row.querySelector('.alert-icon-main');
            const dataSource = row.querySelector('.alert-data-source');
            if (!icon || !dataSource) return;

            let textos = [];
            dataSource.querySelectorAll('.alert-item').forEach(item => {
                if (item.style.display !== 'none' && item.innerText.trim() !== '') {
                    textos.push(item.innerText.trim().replace(/\s+/g, ' '));
                }
            });
            icon.setAttribute('title', textos.length > 0 ? textos.join('  •  ') : 'Haz clic para revisar las alertas');
        });
    };

    window.abrirOpcionesAlerta = function(element, event) {
        if (event) { event.preventDefault(); event.stopPropagation(); }
        const row = element.closest('tr');
        if (!row) return;

        const template = row.querySelector('.modal-data');
        let idOp = null;
        if (template) {
            let inputId = template.content.querySelector('input[name="IdOperacion"]');
            if (inputId) idOp = inputId.value;
        }
        if (!idOp) return;

        const booking = row.getAttribute('data-booking') || 'S/N';
        const dataSource = row.querySelector('.alert-data-source');
        const alertBody = document.getElementById('alertDynamicBody');
        if (!dataSource || !alertBody) return;

        const config = [
            { selector: '.hover-matriz',     label: 'Matriz Documental',   tab: `quick-matriz-${idOp}`, icon: 'bi-file-earmark-text' },
            { selector: '.hover-stacking',   label: 'Tránsito a Puerto',   tab: `maritimo-${idOp}`,     icon: 'bi-water' },
            { selector: '.hover-transporte', label: 'Logística Terrestre', tab: `terrestre-${idOp}`,    icon: 'bi-truck' }
        ];

        let html = `<div class="mb-3 pb-2 border-bottom"><span class="mod-label">Booking</span><h5 class="fw-bold text-dark m-0">${booking}</h5></div>`;
        let hayAlertas = false;

        config.forEach(cfg => {
            let item = dataSource.querySelector(cfg.selector);
            if (item && item.style.display !== 'none' && item.innerHTML.trim() !== '') {
                hayAlertas = true;
                html += `
                    <div class="mb-3">
                        ${item.innerHTML}
                        <button type="button" class="btn btn-sm btn-dark fw-bold w-100 mt-1" onclick="abrirDesdeAlerta('${idOp}', '${cfg.tab}')">
                            <i class="bi ${cfg.icon} me-1"></i> Ir a Solucionar — ${cfg.label}
                        </button>
                    </div>`;
            }
        });

        let dinamica = dataSource.querySelector('.dynamic-matriz-alert');
        if (dinamica && dinamica.innerHTML.trim() !== '') {
            hayAlertas = true;
            html += `
                <div class="mb-3">
                    ${dinamica.innerHTML}
                    <button type="button" class="btn btn-sm btn-dark fw-bold w-100 mt-1" onclick="abrirDesdeAlerta('${idOp}', 'quick-matriz-${idOp}')">
                        <i class="bi bi-file-earmark-text me-1"></i> Ir a Solucionar — Matriz Documental
                    </button>
                </div>`;
        }

        if (!hayAlertas) {
            html += `<div class="text-center text-muted py-4"><i class="bi bi-check-circle fs-1 opacity-50"></i><p class="mt-2 mb-0" style="font-size:12px;">No hay alertas activas para esta operación.</p></div>`;
        }

        alertBody.innerHTML = html;
        let modalAlertObj = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAlertas'));
        modalAlertObj.show();
    };

    window.abrirDesdeAlerta = function(idOp, tabTargetId) {
        let modalAlertasEl = document.getElementById('modalAlertas');
        if (modalAlertasEl.classList.contains('show')) {
            let modalObj = bootstrap.Modal.getInstance(modalAlertasEl);
            if (modalObj) modalObj.hide();
        }
        document.getElementById('global-alert-box').style.display = 'none';

        let allInputs = document.querySelectorAll(`tr.row-main template.modal-data input[name="IdOperacion"][value="${idOp}"]`);
        if (allInputs.length > 0) {
            let mainRow = allInputs[0].closest('tr.row-main');
            let cell = mainRow.querySelector('td');
            abrirModal(cell);
            setTimeout(() => {
                let tabBtn = modalCtx().querySelector(`button[data-bs-target="#${tabTargetId}"]`);
                if (tabBtn) { new bootstrap.Tab(tabBtn).show(); }
            }, 300);
        }
    };

    // ==========================================
    // 3. APERTURA DE MODAL Y MODO EDICIÓN
    // ==========================================
    window.abrirModal = function(element, event) {
        let e = event || window.event;
        if (e) {
            e.stopPropagation();
            let target = e.target || e.srcElement;
            if (target && (
                target.closest('.dropdown') || 
                target.closest('a') || 
                target.closest('button') || 
                target.closest('.badge-ing-pen') ||
                target.closest('.btn-action-dot') ||
                target.closest('input') ||
                target.closest('label')
            )) {
                return;
            }
        }

        let row = element ? element.closest('tr') : null;
        if (!row) return;

        let mainRow = row;
        while(mainRow && !mainRow.classList.contains('row-main') && !mainRow.classList.contains('row-sub')){
            mainRow = mainRow.previousElementSibling;
        }
        
        let bookingText = mainRow && mainRow.querySelector('.booking-txt') ? mainRow.querySelector('.booking-txt').innerText : "S/N";
        document.getElementById('modalTitleBkg').innerText = bookingText;

        let template = row.querySelector('.modal-data');
        window.activeModalTemplate = template;

        if (!template) return;
        let modalBody = document.getElementById('modalDynamicBody');
        modalBody.innerHTML = ''; 
        modalBody.appendChild(template.content.cloneNode(true));

        let tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenEl) {
            modalBody.querySelectorAll('.anti-forgery-token-input').forEach(inp => inp.value = tokenEl.value);
        }

        try {
            var triggerTabList = Array.from(modalBody.querySelectorAll('.nav-link'));
            triggerTabList.forEach(function (triggerEl) {
                var tabTrigger = new bootstrap.Tab(triggerEl);
                triggerEl.addEventListener('click', function (ev) { ev.preventDefault(); tabTrigger.show(); });
            });
        } catch(err) { console.warn("Error al cargar pestañas:", err); }

        setTimeout(() => {
            const ctx = modalCtx();
            if (!ctx) return;

            // Expansión automática de paneles si tienen data
            ctx.querySelectorAll('.row-cert').forEach(certRow => {
                let targetId = certRow.querySelector('[data-bs-toggle="collapse"]')?.getAttribute('data-bs-target');
                if (targetId) {
                    let panel = ctx.querySelector(targetId);
                    if (panel) {
                        let hasData = false;
                        panel.querySelectorAll('input.inline-field').forEach(inp => {
                            if (inp.value && inp.value.trim() !== "" && inp.value !== "0") hasData = true;
                        });
                        if (panel.querySelector('a.btn-outline-info')) hasData = true;

                        if (hasData) {
                            let radioSi = certRow.querySelector('input[type="radio"][value="si"]');
                            if (radioSi && !radioSi.checked) {
                                radioSi.checked = true;
                                let parts = targetId.replace('#panel-', '').split('-');
                                if (typeof window.toggleAplicaCert === 'function') {
                                    window.toggleAplicaCert(parts[0], parts.slice(1).join('-'), 'si');
                                }
                            }
                        }
                    }
                }
            });

            // Re-ejecutar lógicas visuales guardadas
            const idOpForm = ctx.querySelector('input[name="IdOperacion"]')?.value;
            if(idOpForm) {
                ['coa', 'dt', 'cod', 'cla', 'nep'].forEach(sub => {
                    [idOpForm, `sub-${idOpForm}`].forEach(idRef => {
                        let subRow = ctx.querySelector(`#row-${sub}-${idRef}`);
                        if (subRow && subRow.nextElementSibling) {
                            let hasSubData = false;
                            subRow.nextElementSibling.querySelectorAll('input.inline-field').forEach(inp => {
                                if (inp.value && inp.value.trim() !== "" && inp.value !== "0") hasSubData = true;
                            });
                            if (subRow.nextElementSibling.querySelector('a.btn-outline-info')) hasSubData = true;
                            
                            if (hasSubData) {
                                let chkNombre = sub.charAt(0).toUpperCase() + sub.slice(1);
                                let chk = ctx.querySelector(`#chk${chkNombre}-${idRef}`);
                                if (chk && !chk.checked) {
                                    chk.checked = true;
                                    window.toggleSubCert(`row-${sub}-${idRef}`, chk);
                                }
                            }
                        }
                    });
                });
            }

            ctx.querySelectorAll('input[type="checkbox"][id^="chkSag-"], input[type="checkbox"][id^="chkSerna-"]').forEach(sw => {
                if (sw.checked) sw.dispatchEvent(new Event('change'));
            });
            ctx.querySelectorAll('input[type="radio"]:checked').forEach(r => r.dispatchEvent(new Event('change')));
            ctx.querySelectorAll('input[id^="chkCan-"], input[id^="chkAcl-"], input[id^="chkLeg-"]').forEach(chk => {
                chk.dispatchEvent(new Event('change'));
            });

            // Trazabilidad visual
            ctx.querySelectorAll('.log-incidencias-wrap').forEach(logDiv => {
                let htmlContent = logDiv.innerHTML.toUpperCase();
                let match = logDiv.id.match(/log-(.*?)-txt-(.*)/);
                if (match) {
                    let tipo = match[1];
                    let idRef = match[2];
                    let stepper = ctx.querySelector(`#stepper-${tipo}-${idRef}`);
                    
                    if (stepper) {
                        let idxAprob = htmlContent.indexOf('APROBADO');
                        let idxRech = htmlContent.indexOf('RECHAZADO');
                        let idxRechCli = htmlContent.indexOf('RESPUESTA CLIENTE (RECHAZO)');
                        
                        if (idxAprob === -1) idxAprob = 999999;
                        if (idxRech === -1) idxRech = 999999;
                        if (idxRechCli === -1) idxRechCli = 999999;
                        
                        let firstRechazo = Math.min(idxRech, idxRechCli);
                        let isAprobado = (idxAprob !== 999999) && (idxAprob < firstRechazo);
                        let isRechazado = (firstRechazo !== 999999) && (firstRechazo < idxAprob);
                        
                        let stepAprob = ctx.querySelector(`#step-aprob-${tipo}-${idRef}`);
                        if (stepAprob && (isAprobado || isRechazado)) {
                            stepAprob.classList.add(isAprobado ? 'completed' : 'rejected');
                            stepAprob.classList.remove(isAprobado ? 'rejected' : 'completed');
                            let circle = stepAprob.querySelector('.step-circle');
                            if (circle) circle.innerHTML = isAprobado ? '<i class="bi bi-check-lg" style="font-size:16px;"></i>' : '<i class="bi bi-x-lg" style="font-size:14px;"></i>';
                            let title = stepAprob.querySelector('.step-title');
                            if (title) title.innerText = isAprobado ? 'APROBADO' : 'RECHAZADO';
                        }
                        
                        let steps = stepper.querySelectorAll('.step-item');
                        if (htmlContent.includes('ENVÍO A CLIENTE') || htmlContent.includes('ENVIO A CLIENTE')) {
                            if (steps.length > 0 && !steps[0].classList.contains('completed')) {
                                steps[0].classList.add('completed');
                                let circle = steps[0].querySelector('.step-circle');
                                if(circle) circle.innerHTML = '<i class="bi bi-check-lg" style="font-size:14px;"></i>';
                            }
                        }
                        if (htmlContent.includes('RESPUESTA CLIENTE') && !htmlContent.includes('RESPUESTA CLIENTE (RECHAZO)')) {
                            if (steps.length > 1 && !steps[1].classList.contains('completed') && !steps[1].classList.contains('rejected')) {
                                steps[1].classList.add('completed');
                                let circle = steps[1].querySelector('.step-circle');
                                if(circle) circle.innerHTML = '<i class="bi bi-check-lg" style="font-size:14px;"></i>';
                            }
                        }
                    }
                }
            });

        }, 150);

        try {
            var megaModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('megaModal'));
            megaModal.show();
        } catch(e) { console.error("Fallo al abrir el modal:", e); }
    };

    window.toggleEditMode = function(formId, btnTrigger) {
        let formContainer = mq(`#${formId}`);
        if (!formContainer) return;

        if (formContainer.innerHTML.includes("BLOQUEADO FINANZAS")) {
            Swal.fire('Operación Bloqueada', 'Este embarque ya fue enviado a Finanzas. No se puede editar.', 'warning');
            return;
        }

        formContainer.classList.add('edit-mode');

        formContainer.querySelectorAll(
            'input.inline-field, input.banner-input, input.erp-input, ' +
            'input.doc-val-input, .pro-input, ' +
            'textarea.inline-field, textarea.erp-input, textarea.style-xs'
        ).forEach(inp => {
            if (!inp.classList.contains('doc-val-input') &&
                !inp.classList.contains('view-only-depositoretiro') &&
                !inp.classList.contains('view-only-puertoentrega') &&
                !inp.classList.contains('view-only-terminalterrestre') &&
                !inp.classList.contains('view-only-terminalmar') &&
                !inp.classList.contains('view-only-planta') &&
                !inp.classList.contains('view-only-zonacarga') &&
                !inp.classList.contains('view-only-transbordo') &&
                !inp.classList.contains('view-only-link')) {
                inp.removeAttribute('readonly');
                inp.removeAttribute('disabled');
            }
        });

        formContainer.querySelectorAll('select.inline-field, select.banner-input, select.erp-input, select.select-sm, select.pro-input').forEach(sel => {
            sel.removeAttribute('disabled');
            sel.style.pointerEvents = 'auto';
            sel.style.appearance = '';
            sel.style.webkitAppearance = '';
        });

        formContainer.querySelectorAll('input[type="checkbox"].inline-field, input[type="radio"].inline-field, .pro-check').forEach(chk => {
            chk.removeAttribute('disabled');
        });

        formContainer.querySelectorAll('.edit-only-file').forEach(el => {
            el.removeAttribute('disabled');
        });

        const pairs = [
            { view: 'view-only-depositoretiro', edit: 'edit-only-depositoretiro' },
            { view: 'view-only-puertoentrega',  edit: 'edit-only-puertoentrega'  },
            { view: 'view-only-terminalterrestre', edit: 'edit-only-terminalterrestre' },
            { view: 'view-only-terminalmar',    edit: 'edit-only-terminalmar'    },
            { view: 'view-only-planta',         edit: 'edit-only-planta'         },
            { view: 'view-only-zonacarga',      edit: 'edit-only-zonacarga'      },
            { view: 'view-only-link',           edit: 'edit-only-link'           },
            { view: 'view-only-transbordo',     edit: 'edit-only-transbordo'     }
        ];

        pairs.forEach(pair => {
            formContainer.querySelectorAll(`.${pair.view}`).forEach(el => { el.style.display = 'none'; });
            formContainer.querySelectorAll(`.${pair.edit}`).forEach(el => {
                el.style.display = 'block';
                el.style.removeProperty('display');
                el.style.display = '';
                el.removeAttribute('disabled');
            });
        });

        formContainer.querySelectorAll('select.edit-only-transbordo, select.edit-only-puertoentrega, select[name="IdPuertoOrigen"], select[name="IdPuertoDestino"]').forEach(sel => {
            sel.dispatchEvent(new Event('change'));
        });
        formContainer.querySelectorAll('input[type="radio"][name^="TipoDec_"]:checked').forEach(r => r.dispatchEvent(new Event('change')));
        formContainer.querySelectorAll('input[id^="chkCan-"], input[id^="chkAcl-"], input[id^="chkLeg-"]').forEach(chk => {
            chk.dispatchEvent(new Event('change'));
        });

        let saveBtnWrapper = formContainer.querySelector('.btn-save-wrapper');
        if (saveBtnWrapper) saveBtnWrapper.classList.remove('d-none');
        
        if (btnTrigger) btnTrigger.style.display = 'none';

        formContainer.querySelectorAll('.btn-save-cert').forEach(btn => {
            btn.style.display = 'inline-block';
        });
    };

    window.cancelEditMode = function(formId) {
        let formContainer = mq(`#${formId}`);
        if (!formContainer) return;

        formContainer.classList.remove('edit-mode');

        formContainer.querySelectorAll('input.inline-field, input.banner-input, input.erp-input, input.doc-val-input, textarea.inline-field, textarea.erp-input, textarea.style-xs, .pro-input').forEach(inp => {
            if (inp.type !== 'checkbox' && inp.type !== 'radio' && inp.type !== 'file') {
                inp.setAttribute('readonly', true);
            }
        });

        formContainer.querySelectorAll('select.inline-field, select.banner-input, select.erp-input, select.select-sm, .pro-input').forEach(sel => {
            if(sel.tagName === 'SELECT'){
                sel.setAttribute('disabled', true);
                sel.style.pointerEvents = 'none';
                sel.style.appearance = 'none';
            }
        });

        formContainer.querySelectorAll('input[type="checkbox"].inline-field, input[type="radio"].inline-field, .pro-check').forEach(chk => {
            chk.setAttribute('disabled', true);
        });

        formContainer.querySelectorAll('.edit-only-file').forEach(el => {
            el.setAttribute('disabled', true);
        });

        const pairs = [
            { view: 'view-only-depositoretiro', edit: 'edit-only-depositoretiro' },
            { view: 'view-only-puertoentrega',  edit: 'edit-only-puertoentrega'  },
            { view: 'view-only-terminalterrestre', edit: 'edit-only-terminalterrestre' },
            { view: 'view-only-terminalmar',    edit: 'edit-only-terminalmar'    },
            { view: 'view-only-planta',         edit: 'edit-only-planta'         },
            { view: 'view-only-zonacarga',      edit: 'edit-only-zonacarga'      },
            { view: 'view-only-link',           edit: 'edit-only-link'           },
            { view: 'view-only-transbordo',     edit: 'edit-only-transbordo'     }
        ];

        pairs.forEach(pair => {
            formContainer.querySelectorAll(`.${pair.view}`).forEach(el => { el.style.display = ''; });
            formContainer.querySelectorAll(`.${pair.edit}`).forEach(el => { el.style.display = 'none'; el.setAttribute('disabled', true); });
        });

        let saveBtnWrapper = formContainer.querySelector('.btn-save-wrapper');
        if (saveBtnWrapper) saveBtnWrapper.classList.add('d-none');
        
        let tabPane = formContainer.closest('.tab-pane') || formContainer.parentElement;
        if(tabPane) {
            tabPane.querySelectorAll('.btn-edit-inline, .btn-edit-banner, .btn-outline-purple').forEach(btn => {
                btn.style.display = '';
            });
        }

        formContainer.querySelectorAll('.btn-save-cert').forEach(btn => {
            btn.style.display = 'none';
        });
    };

    window.toggleDocBase = function(panelId) {
        let panel = modalCtx()?.querySelector(`#${panelId}`) || document.getElementById(panelId);
        if (!panel) return;
        
        if (panel.classList.contains('open')) {
            panel.classList.remove('open');
            let overlay = document.getElementById(panelId + '-overlay');
            if (overlay) overlay.remove();
        } else {
            panel.classList.add('open');
            if (!document.getElementById(panelId + '-overlay')) {
                let overlay = document.createElement('div');
                overlay.id = panelId + '-overlay';
                overlay.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.3);z-index:1060; border-radius: 8px; transition: opacity 0.3s;';
                overlay.onclick = () => window.toggleDocBase(panelId);
                panel.parentNode.insertBefore(overlay, panel);
                panel.style.zIndex = '1065';
            }
        }
    };

    window.mostrarNombreArchivo = function(input, spanId) {
        const ctx = modalCtx();
        const span = (ctx ? ctx.querySelector('#' + spanId) : null) || document.getElementById(spanId);
        if (!span) return;
        span.textContent = input.files.length > 0 ? input.files[0].name : 'Sin archivo';
        span.classList.toggle('text-success', input.files.length > 0);
        span.classList.toggle('text-muted', input.files.length === 0);
    };

    // ==========================================
    // 4. LÓGICA DE CERTIFICADOS Y TRÁMITES
    // ==========================================
    window.toggleAplicaCert = function(certKey, idOp, valor) {
        const ctx = modalCtx() || document;
        const row = ctx.querySelector(`#row-${certKey}-${idOp}`);
        if (!row) return;

        const aplica = (valor === 'si');
        row.style.opacity = aplica ? '1' : '0.5';

        const tdToggle = row.querySelector('[data-bs-toggle="collapse"]');
        if (tdToggle) {
            tdToggle.style.pointerEvents = aplica ? 'auto' : 'none';
        }

        if (!aplica && tdToggle) {
            const panelId = tdToggle.getAttribute('data-bs-target');
            if (panelId) {
                const panel = ctx.querySelector(panelId);
                if (panel && panel.classList.contains('show')) {
                    const bsCol = bootstrap.Collapse.getInstance(panel);
                    if (bsCol) bsCol.hide();
                    else panel.classList.remove('show');
                }
            }
        }
    };

    window.handleTipoTramite = function(idOp, tipoModificado) {
        const ctx = modalCtx() || document;
        let baseId = idOp.replace('v3-', '');
        
        const chkSag   = ctx.querySelector(`#chkSag-${idOp}`);
        const chkSerna = ctx.querySelector(`#chkSerna-${idOp}`);

        if (tipoModificado === 'sag' && chkSag && chkSag.checked) {
            if (chkSerna) { chkSerna.checked = false; chkSerna.dispatchEvent(new Event('change')); }
        } else if (tipoModificado === 'sernapesca' && chkSerna && chkSerna.checked) {
            if (chkSag) { chkSag.checked = false; chkSag.dispatchEvent(new Event('change')); }
        }

        const sagActivo   = chkSag   && chkSag.checked;
        const sernaActivo = chkSerna && chkSerna.checked;

        if (idOp.includes('v3-')) {
            const btnFito = ctx.querySelector(`#sidebar-btn-fito-${baseId}`);
            if (btnFito) btnFito.style.display = sagActivo ? 'flex' : 'none';

            const btnSani = ctx.querySelector(`#sidebar-btn-sani-${baseId}`);
            if (btnSani) btnSani.style.display = sernaActivo ? 'flex' : 'none';

            const btnCap = ctx.querySelector(`#sidebar-btn-cap-${baseId}`);
            if (btnCap) btnCap.style.display = sernaActivo ? 'flex' : 'none';

            const panelActivoActual = ctx.querySelector(`.pro-pane-${baseId}[style*="display: block"]`);
            if (!sagActivo && panelActivoActual && panelActivoActual.id === `pane-fito-${baseId}`) openProTab(baseId, 'aduana');
            if (!sernaActivo && panelActivoActual && (panelActivoActual.id === `pane-sani-${baseId}` || panelActivoActual.id === `pane-cap-${baseId}`)) openProTab(baseId, 'aduana');

            togglePanelPro(`v3-fit-wrapper-${baseId}`, sagActivo);
            togglePanelPro(`v3-san-wrapper-${baseId}`, sernaActivo);
            togglePanelPro(`v3-cap-wrapper-${baseId}`, sernaActivo);
            return;
        }

        const getEl = (id) => ctx.querySelector(`#${id}`);
        const ocultarFilaYPanel = (rowId, panelId) => {
            const row = getEl(rowId);
            if (row) row.style.display = 'none';
            const panel = getEl(panelId);
            if (panel && panel.classList.contains('show')) {
                const bsCol = bootstrap.Collapse.getInstance(panel);
                if (bsCol) bsCol.hide();
                else panel.classList.remove('show');
            }
        };

        const ocultarTodosSubcertCaptura = () => {
            ['coa', 'dt', 'cod', 'cla', 'nep'].forEach(tipo => {
                const row = getEl(`row-${tipo}-${baseId}`);
                if (row) row.style.display = 'none';
                const panel = getEl(`panel-${tipo}-${baseId}`);
                if (panel && panel.classList.contains('show')) {
                    const bsCol = bootstrap.Collapse.getInstance(panel);
                    if (bsCol) bsCol.hide();
                    else panel.classList.remove('show');
                }
                const chkNombre = tipo.charAt(0).toUpperCase() + tipo.slice(1);
                const chk = getEl(`chk${chkNombre}-${baseId}`);
                if (chk) chk.checked = false;
            });
        };

        if (!sagActivo) { ocultarFilaYPanel(`row-fit-${baseId}`, `panel-fit-${baseId}`); }
        else { const rowFit = getEl(`row-fit-${baseId}`); if (rowFit) rowFit.style.display = 'table-row'; }

        if (!sernaActivo) {
            ocultarFilaYPanel(`row-san-${baseId}`, `panel-san-${baseId}`);
            ocultarFilaYPanel(`row-cap-${baseId}`, `panel-cap-${baseId}`);
            ocultarTodosSubcertCaptura();
        } else {
            const rowSan = getEl(`row-san-${baseId}`); if (rowSan) rowSan.style.display = 'table-row';
            const rowCap = getEl(`row-cap-${baseId}`); if (rowCap) rowCap.style.display = 'table-row';
        }
    };

    window.toggleSubcertsDependientes = function(idOp, isChecked) {
        const subCerts = ['chkCoa', 'chkDt', 'chkCod', 'chkCla', 'chkNep'];
        subCerts.forEach(cert => {
            const chk = document.getElementById(`${cert}-${idOp}`);
            if(chk) {
                if(!isChecked) {
                    chk.checked = false;
                    chk.dispatchEvent(new Event('change'));
                }
            }
        });
    };

    window.toggleSubCert = function(rowId, checkbox) {
        const ctx = modalCtx();
        if (!ctx) return;
        const row = ctx.querySelector(`#${rowId}`);
        if (row) row.style.display = checkbox.checked ? 'block' : 'none';
    };

    window.toggleInputsRow = function(chk) {
        const row = chk.closest('tr');
        const inputs = row.querySelectorAll('.row-inputs');
        const numInput = row.querySelector('input[type="text"]');
        
        if(chk.checked) {
            inputs.forEach(el => el.style.display = 'block');
            if(numInput && !numInput.value.trim()) {
                numInput.placeholder = "Pendiente...";
            }
        } else {
            inputs.forEach(el => el.style.display = 'none');
            if(numInput) {
                numInput.value = "";
                numInput.placeholder = "";
            }
        }
    };

    window.switchSlot = function(btn, opId, certType, slotNum) {
        let container = btn.closest('.slots-container');
        container.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        container.querySelectorAll('.slot-pane, .slot-paneDoc').forEach(p => p.classList.add('d-none'));
        let targetPane = container.querySelector(`.${certType}-${slotNum}`);
        if (targetPane) targetPane.classList.remove('d-none');
    };

    window.toggleSlots = function(idOp, certType) {
        const ctx = modalCtx();
        if (!ctx) return;
        const selectedRadio = ctx.querySelector(`input[name="${certType.charAt(0).toUpperCase() + certType.slice(1)}Tipo-${idOp}"]:checked`) || ctx.querySelector(`input[name="${certType.charAt(0).toUpperCase() + certType.slice(1)}Tipo-sub-${idOp}"]:checked`);
        if (!selectedRadio) return;

        const valor = selectedRadio.value;
        const containerSlots = ctx.querySelector(`#slots-${certType}-${idOp}`) || ctx.querySelector(`#slots-${certType}-sub-${idOp}`);
        const formContainer = ctx.querySelector(`#doc-global-form-${idOp}`) || ctx.querySelector(`#doc-global-form-sub-${idOp}`);
        const isEditMode = formContainer?.classList.contains('edit-mode');

        if (valor === 'aplica' || valor === 'rem' || valor === 'si') {
            if (containerSlots) {
                containerSlots.style.display = 'block';
                if (isEditMode) {
                    containerSlots.querySelectorAll('.inline-field').forEach(i => i.removeAttribute('readonly'));
                    containerSlots.querySelectorAll('.edit-only-file').forEach(i => i.removeAttribute('disabled'));
                }
            }
        } else {
            if (containerSlots) {
                containerSlots.style.display = 'none';
                containerSlots.querySelectorAll('input[type="text"]').forEach(i => { i.value = ""; i.setAttribute('readonly', true); });
                containerSlots.querySelectorAll('input[type="file"]').forEach(i => { i.value = ""; i.setAttribute('disabled', true); });
            }
        }
    };

    window.toggleSlotsOrigen = function(idOp, certType, valor) {
        const ctx = modalCtx();
        if (!ctx) return;
        const aplica  = ctx.querySelector(`#ori-aplica-${idOp}`);
        const eventos = ctx.querySelector(`#slots-ori-${idOp}`);
        if (aplica)  aplica.style.display  = (valor === 'si')  ? 'block' : 'none';
        if (eventos) eventos.style.display = (valor === 'rem') ? 'block' : 'none';
    };

    window.toggleValorTramite = function(checkbox, divId) {
        const ctx = modalCtx();
        const div = ctx ? ctx.querySelector(`#${divId}`) : document.getElementById(divId);
        if (!div) return;
        div.style.display = checkbox.checked ? 'block' : 'none';
        const input = div.querySelector('input');
        if (input) {
            if (checkbox.checked) input.removeAttribute('readonly');
