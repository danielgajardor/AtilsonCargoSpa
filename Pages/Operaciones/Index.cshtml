            chkLeg.closest('.d-flex').style.opacity = '0.4'; chkAcl.closest('.d-flex').style.opacity = '0.4'; chkCan.closest('.d-flex').style.opacity = '1';
            if (isEditMode) { chkLeg.disabled = true; chkAcl.disabled = true; chkCan.disabled = false; }
            const valAcl = ctx.querySelector(`#val-acl-${idBase}`);
            if (valAcl) { valAcl.style.display = 'none'; const valAclInput = valAcl.querySelector('input'); if (valAclInput) { valAclInput.value = ''; valAclInput.setAttribute('readonly', true); } }
        } else if (chkLeg.checked || chkAcl.checked) {
            chkCan.checked = false;
            chkCan.closest('.d-flex').style.opacity = '0.4'; chkLeg.closest('.d-flex').style.opacity = '1'; chkAcl.closest('.d-flex').style.opacity = '1';
            if (isEditMode) { chkCan.disabled = true; chkLeg.disabled = false; chkAcl.disabled = false; }
            const valCan = ctx.querySelector(`#val-can-${idBase}`);
            if (valCan) { valCan.style.display = 'none'; const valCanInput = valCan.querySelector('input'); if (valCanInput) { valCanInput.value = ''; valCanInput.setAttribute('readonly', true); } }
        } else {
            chkLeg.closest('.d-flex').style.opacity = '1'; chkAcl.closest('.d-flex').style.opacity = '1'; chkCan.closest('.d-flex').style.opacity = '1';
            if (isEditMode) { chkLeg.disabled = false; chkAcl.disabled = false; chkCan.disabled = false; }
