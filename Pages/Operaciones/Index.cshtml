                                                                    <button type="button" class="btn btn-sm btn-success fw-bold px-4" onclick="abrirGeneradorCorreos(@op.Id, 'completa')" style="font-size:11px;"><i class="bi bi-check2-all me-1"></i> Generar Asignación Completa</button>
