@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            $('select').select2({ language: { noResults: function() { return "No se encontraron resultados"; } } });
            $(document).on('keyup', '.select2-search__field', function() { $(this).val($(this).val().toUpperCase()); });
        });

        document.addEventListener('DOMContentLoaded', function() {
            const tabGroups = [
                { selector: '#mainTabs .nav-link', key: 'activeMainTab' },
                { selector: '.nav-tabs-custom .nav-link', key: 'activeSubTab' },
                { selector: '.sub-tabs .nav-link', key: 'activePillTab' }
            ];

            tabGroups.forEach(group => {
                let savedTarget = localStorage.getItem(group.key);
                if (savedTarget) {
                    let el = document.querySelector(`${group.selector}[data-bs-target="${savedTarget}"]`) || document.getElementById(savedTarget);
                    if (el) new bootstrap.Tab(el).show();
                }

                document.querySelectorAll(group.selector).forEach(tab => {
                    tab.addEventListener('click', e => {
                        let target = e.target.getAttribute('data-bs-target') || e.target.id;
                        localStorage.setItem(group.key, target);
                    });
                });
            });

            const deleteButtons = document.querySelectorAll('.btn-delete, form');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function(e) { e.stopPropagation(); });
            });

            window.abrirModalEditarTerrestre = function(id, valorActual) {
                document.getElementById('editTerrestreId').value = id;
                document.getElementById('editTerrestreValor').value = valorActual ? valorActual.replace(',', '.') : '';
                new bootstrap.Modal(document.getElementById('modalEditarTerrestre')).show();
            };

            window.abrirModalEditarMaritimo = function(id, valorActual) {
                document.getElementById('editMaritimoId').value = id;
                document.getElementById('editMaritimoValor').value = valorActual ? valorActual.replace(',', '.') : '';
                new bootstrap.Modal(document.getElementById('modalEditarMaritimo')).show();
            };

            window.abrirModalUniversal = function(id, valorActual, fechaActual, tipoEntidad) {
                document.getElementById('editUniversalId').value = id;
                document.getElementById('editUniversalValor').value = valorActual ? valorActual.replace(',', '.') : '';
                document.getElementById('editUniversalTipo').value = tipoEntidad;

                const fechaInput = document.getElementById('editUniversalFecha');
                const fechaLabel = document.getElementById('labelVigenciaUniversal');

                if (fechaActual && fechaActual.trim() !== '') {
                    fechaInput.value = fechaActual;
                    fechaInput.style.display = 'block';
                    fechaLabel.style.display = 'block';
                } else {
                    fechaInput.value = '';
                    fechaInput.style.display = 'none';
                    fechaLabel.style.display = 'none';
                }

                new bootstrap.Modal(document.getElementById('modalEditarUniversal')).show();
            };
        });
    </script>
}