                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div id="view-ranking-mar-dry" class="d-none">
                                <div class="table-container shadow-sm" style="border-top: 3px solid var(--atilson-dark); overflow-x: auto;">
                                    <table class="table table-erp m-0">
                                        <thead style="background-color: #f8fafc;">
                                            <tr>
                                                <th class="ps-4 text-center" style="width: 40px;">N°</th>
                                                <th>Naviera</th>
                                                <th>Ruta (POL ➔ POD)</th>
                                                <th>Equipo</th>
                                                <th class="text-end text-dark fw-bold">Flete Base (USD)</th>
                                                <th class="text-end">Late Arrival</th>
                                                <th class="text-end">Corr. B/L</th>
                                                <th class="text-center">Días Libres (Ori/Des)</th>
                                                <th class="text-center">Vigencia</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int rankMar = 1;
                                            }
                                            @foreach (var tm in Model.TarifasMaritimas.Where(t => !(t.Equipamiento ?? "").ToUpper().Contains("REEFER") && !(t.Equipamiento ?? "").ToUpper().Contains("RF")).OrderBy(t => t.TarifaUsd))
                                            {
                                                <tr style="border-bottom: 1px dashed #e2e8f0; @(rankMar == 1 ? "background-color: #f0fdf4;" : "")">
                                                    <td class="ps-4 fw-bold text-center @(rankMar == 1 ? "text-success" : "text-muted")" style="font-size: 12px;">@rankMar</td>
                                                    <td class="fw-bold text-uppercase" style="color: var(--atilson-dark); font-size: 11px;">
                                                        <i class="bi bi-ship me-1 @(rankMar == 1 ? "text-success" : "text-primary opacity-75")"></i> @(tm.IdNavieraNavigation?.NombreNaviera ?? "S/N")
                                                    </td>
                                                    <td class="fw-bold text-dark" style="font-size: 11px;">
                                                        @tm.Pol <i class="bi bi-arrow-right text-muted mx-1"></i> @tm.Pod
                                                    </td>
                                                    <td><span class="badge-dry me-1">@(tm.Equipamiento ?? "N/A")</span></td>
                                                    <td class="text-end font-monospace fw-bold text-danger" style="font-size: 13px;">$@(tm.TarifaUsd.ToString("N0"))</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoLateArrival != null ? $"${tm.CostoLateArrival}" : "-")</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoCorrectorBL != null ? $"${tm.CostoCorrectorBL}" : "-")</td>
                                                    <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresOrigen?.ToString() ?? "0") / @(tm.DiasLibresDestino?.ToString() ?? "0")</td>
                                                    <td class="text-center text-muted font-monospace" style="font-size: 11px;">@tm.FechaInicioVigencia.ToString("dd/MM/yyyy")</td>
                                                </tr>
                                                rankMar++;
                                            }
                                            @if (!Model.TarifasMaritimas.Where(t => !(t.Equipamiento ?? "").ToUpper().Contains("REEFER") && !(t.Equipamiento ?? "").ToUpper().Contains("RF")).Any())
                                            {
                                                <tr><td colspan="9" class="text-center text-muted py-4">No hay fletes marítimos DRY para mostrar en la comparativa. Ajusta los filtros.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- PROVEEDORES -> MARÍTIMO -> REEFER CONGELADO / FRESCO -->
