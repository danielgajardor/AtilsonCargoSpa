        </div>

        <div class="d-flex gap-2 align-items-center">
            <a href="/Comercial/AcuerdosOperativos" class="btn btn-dark btn-sm fw-bold px-4 shadow-sm" style="background-color: var(--atilson-dark); border: none; letter-spacing: 0.5px;">
                <i class="bi bi-briefcase-fill me-2" style="color: #38bdf8;"></i> VER BOOKINGS
