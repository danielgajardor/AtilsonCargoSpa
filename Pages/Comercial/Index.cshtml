@page
@model AtilsonCargoSpa.Pages.Comercial.IndexModel
@{
    ViewData["Title"] = "Command Center Comercial - Tarifario y Negociaciones";

    // VARIABLES GLOBALES PARA FILTROS DE CIUDADES (PUERTOS)
    var nombresPuertosFiltro = new[] { "VALPARAISO", "VALPARAÍSO", "SAN ANTONIO", "SAN VICENTE", "CORONEL" };
    var optionsPuertosFiltro = new SelectList(Model.ListaCiudades.Where(c => nombresPuertosFiltro.Any(p => c.Text.ToUpper().Contains(p))), "Value", "Text");

    var selectListaNombres = ViewData["ListaCiudadesNombre"] as SelectList;
    var optionsPuertosNombreFiltro = selectListaNombres != null ? new SelectList(selectListaNombres.Where(c => nombresPuertosFiltro.Any(p => c.Text.ToUpper().Contains(p))), "Value", "Text") : null;
}

<style>
    /* DISEÑO MINIMALISTA Y CORPORATIVO */
    :root {
        --dark-bg: #111827;
        --border-color: #e2e8f0;
        --text-main: #334155;
        --text-muted: #64748b;
        --atilson-dark: #2c1b4d;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--text-main);
    }

    /* Pestañas Principales (Nivel 1) */
    .nav-tabs-main {
        border-bottom: 2px solid var(--border-color);
        gap: 30px;
        margin-bottom: 25px;
    }

        .nav-tabs-main .nav-link {
            border: none;
            background: transparent;
            color: #64748b;
            font-weight: 900;
            font-size: 14px;
            text-transform: uppercase;
            padding: 10px 5px;
            margin-bottom: -2px;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
        }

            .nav-tabs-main .nav-link:hover {
                color: var(--atilson-dark);
            }

            .nav-tabs-main .nav-link.active {
                color: var(--atilson-dark);
                border-bottom: 3px solid var(--atilson-dark);
            }

    /* Pestañas Secundarias (Nivel 2) */
    .nav-tabs-custom {
        border-bottom: 1px solid var(--border-color);
        gap: 20px;
        margin-bottom: 20px;
    }

        .nav-tabs-custom .nav-link {
            border: none;
            background: transparent;
            color: #94a3b8;
            font-weight: 800;
            font-size: 12px;
            text-transform: uppercase;
            padding: 8px 5px;
            margin-bottom: -1px;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
        }

            .nav-tabs-custom .nav-link:hover {
                color: #0284c7;
            }

            .nav-tabs-custom .nav-link.active {
                color: #0284c7;
                border-bottom: 2px solid #0284c7;
            }

    /* Pestañas Terciarias (Nivel 3) */
    .sub-tabs {
        display: flex;
        border-bottom: 1px solid #e2e8f0;
        gap: 15px;
        margin-bottom: 0;
        padding: 0;
        background: transparent;
        border-radius: 0;
    }

        .sub-tabs .nav-link {
            font-size: 11px;
            font-weight: 800;
            color: #94a3b8;
            background: transparent;
            border-radius: 0;
            padding: 6px 5px;
            margin-bottom: -1px;
            border: none;
            border-bottom: 2px solid transparent;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.2s ease-in-out;
        }

            .sub-tabs .nav-link:hover {
                color: #475569;
            }

            .sub-tabs .nav-link.active {
                background: transparent;
                color: #475569;
                border-bottom: 2px solid #475569;
                box-shadow: none;
            }

    .table-container {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        overflow: hidden;
    }

    .table-erp {
        margin: 0;
        width: 100%;
        border-collapse: collapse;
    }

        .table-erp th {
            background: #f8fafc;
            color: #475569;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }

        .table-erp td {
            padding: 12px 14px;
            font-size: 11px;
            font-weight: 600;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            color: var(--text-main);
        }

        .table-erp tbody tr:hover {
            background-color: #f8fafc;
        }

    .badge-dry {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: 800;
        font-size: 10px;
    }

    .badge-reefer {
        background-color: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: 800;
        font-size: 10px;
    }

    .detail-row td {
        background-color: #fafafa;
        padding: 0 !important;
        border-bottom: 1px solid var(--border-color);
    }

    .inline-form-row {
        background-color: #f0f9ff;
        border-bottom: 2px solid #bae6fd;
    }

        .inline-form-row td {
            padding: 15px !important;
        }

    .form-control-xs, .form-select-xs {
        font-size: 11px;
        padding: 6px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-weight: 600;
    }

    .btn-delete {
        color: #ef4444;
        background: transparent;
        border: none;
        padding: 4px 8px;
        font-size: 12px;
    }

        .btn-delete:hover {
            background: #fef2f2;
            border-radius: 4px;
        }

    .modal-content {
        border: none;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .modal-header {
        border-bottom: 1px solid var(--border-color);
        padding: 20px 24px;
        background: white;
    }

    .modal-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--dark-bg);
        text-transform: uppercase;
    }

    .modal-body {
        padding: 24px;
        background: #fcfcfc;
    }

    .modal-footer {
        border-top: 1px solid var(--border-color);
        padding: 16px 24px;
        background: white;
    }

    .form-label {
        font-size: 10px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        font-size: 12px;
        border: 1px solid #cbd5e1;
        padding: 8px 12px;
        border-radius: 4px;
    }
</style>

<div class="container-fluid py-4" style="max-width: 1800px; padding: 0 30px;">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 style="font-size: 20px; font-weight: 900; color: var(--dark-bg); margin: 0; letter-spacing: -0.5px;">MÓDULO COMERCIAL</h1>
            <p class="text-muted small m-0 mt-1 fw-bold">Tarifario de Cierres de Negocio</p>
        </div>

        <!-- CONTENEDOR DE BOTONES SUPERIORES -->
        <div class="d-flex gap-2 align-items-center">

            <!-- NUEVO ACCESO DIRECTO A PRICING BOOKINGS -->
            <a href="/Comercial/AcuerdosOperativos" class="btn btn-dark btn-sm fw-bold px-4 shadow-sm" style="background-color: var(--atilson-dark); border: none; letter-spacing: 0.5px;">
                <i class="bi bi-briefcase-fill me-2" style="color: #38bdf8;"></i> VER BOOKINGS
            </a>

            <!-- DROPDOWN MAESTROS LOGÍSTICOS -->
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm fw-bold px-3 dropdown-toggle shadow-sm bg-white" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-gear-fill me-1"></i> MAESTROS LOGÍSTICOS
                </button>
                <ul class="dropdown-menu shadow-sm border-0 mt-2" style="font-size: 12px;">
                    <li><a class="dropdown-item py-2 fw-bold text-primary" asp-page="/App/Clientes/Index"><i class="bi bi-buildings-fill me-2"></i> Maestro de Clientes</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalAgencia"><i class="bi bi-building-add me-2"></i>Agencia Aduanas</a></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalProveedor"><i class="bi bi-truck me-2"></i>Proveedores (Transportes)</a></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalConductor"><i class="bi bi-person-vcard me-2"></i>Conductores</a></li>
                </ul>
            </div>

        </div>
    </div>

    <!-- PESTAÑAS PRINCIPALES (NIVEL 1) -->
    <ul class="nav nav-tabs-main" id="mainTabs" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-proveedores" data-bs-toggle="tab" data-bs-target="#panel-proveedores" type="button" role="tab"><i class="bi bi-truck me-2"></i> Proveedores</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="tab-clientes" data-bs-toggle="tab" data-bs-target="#panel-clientes" type="button" role="tab"><i class="bi bi-briefcase-fill me-2"></i> Clientes</button></li>
    </ul>

    <div class="tab-content" id="mainTabsContent">

        <!-- ============================================== -->
        <!-- PANEL 1: PROVEEDORES (COSTOS)                  -->
        <!-- ============================================== -->
        <div class="tab-pane fade show active" id="panel-proveedores" role="tabpanel">

            <!-- Pestañas de Servicios (Nivel 2) -->
            <ul class="nav nav-tabs-custom" id="servicios-prov" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#prov-maritimo" type="button">Marítimo</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-terrestre" type="button">Terrestre</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-documental" type="button">Documental</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-gate" type="button">Gate Out/In</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="tab-almacenamiento" data-bs-toggle="tab" data-bs-target="#panel-almacenamiento" type="button" role="tab">Almacenamiento</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-otros" type="button">Otros</button></li>
            </ul>

            <div class="tab-content">
                <!-- PROVEEDORES -> MARÍTIMO -->
                <div class="tab-pane fade show active" id="prov-maritimo">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm">
                        <!-- Sub-Pestañas Marítimo (Nivel 3) -->
                        <ul class="nav nav-pills sub-tabs" id="pills-prov-mar" role="tablist">
                            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#prov-mar-dry" type="button">Dry</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#prov-mar-rfcong" type="button">Reefer Congelado</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#prov-mar-rffres" type="button">Reefer Fresco</button></li>
                        </ul>
                        <div class="d-flex gap-2">
                            <form method="get" class="d-flex gap-2 mb-0">
                                <select asp-for="FiltroIdNaviera" asp-items="Model.ListaNavieras" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 150px; font-size: 11px;"><option value="">Naviera...</option></select>
                                <select asp-for="FiltroPol" asp-items="Model.ListaPols" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 100px; font-size: 11px;"><option value="">POL...</option></select>
                                <select asp-for="FiltroPod" asp-items="Model.ListaPods" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 100px; font-size: 11px;"><option value="">POD...</option></select>
                                <button type="submit" class="btn btn-dark btn-sm fw-bold px-3">FILTRAR</button>
                                @if (Model.FiltroIdNaviera.HasValue || !string.IsNullOrEmpty(Model.FiltroPol) || !string.IsNullOrEmpty(Model.FiltroPod))
                                {
                                    <a asp-page="./Index" class="btn btn-light btn-sm border text-danger"><i class="bi bi-x-lg"></i></a>
                                }
                            </form>
                        </div>
                    </div>

                    <div class="tab-content">
                        <!-- PROVEEDORES -> MARÍTIMO -> DRY -->
                        <div class="tab-pane fade show active" id="prov-mar-dry">
                            <div class="d-flex justify-content-end mb-3 gap-2 align-items-center">
                                <!-- BOTÓN MODO COMPARATIVA MARÍTIMO -->
                                <button type="button" id="btnToggleRankingMaritimo" class="btn btn-sm fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px; background-color: #f8fafc; border: 1px solid #cbd5e1; color: #475569; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s ease;"
                                        onclick="
                                    var viewGrouped = document.getElementById('view-grouped-mar-dry');
                                    var viewRanking = document.getElementById('view-ranking-mar-dry');
                                    var btnIcon = this.querySelector('i');
                                    var btnText = this.querySelector('span');

                                    if (viewGrouped.classList.contains('d-none')) {
                                    // Ir a Comparativa
                                    viewGrouped.classList.remove('d-none');
                                    viewRanking.classList.add('d-none');
                                    this.style.backgroundColor = '#f8fafc';
                                    this.style.borderColor = '#cbd5e1';
                                    this.style.color = '#475569';
                                    btnIcon.className = 'bi bi-sort-numeric-down text-primary me-2';
                                    btnText.innerText = 'Comparativa Tarifas';
                                    } else {
                                    // Volver a Agrupado
                                    viewGrouped.classList.add('d-none');
                                    viewRanking.classList.remove('d-none');
                                    this.style.backgroundColor = '#f0fdf4';
                                    this.style.borderColor = '#22c55e';
                                    this.style.color = '#16a34a';
                                    btnIcon.className = 'bi bi-check-circle-fill me-2';
                                    btnText.innerText = 'Comparativa Activa';
                                    }
                                    ">
                                    <i class="bi bi-sort-numeric-down text-primary me-2" style="font-size: 12px;"></i> <span>Comparativa Tarifas</span>
                                </button>

                                <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px;" onclick="document.getElementById('form-prov-mar-dry').classList.toggle('d-none');">
                                    <i class="bi bi-plus-lg me-1"></i> NUEVO FLETE MARÍTIMO
                                </button>
                            </div>

                            <!-- VISTA 1: AGRUPADO (ACORDEÓN NAVIERAS) -->
                            <div id="view-grouped-mar-dry">
                                <div class="table-container">
                                    <table class="table table-erp searchable-table">
                                        <thead>
                                            <tr>
                                                <th colspan="2" class="ps-4">Naviera</th>
                                                <th class="text-end pe-4">Desplegar Rutas</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Formulario Nueva Tarifa MARÍTIMA DRY -->
                                            <tr id="form-prov-mar-dry" class="inline-form-row d-none">
                                                <td colspan="3">
                                                    <form method="post" asp-page-handler="CrearCostoMaritimo">
                                                        <div class="row g-2 align-items-end">
                                                            <div class="col-md-2"><label class="detail-lbl">Naviera</label><select asp-for="NuevoCostoMaritimo.IdNaviera" asp-items="Model.ListaNavieras" class="form-select-xs w-100" required><option value="">- Proveedor -</option></select></div>
                                                            <div class="col-md-1"><label class="detail-lbl">Equipo</label><input asp-for="NuevoCostoMaritimo.Equipamiento" class="form-control-xs w-100 text-uppercase" placeholder="Ej: 40' HC" required></div>
                                                            <div class="col-md-3"><label class="detail-lbl">Ruta (POL - POD)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.Pol" class="form-control-xs w-50 text-uppercase" placeholder="POL" required><input asp-for="NuevoCostoMaritimo.Pod" class="form-control-xs w-50 text-uppercase" placeholder="POD" required></div></div>
                                                            <div class="col-md-2"><label class="detail-lbl">Flete Neto USD</label><div class="d-flex gap-1"><span class="input-group-text bg-light p-1 px-2 border" style="font-size:11px;">$</span><input asp-for="NuevoCostoMaritimo.TarifaUsd" type="number" step="0.01" class="form-control-xs w-75" required></div></div>
                                                            <div class="col-md-3"><label class="detail-lbl">Días Libres (Ori/Des)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.DiasLibresOrigen" type="text" class="form-control-xs w-50" placeholder="Ori"><input asp-for="NuevoCostoMaritimo.DiasLibresDestino" type="text" class="form-control-xs w-50" placeholder="Des"></div></div>
                                                            <div class="col-md-1 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> ADD</button></div>

                                                            <div class="col-md-2 mt-2"><label class="detail-lbl">Late Arrival (USD)</label><input asp-for="NuevoCostoMaritimo.CostoLateArrival" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                            <div class="col-md-2 mt-2"><label class="detail-lbl">Corrector B/L</label><input asp-for="NuevoCostoMaritimo.CostoCorrectorBL" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                            <div class="col-md-2 mt-2"><label class="detail-lbl">Expiración</label><input asp-for="NuevoCostoMaritimo.FechaInicioVigencia" type="date" class="form-control-xs w-100" required></div>
                                                        </div>
                                                    </form>
                                                </td>
                                            </tr>

                                            @foreach (var grupo in Model.TarifasMaritimas.GroupBy(t => t.IdNavieraNavigation))
                                            {
                                                var naviera = grupo.Key;
                                                var tarifasDry = grupo.Where(t => !(t.Equipamiento ?? "").ToUpper().Contains("REEFER") && !(t.Equipamiento ?? "").ToUpper().Contains("RF")).ToList();

                                                if (tarifasDry.Any())
                                                {
                                                    <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#nav-dry-@naviera?.Id" style="cursor: pointer;">
                                                        <td colspan="2" class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-ship me-2 text-primary"></i> @(naviera?.NombreNaviera ?? "S/N")</td>
                                                        <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                                    </tr>
                                                    <tr id="nav-dry-@naviera?.Id" class="collapse detail-row">
                                                        <td colspan="3" class="p-0">
                                                            <div class="p-3 bg-light border-bottom" style="overflow-x: auto;">
                                                                <table class="table table-sm table-borderless m-0">
                                                                    <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                                        <tr>
                                                                            <th>Ruta (POL ➔ POD)</th>
                                                                            <th>Equipo</th>
                                                                            <th class="text-end text-dark fw-bold">Flete Base (USD)</th>
                                                                            <th class="text-end">Late Arrival</th>
                                                                            <th class="text-end">Corr. B/L</th>
                                                                            <th class="text-center">Días Libres Origen</th>
                                                                            <th class="text-center">Días Libres Destino</th>
                                                                            <th class="text-center">Vigencia</th>
                                                                            <th></th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var tm in tarifasDry)
                                                                        {
                                                                            <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                                <td class="text-uppercase fw-bold text-dark" style="font-size: 11px;">@tm.Pol <i class="bi bi-arrow-right text-muted mx-1"></i> @tm.Pod</td>
                                                                                <td><span class="badge-dry">@(tm.Equipamiento ?? "N/A")</span></td>
                                                                                <td class="text-end font-monospace fw-bold text-danger" style="font-size: 12px;">$@(tm.TarifaUsd.ToString("N0"))</td>
                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoLateArrival != null ? $"${tm.CostoLateArrival}" : "-")</td>
                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoCorrectorBL != null ? $"${tm.CostoCorrectorBL}" : "-")</td>
                                                                                <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresOrigen?.ToString() ?? "0")</td>
                                                                                <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresDestino?.ToString() ?? "0")</td>
                                                                                <td class="text-center text-muted font-monospace" style="font-size: 11px;">@tm.FechaInicioVigencia.ToString("dd/MM/yyyy")</td>
                                                                                <td class="text-end pe-2">
                                                                                    <div class="d-flex justify-content-end gap-1">
                                                                                        <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalEditarMaritimo(@tm.Id, '@tm.TarifaUsd')" title="Actualizar Tarifa">
                                                                                            <i class="bi bi-pencil"></i>
                                                                                        </button>
                                                                                        <form method="post" asp-page-handler="EliminarCostoMaritimo" onsubmit="return confirm('¿Archivar esta tarifa de forma permanente?');">
                                                                                            <input type="hidden" name="idTarifa" value="@tm.Id" />
                                                                                            <button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button>
                                                                                        </form>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- VISTA 2: RANKING COMPETITIVO CORPORATIVO -->
                            <div id="view-ranking-mar-dry" class="d-none">
                                <div class="table-container shadow-sm" style="border-top: 3px solid var(--atilson-dark); overflow-x: auto;">
                                    <table class="table table-erp m-0">
                                        <thead style="background-color: #f8fafc;">
                                            <tr>
                                                <th class="ps-4 text-center" style="width: 40px;">N°</th>
                                                <th>Naviera</th>
                                                <th>Ruta (POL ➔ POD)</th>
                                                <th>Equipo</th>
                                                <th class="text-end text-dark fw-bold">Flete Base (USD)</th>
                                                <th class="text-end">Late Arrival</th>
                                                <th class="text-end">Corr. B/L</th>
                                                <th class="text-center">Días Libres (Ori/Des)</th>
                                                <th class="text-center">Vigencia</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int rankMar = 1;
                                            }
                                            @foreach (var tm in Model.TarifasMaritimas.Where(t => !(t.Equipamiento ?? "").ToUpper().Contains("REEFER") && !(t.Equipamiento ?? "").ToUpper().Contains("RF")).OrderBy(t => t.TarifaUsd))
                                            {
                                                <tr style="border-bottom: 1px dashed #e2e8f0; @(rankMar == 1 ? "background-color: #f0fdf4;" : "")">
                                                    <td class="ps-4 fw-bold text-center @(rankMar == 1 ? "text-success" : "text-muted")" style="font-size: 12px;">@rankMar</td>
                                                    <td class="fw-bold text-uppercase" style="color: var(--atilson-dark); font-size: 11px;">
                                                        <i class="bi bi-ship me-1 @(rankMar == 1 ? "text-success" : "text-primary opacity-75")"></i> @(tm.IdNavieraNavigation?.NombreNaviera ?? "S/N")
                                                    </td>
                                                    <td class="fw-bold text-dark" style="font-size: 11px;">
                                                        @tm.Pol <i class="bi bi-arrow-right text-muted mx-1"></i> @tm.Pod
                                                    </td>
                                                    <td><span class="badge-dry me-1">@(tm.Equipamiento ?? "N/A")</span></td>
                                                    <td class="text-end font-monospace fw-bold text-danger" style="font-size: 13px;">$@(tm.TarifaUsd.ToString("N0"))</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoLateArrival != null ? $"${tm.CostoLateArrival}" : "-")</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoCorrectorBL != null ? $"${tm.CostoCorrectorBL}" : "-")</td>
                                                    <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresOrigen?.ToString() ?? "0") / @(tm.DiasLibresDestino?.ToString() ?? "0")</td>
                                                    <td class="text-center text-muted font-monospace" style="font-size: 11px;">@tm.FechaInicioVigencia.ToString("dd/MM/yyyy")</td>
                                                </tr>
                                                rankMar++;
                                            }
                                            @if (!Model.TarifasMaritimas.Where(t => !(t.Equipamiento ?? "").ToUpper().Contains("REEFER") && !(t.Equipamiento ?? "").ToUpper().Contains("RF")).Any())
                                            {
                                                <tr><td colspan="9" class="text-center text-muted py-4">No hay fletes marítimos DRY para mostrar en la comparativa. Ajusta los filtros.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- PROVEEDORES -> MARÍTIMO -> REEFER CONGELADO / FRESCO -->
                        <div class="tab-pane fade" id="prov-mar-rfcong">
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="document.getElementById('form-prov-mar-rf').classList.toggle('d-none');">
                                    <i class="bi bi-plus-lg me-1"></i> NUEVO COSTO (REEFER)
                                </button>
                            </div>
                            <div class="table-container">
                                <table class="table table-erp searchable-table">
                                    <thead>
                                        <tr>
                                            <th colspan="2" class="ps-4">Naviera</th>
                                            <th class="text-end pe-4">Desplegar Tramos (REEFER)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Formulario Nueva Tarifa REEFER (Con Plug) -->
                                        <tr id="form-prov-mar-rf" class="inline-form-row d-none">
                                            <td colspan="3">
                                                <form method="post" asp-page-handler="CrearCostoMaritimo">
                                                    <div class="row g-2 align-items-end">
                                                        <div class="col-md-2"><label class="detail-lbl">Naviera</label><select asp-for="NuevoCostoMaritimo.IdNaviera" asp-items="Model.ListaNavieras" class="form-select-xs w-100" required><option value="">- Proveedor -</option></select></div>
                                                        <div class="col-md-1"><label class="detail-lbl">Equipo</label><input asp-for="NuevoCostoMaritimo.Equipamiento" class="form-control-xs w-100 text-uppercase" placeholder="Ej: 40' HC RF" required></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Ruta (POL - POD)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.Pol" class="form-control-xs w-50 text-uppercase" placeholder="POL"><input asp-for="NuevoCostoMaritimo.Pod" class="form-control-xs w-50 text-uppercase" placeholder="POD"></div></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Flete Neto USD</label><input asp-for="NuevoCostoMaritimo.TarifaUsd" type="number" step="0.01" class="form-control-xs w-100" required></div>
                                                        <div class="col-md-2"><label class="detail-lbl text-primary">Plug (Reefer)</label><input name="PlacPlug_Costo" type="number" step="0.01" class="form-control-xs w-100 border-primary" placeholder="USD"></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Expiración</label><input asp-for="NuevoCostoMaritimo.FechaInicioVigencia" type="date" class="form-control-xs w-100" required></div>
                                                        <div class="col-md-1 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> ADD</button></div>

                                                        <div class="col-md-2 mt-2"><label class="detail-lbl">Late Arrival (USD)</label><input asp-for="NuevoCostoMaritimo.CostoLateArrival" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                        <div class="col-md-2 mt-2"><label class="detail-lbl">Corrector B/L</label><input asp-for="NuevoCostoMaritimo.CostoCorrectorBL" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                        <div class="col-md-2 mt-2"><label class="detail-lbl">Días Libres (Ori/Des)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.DiasLibresOrigen" type="text" class="form-control-xs w-50" placeholder="Ori"><input asp-for="NuevoCostoMaritimo.DiasLibresDestino" type="text" class="form-control-xs w-50" placeholder="Des"></div></div>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>

                                        @foreach (var grupo in Model.TarifasMaritimas.GroupBy(t => t.IdNavieraNavigation))
                                        {
                                            var naviera = grupo.Key;
                                            var tarifasRf = grupo.Where(t => (t.Equipamiento ?? "").ToUpper().Contains("REEFER") || (t.Equipamiento ?? "").ToUpper().Contains("RF")).ToList();

                                            if (tarifasRf.Any())
                                            {
                                                <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#nav-rf-@naviera?.Id" style="cursor: pointer;">
                                                    <td colspan="2" class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-ship me-2 text-primary"></i> @(naviera?.NombreNaviera ?? "S/N")</td>
                                                    <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                                </tr>
                                                <tr id="nav-rf-@naviera?.Id" class="collapse detail-row">
                                                    <td colspan="3" class="p-0">
                                                        <div class="p-3 bg-light border-bottom">
                                                            <table class="table table-sm table-borderless m-0">
                                                                <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                                    <tr>
                                                                        <th>Ruta (POL ➔ POD)</th>
                                                                        <th>Equipo</th>
                                                                        <th class="text-end text-dark fw-bold">Flete Base (USD)</th>
                                                                        <th class="text-end">Plug</th>
                                                                        <th class="text-end">Late Arrival</th>
                                                                        <th class="text-end">Corr. B/L</th>
                                                                        <th class="text-center">Días Libres Origen</th>
                                                                        <th class="text-center">Días Libres Destino</th>
                                                                        <th class="text-center">Vigencia</th>
                                                                        <th></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var tm in tarifasRf)
                                                                    {
                                                                        var propPlacPlug = tm.GetType().GetProperty("PlacPlug")?.GetValue(tm, null);
                                                                        <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                            <td class="text-uppercase fw-bold text-dark" style="font-size: 11px;">@tm.Pol <i class="bi bi-arrow-right text-muted mx-1"></i> @tm.Pod</td>
                                                                            <td><span class="badge-reefer">@(tm.Equipamiento ?? "N/A")</span></td>
                                                                            <td class="text-end font-monospace fw-bold text-danger" style="font-size: 12px;">$@(tm.TarifaUsd.ToString("N0"))</td>
                                                                            <td class="text-end font-monospace text-primary fw-bold" style="font-size: 11px;">@(propPlacPlug != null ? $"${propPlacPlug}" : "No inc.")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoLateArrival != null ? $"${tm.CostoLateArrival}" : "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoCorrectorBL != null ? $"${tm.CostoCorrectorBL}" : "-")</td>
                                                                            <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresOrigen?.ToString() ?? "0")</td>
                                                                            <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresDestino?.ToString() ?? "0")</td>
                                                                            <td class="text-center text-muted font-monospace" style="font-size: 11px;">@tm.FechaInicioVigencia.ToString("dd/MM/yyyy")</td>
                                                                            <td class="text-end pe-2">
                                                                                <form method="post" asp-page-handler="EliminarCostoMaritimo">
                                                                                    <input type="hidden" name="idTarifa" value="@tm.Id" />
                                                                                    <button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button>
                                                                                </form>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="prov-mar-rffres">
                            <div class="p-4 text-center text-muted">Por poblar tablas.</div>
                        </div>
                    </div>
                </div>

                <!-- PROVEEDORES -> TERRESTRE -->
                <div class="tab-pane fade" id="prov-terrestre">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm">
                        <ul class="nav nav-pills sub-tabs" id="pills-prov-ter" role="tablist">
                            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#prov-ter-dry" type="button">Dry</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#prov-ter-rf" type="button">Reefer</button></li>
                        </ul>
                        <div class="d-flex gap-2">
                            <!-- FILTROS TERRESTRES (PROVEEDORES) -->
                            <form method="get" class="d-flex gap-2 mb-0">
                                <select asp-for="FiltroIdProveedor" asp-items="Model.ListaProveedores" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 120px; font-size: 11px;"><option value="">Transporte...</option></select>
                                <select asp-for="FiltroIdCiudadOrigen" asp-items="optionsPuertosFiltro" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 90px; font-size: 11px;"><option value="">Retiro...</option></select>
                                <select asp-for="FiltroIdCiudadPlanta" asp-items="Model.ListaCiudades" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 90px; font-size: 11px;"><option value="">Planta...</option></select>
                                <select asp-for="FiltroIdCiudadDestino" asp-items="optionsPuertosFiltro" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 90px; font-size: 11px;"><option value="">Puerto...</option></select>

                                <button type="submit" class="btn btn-dark btn-sm fw-bold px-3" onclick="localStorage.setItem('activeMainTab', '#tab-proveedores'); localStorage.setItem('activeSubTab', '#prov-terrestre');">FILTRAR</button>

                                @if (Model.FiltroIdProveedor.HasValue || Model.FiltroIdCiudadOrigen.HasValue || Model.FiltroIdCiudadPlanta.HasValue || Model.FiltroIdCiudadDestino.HasValue)
                                {
                                    <a asp-page="./Index" class="btn btn-light btn-sm border text-danger" onclick="localStorage.setItem('activeMainTab', '#tab-proveedores'); localStorage.setItem('activeSubTab', '#prov-terrestre');"><i class="bi bi-x-lg"></i></a>
                                }
                            </form>
                        </div>
                    </div>
                    <div class="tab-content">
                        <!-- PESTAÑA DRY TERRESTRE -->
                        <div class="tab-pane fade show active" id="prov-ter-dry">
                            <div class="d-flex justify-content-end mb-3 gap-2 align-items-center">
                                <!-- BOTÓN MODO COMPARATIVA CORPORATIVO -->
                                <button type="button" id="btnToggleRanking" class="btn btn-sm fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px; background-color: #f8fafc; border: 1px solid #cbd5e1; color: #475569; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s ease;"
                                        onclick="
                                    var viewGrouped = document.getElementById('view-grouped-dry');
                                    var viewRanking = document.getElementById('view-ranking-dry');
                                    var btnIcon = this.querySelector('i');
                                    var btnText = this.querySelector('span');

                                    if (viewGrouped.classList.contains('d-none')) {
                                    // 1. Si la tabla normal está oculta, significa que estamos en modo Comparativa.
                                    // ACCIÓN: Volvemos a la vista normal y el botón vuelve a su estado GRIS original.
                                    viewGrouped.classList.remove('d-none');
                                    viewRanking.classList.add('d-none');
                                    this.style.backgroundColor = '#f8fafc';
                                    this.style.borderColor = '#cbd5e1';
                                    this.style.color = '#475569';
                                    btnIcon.className = 'bi bi-sort-numeric-down text-primary me-2';
                                    btnText.innerText = 'Comparativa Tarifas';
                                    } else {
                                    // 2. Si la tabla normal se está viendo, significa que queremos ver la Comparativa.
                                    // ACCIÓN: Ocultamos la normal, mostramos el ranking y el botón cambia a estado VERDE activo.
                                    viewGrouped.classList.add('d-none');
                                    viewRanking.classList.remove('d-none');
                                    this.style.backgroundColor = '#f0fdf4';
                                    this.style.borderColor = '#22c55e';
                                    this.style.color = '#16a34a';
                                    btnIcon.className = 'bi bi-check-circle-fill me-2';
                                    btnText.innerText = 'Comparativa Activa';
                                    }
                                    ">
                                    <i class="bi bi-sort-numeric-down text-primary me-2" style="font-size: 12px;"></i> <span>Comparativa Tarifas</span>
                                </button>

                                <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px;" onclick="document.getElementById('form-prov-ter').classList.toggle('d-none');">
                                    <i class="bi bi-plus-lg me-1"></i> NUEVO TRAMO TRANSPORTE
                                </button>
                            </div>

                            <!-- VISTA 1: AGRUPADO (ACORDEÓN ACTUAL) -->
                            <div id="view-grouped-dry">
                                <div class="table-container">
                                    <table class="table table-erp searchable-table">
                                        <thead>
                                            <tr>
                                                <th colspan="2" class="ps-4">Empresa Transporte</th>
                                                <th class="text-end pe-4">Desplegar Tramos</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Formulario Nueva Tarifa TERRESTRE -->
                                            <tr id="form-prov-ter" class="inline-form-row d-none">
                                                <td colspan="3">
                                                    <form method="post" asp-page-handler="CrearCostoTerrestre">
                                                        <div class="row g-2 align-items-end">
                                                            <div class="col-md-2"><label class="form-label">Transportista</label><select asp-for="NuevoCostoTerrestre.IdProveedor" asp-items="Model.ListaProveedores" class="form-select-xs w-100" required><option value="">- Seleccione -</option></select></div>
                                                            <div class="col-md-4"><label class="form-label">Ruta (Retiro - Planta - Puerto)</label><div class="d-flex gap-1"><select asp-for="NuevoCostoTerrestre.IdCiudadOrigen" asp-items="Model.ListaCiudades" class="form-select-xs w-33" required><option value="">Retiro</option></select><select asp-for="NuevoCostoTerrestre.IdCiudadPlanta" asp-items="Model.ListaCiudades" class="form-select-xs w-33" required><option value="">Planta</option></select><select asp-for="NuevoCostoTerrestre.IdCiudadDestino" asp-items="Model.ListaCiudades" class="form-select-xs w-33" required><option value="">Puerto</option></select></div></div>
                                                            <div class="col-md-2"><label class="form-label">Costo Flete Base</label><div class="d-flex gap-1"><span class="input-group-text bg-light p-1 px-2 border" style="font-size:11px;">$</span><input asp-for="NuevoCostoTerrestre.ValorNeto" type="number" class="form-control-xs w-75" required></div></div>
                                                            <div class="col-md-2"><label class="form-label">Falso Flete Planta / Rutas</label><div class="d-flex gap-1"><input asp-for="NuevoCostoTerrestre.FalsoFletePlanta" type="number" class="form-control-xs w-33" placeholder="Planta"><input asp-for="NuevoCostoTerrestre.FalsoFleteRutaMayor50" type="number" class="form-control-xs w-33" placeholder="Ruta>50"><input asp-for="NuevoCostoTerrestre.FalsoFleteRutaMenor50" type="number" class="form-control-xs w-33" placeholder="Ruta<50"></div></div>
                                                            <div class="col-md-2"><label class="form-label">Porteo / Interplanta</label><div class="d-flex gap-1"><input asp-for="NuevoCostoTerrestre.ServicioPorteoPuerto" type="number" class="form-control-xs w-50" placeholder="Porteo"><input asp-for="NuevoCostoTerrestre.Interplanta" type="number" class="form-control-xs w-50" placeholder="Interplanta"></div></div>
                                                            <div class="col-md-1 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> ADD</button></div>

                                                            <div class="col-md-2 mt-2"><label class="form-label">Tipo Carga</label><select asp-for="NuevoCostoTerrestre.IdTipoCarga" class="form-select-xs w-100" required><option value="1">DRY</option><option value="2">REEFER</option></select></div>
                                                            <div class="col-md-2 mt-2"><label class="form-label">Falso Flete Depósito</label><input asp-for="NuevoCostoTerrestre.FalsoFleteDeposito" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                            <div class="col-md-2 mt-2"><label class="form-label">Expiración</label><input asp-for="NuevoCostoTerrestre.FechaFinVigencia" type="date" class="form-control-xs w-100" required></div>
                                                            <div class="col-md-2 mt-2"><label class="form-label">Hrs Libres (Plt/Pto)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoTerrestre.HorasLibresPlanta" type="number" class="form-control-xs w-50" placeholder="7"><input asp-for="NuevoCostoTerrestre.HorasLibresPuerto" type="number" class="form-control-xs w-50" placeholder="3"></div></div>
                                                        </div>
                                                    </form>
                                                </td>
                                            </tr>
                                            @foreach (var grupo in Model.TarifasTerrestres.GroupBy(t => t.IdProveedorNavigation))
                                            {
                                                var prov = grupo.Key;
                                                var tramosDry = grupo.Where(t => t.IdTipoCarga == 1).ToList();

                                                if (tramosDry.Any())
                                                {
                                                    <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#prov-dry-@prov?.Id" style="cursor: pointer;">
                                                        <td colspan="2" class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-truck me-2 text-success"></i> @(prov?.NombreProveedor ?? "SIN PROVEEDOR ASIGNADO")</td>
                                                        <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                                    </tr>
                                                    <tr id="prov-dry-@prov?.Id" class="collapse detail-row">
                                                        <td colspan="3" class="p-0">
                                                            <div class="p-3 bg-light border-bottom" style="overflow-x: auto;">
                                                                <table class="table table-sm table-borderless m-0" style="min-width: 1200px;">
                                                                    <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                                        <tr>
                                                                            <th>Tramo / Ruta</th>
                                                                            <th class="text-end text-dark fw-bold">Flete Base</th>
                                                                            <th class="text-end">F.F Planta</th>
                                                                            <th class="text-end">F.F &gt;50%</th>
                                                                            <th class="text-end">F.F &lt;50%</th>
                                                                            <th class="text-end">F.F Depósito</th>
                                                                            <th class="text-end">Porteo</th>
                                                                            <th class="text-end">Interplanta</th>
                                                                            <th class="text-center">Hrs Libres (Plt/Pto)</th>
                                                                            <th class="text-center">Sobreestadía</th>
                                                                            <th></th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var tt in tramosDry)
                                                                        {
                                                                            <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                                <td class="fw-bold text-dark" style="font-size: 11px;">
                                                                                    <span class="badge-dry me-1">DRY</span> @(tt.IdCiudadOrigenNavigation?.Nombre) ➔ @(tt.IdCiudadPlantaNavigation?.Nombre) ➔ @(tt.IdCiudadDestinoNavigation?.Nombre)
                                                                                </td>
                                                                                <td class="text-end font-monospace fw-bold text-dark" style="font-size: 12px;">$@(tt.ValorNeto?.ToString("N0") ?? "-")</td>
                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFletePlanta.HasValue ? tt.FalsoFletePlanta.Value.ToString("N0") : (tt.ValorNeto * 0.90m)?.ToString("N0") ?? "-")</td>
                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMayor50.HasValue ? tt.FalsoFleteRutaMayor50.Value.ToString("N0") : (tt.ValorNeto * 0.80m)?.ToString("N0") ?? "-")</td>
                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMenor50.HasValue ? tt.FalsoFleteRutaMenor50.Value.ToString("N0") : (tt.ValorNeto * 0.70m)?.ToString("N0") ?? "-")</td>
                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteDeposito?.ToString("N0") ?? "-")</td>
                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.ServicioPorteoPuerto?.ToString("N0") ?? "-")</td>
