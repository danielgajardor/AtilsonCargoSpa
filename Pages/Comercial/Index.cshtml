@page
@model AtilsonCargoSpa.Pages.Comercial.IndexModel
@{
    ViewData["Title"] = "Command Center Comercial - Tarifario y Negociaciones";
}

<style>
    /* DISEÑO MINIMALISTA Y CORPORATIVO */
    :root {
        --dark-bg: #111827;
        --border-color: #e2e8f0;
        --text-main: #334155;
        --text-muted: #64748b;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--text-main);
    }

    .kpi-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        display: flex;
        flex-direction: column;
    }

    .kpi-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .kpi-value {
        font-size: 24px;
        font-weight: 800;
        color: var(--dark-bg);
    }

    /* PESTAÑAS PRINCIPALES */
    .nav-tabs-custom {
        border-bottom: 2px solid var(--border-color);
        gap: 30px;
    }

        .nav-tabs-custom .nav-link {
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            padding: 10px 0;
            margin-bottom: -2px;
            border-bottom: 2px solid transparent;
            cursor: pointer;
        }

            .nav-tabs-custom .nav-link.active {
                color: var(--dark-bg);
                border-bottom: 2px solid var(--dark-bg);
            }

    /* PESTAÑAS SECUNDARIAS (SUB-TABS) */
    .sub-tabs {
        display: flex;
        gap: 20px;
        margin-bottom: 15px;
    }

        .sub-tabs .nav-link {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            background: #f1f5f9;
            border-radius: 4px;
            padding: 6px 16px;
            border: 1px solid transparent;
            text-transform: uppercase;
        }

            .sub-tabs .nav-link.active {
                background: white;
                color: var(--dark-bg);
                border-color: var(--border-color);
                box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            }

    /* TABLAS ESTILO ERP */
    .table-container {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        overflow: hidden;
    }

    .table-erp {
        margin: 0;
        width: 100%;
        border-collapse: collapse;
    }

        .table-erp th {
            background: #f8fafc;
            color: #475569;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }

        .table-erp td {
            padding: 12px 16px;
            font-size: 12px;
            font-weight: 500;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .table-erp tbody tr:hover {
            background-color: #f8fafc;
        }

    /* FILA COLAPSABLE (ACORDEÓN) */
    .detail-row td {
        background-color: #fafafa;
        padding: 0 !important;
        border-bottom: 1px solid var(--border-color);
    }

    .detail-content {
        padding: 20px;
        display: flex;
        gap: 40px;
    }

    .detail-block {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .detail-lbl {
        font-size: 9px;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 800;
    }

    .detail-val {
        font-size: 12px;
        font-weight: 700;
        color: var(--dark-bg);
    }

    /* FILA DE CREACIÓN RÁPIDA (INLINE FORM) */
    .inline-form-row {
        background-color: #f0f9ff;
        border-bottom: 2px solid #bae6fd;
    }

        .inline-form-row td {
            padding: 15px !important;
        }

    .form-control-xs, .form-select-xs {
        font-size: 11px;
        padding: 6px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-weight: 600;
    }

    /* MODALES MINIMALISTAS */
    .modal-content {
        border: none;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .modal-header {
        border-bottom: 1px solid var(--border-color);
        padding: 20px 24px;
        background: white;
    }

    .modal-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--dark-bg);
        text-transform: uppercase;
    }

    .modal-body {
        padding: 24px;
        background: #fcfcfc;
    }

    .modal-footer {
        border-top: 1px solid var(--border-color);
        padding: 16px 24px;
        background: white;
    }

    .form-label {
        font-size: 10px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        font-size: 12px;
        border: 1px solid #cbd5e1;
        padding: 8px 12px;
        border-radius: 4px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--dark-bg);
            box-shadow: none;
        }

    .section-title {
        font-size: 11px;
        font-weight: 800;
        color: var(--dark-bg);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 6px;
        margin-bottom: 16px;
        margin-top: 8px;
    }

    .btn-delete {
        color: #ef4444;
        background: transparent;
        border: none;
        padding: 4px 8px;
    }

        .btn-delete:hover {
            background: #fef2f2;
            border-radius: 4px;
        }
</style>

<div class="container-fluid py-4" style="max-width: 1700px; padding: 0 30px;">

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 style="font-size: 20px; font-weight: 800; color: var(--dark-bg); margin: 0;">MÓDULO COMERCIAL</h1>
            <p class="text-muted small m-0 mt-1">Tarifario de Cierres de Negocio (Clientes y Proveedores)</p>
        </div>
        <div class="d-flex gap-2">
            <div class="dropdown me-2">
                <button class="btn btn-outline-secondary btn-sm fw-bold px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-gear-fill me-1"></i> MAESTROS
                </button>
                <ul class="dropdown-menu shadow-sm border-0 mt-2" style="font-size: 12px;">
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalProveedor">Alta Proveedores</a></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalConductor">Alta Conductores</a></li>
                </ul>
            </div>

            <div class="dropdown">
                <button class="btn btn-dark btn-sm fw-bold px-4 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-plus-lg me-1"></i> NUEVO ACUERDO
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="font-size: 12px;">
                    <li><h6 class="dropdown-header text-muted fw-bold" style="font-size: 10px;">VENTAS (CLIENTES)</h6></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalMaritimoVenta">Tarifa Marítima</a></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalTerrestreVenta">Tarifa Terrestre</a></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalDocumentalVenta">Tarifa Documental</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header text-muted fw-bold" style="font-size: 10px;">COSTOS (PROVEEDORES/AGENCIAS)</h6></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalMaritimoCosto">Tarifa Naviera</a></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalTerrestreCosto">Tarifa Transportista</a></li>
                    <li><a class="dropdown-item py-2 fw-bold" href="#" data-bs-toggle="modal" data-bs-target="#modalDocumentalCosto">Tarifa Agencia Aduana</a></li>
                </ul>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs-custom mb-4" id="serviceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-maritimo" data-bs-toggle="tab" data-bs-target="#panel-maritimo" type="button" role="tab">Marítimo</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-terrestre" data-bs-toggle="tab" data-bs-target="#panel-terrestre" type="button" role="tab">Terrestre</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-documental" data-bs-toggle="tab" data-bs-target="#panel-documental" type="button" role="tab">Documental</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-otros" data-bs-toggle="tab" data-bs-target="#panel-otros" type="button" role="tab">Otros (Recintos)</button>
        </li>
    </ul>

    <div class="tab-content" id="serviceTabsContent">

        <div class="tab-pane fade show active" id="panel-maritimo" role="tabpanel">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <ul class="nav nav-pills sub-tabs" id="pills-maritimo" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#maritimo-ventas" type="button" role="tab">Ventas (Clientes)</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#maritimo-costos" type="button" role="tab">Costos (Proveedores)</button>
                    </li>
                </ul>
                <div class="input-group input-group-sm w-25">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 tab-search" placeholder="Buscar por cliente, proveedor, ruta...">
                </div>
            </div>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="maritimo-ventas" role="tabpanel">
                    <form method="post" asp-page-handler="CrearVentaMaritima">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="document.getElementById('form-mar-ventas').classList.toggle('d-none');">
                                <i class="bi bi-plus-lg me-1"></i> NUEVA TARIFA VENTA
                            </button>
                        </div>
                        <div class="table-container">
                            <table class="table table-erp searchable-table">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Cliente</th>
                                        <th>Ruta (POL ➔ POD)</th>
                                        <th class="text-end">Tarifa Venta</th>
                                        <th class="text-center">Vigencia</th>
                                        <th>Condición / Concepto</th>
                                        <th>Comentarios</th>
                                        <th class="text-end pe-4">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr id="form-mar-ventas" class="inline-form-row d-none">
                                        <td colspan="7">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-2"><label class="detail-lbl">Cliente</label><select asp-for="NuevaVentaMaritima.IdCliente" asp-items="Model.ListaClientes" class="form-select-xs w-100" required><option value="">- Mandante -</option></select></div>
                                                <div class="col-md-2"><label class="detail-lbl">Ruta (POL - POD)</label><div class="d-flex gap-1"><input asp-for="NuevaVentaMaritima.Pol" class="form-control-xs w-50 text-uppercase" placeholder="POL" required><input asp-for="NuevaVentaMaritima.Pod" class="form-control-xs w-50 text-uppercase" placeholder="POD" required></div></div>
                                                <div class="col-md-2"><label class="detail-lbl">Condición</label><input asp-for="NuevaVentaMaritima.Concepto" class="form-control-xs w-100 text-uppercase" placeholder="Ej: Flete Marítimo Integral" required></div>
                                                <div class="col-md-2"><label class="detail-lbl">Tarifa ($)</label><div class="d-flex gap-1"><select asp-for="NuevaVentaMaritima.Moneda" class="form-select-xs"><option>USD</option><option>CLP</option></select><input asp-for="NuevaVentaMaritima.PrecioPactado" type="number" step="0.01" class="form-control-xs w-75" required></div></div>
                                                <div class="col-md-2"><label class="detail-lbl">Expiración</label><input asp-for="NuevaVentaMaritima.FechaFinVigencia" type="date" class="form-control-xs w-100" required></div>
                                                <div class="col-md-2 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> GUARDAR</button></div>

                                                <div class="col-md-2 mt-2"><label class="detail-lbl">Naviera</label><select asp-for="NuevaVentaMaritima.IdNaviera" asp-items="Model.ListaNavieras" class="form-select-xs w-100"><option value="">- N/A -</option></select></div>
                                                <div class="col-md-1 mt-2"><label class="detail-lbl">Equipo</label><input asp-for="NuevaVentaMaritima.TipoContenedor" class="form-control-xs w-100 text-uppercase"></div>
                                                <div class="col-md-2 mt-2"><label class="detail-lbl">Días Lib. (Or/Des)</label><div class="d-flex gap-1"><input asp-for="NuevaVentaMaritima.DiasLibresOrigen" type="text" class="form-control-xs w-50"><input asp-for="NuevaVentaMaritima.DiasLibresDestino" type="text" class="form-control-xs w-50"></div></div>
                                                <div class="col-md-1 mt-2"><label class="detail-lbl">Valor B/L</label><input asp-for="NuevaVentaMaritima.ValorBL" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                <div class="col-md-2 mt-2"><label class="detail-lbl">Profit Est.</label><input asp-for="NuevaVentaMaritima.ProfitHandling" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                <div class="col-md-4 mt-2"><label class="detail-lbl">Comentarios</label><input asp-for="NuevaVentaMaritima.Comentarios" class="form-control-xs w-100 text-uppercase" placeholder="Opcional"></div>
                                            </div>
                                        </td>
                                    </tr>

                                    @foreach (var tc in Model.TarifasClientes.Where(t => t.GrupoCobro == "Marítimo"))
                                    {
                                        <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#m-ven-@tc.Id">
                                            <td class="ps-4 fw-bold" style="color: #0284c7;">@(tc.IdClienteNavigation?.RazonSocial ?? "N/A")</td>
                                            <td><span class="text-uppercase">@tc.Pol <i class="bi bi-arrow-right text-muted mx-1"></i> @tc.Pod</span></td>
                                            <td class="text-end fw-bold">@tc.Moneda $@tc.PrecioPactado.ToString("N2")</td>
                                            <td class="text-center">@tc.FechaFinVigencia.ToString("dd/MM/yyyy")</td>
                                            <td><span class="text-muted">@tc.Concepto</span></td>
                                            <td><span class="text-muted small">@(tc.Comentarios ?? "-")</span></td>
                                            <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                        </tr>
                                        <tr id="m-ven-@tc.Id" class="collapse detail-row">
                                            <td colspan="7">
                                                <div class="detail-content">
                                                    <div class="detail-block"><span class="detail-lbl">Naviera</span><span class="detail-val text-uppercase">@(tc.IdNavieraNavigation?.NombreNaviera ?? "-")</span></div>
                                                    <div class="detail-block"><span class="detail-lbl">Contenedor</span><span class="detail-val text-uppercase">@(tc.TipoContenedor ?? "-")</span></div>
                                                    <div class="detail-block"><span class="detail-lbl">Días Libres (Origen / Destino)</span><span class="detail-val">@(tc.DiasLibresOrigen?.ToString() ?? "-") / @(tc.DiasLibresDestino?.ToString() ?? "-")</span></div>
                                                    <div class="detail-block"><span class="detail-lbl">Valor B/L</span><span class="detail-val">@(tc.ValorBL != null ? $"${tc.ValorBL}" : "-")</span></div>
                                                    <div class="detail-block"><span class="detail-lbl">Profit Estimado</span><span class="detail-val text-success">@(tc.ProfitHandling != null ? $"${tc.ProfitHandling}" : "-")</span></div>
                                                    <div class="ms-auto align-self-center">
                                                        <form method="post" asp-page-handler="EliminarTarifaCliente" onsubmit="return confirm('¿Archivar?');">
                                                            <input type="hidden" name="idTarifa" value="@tc.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold"><i class="bi bi-trash"></i> ARCHIVAR</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                </div>

                <div class="tab-pane fade" id="maritimo-costos" role="tabpanel">
                    <form method="post" asp-page-handler="CrearCostoMaritimo">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="document.getElementById('form-mar-costos').classList.toggle('d-none');">
                                <i class="bi bi-plus-lg me-1"></i> NUEVA TARIFA COSTO
                            </button>
                        </div>
                        <div class="table-container">
                            <table class="table table-erp searchable-table">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Naviera (Proveedor)</th>
                                        <th>Ruta (POL ➔ POD)</th>
                                        <th class="text-end">Flete Neto (USD)</th>
                                        <th class="text-center">Vigencia</th>
                                        <th>Condición / Concepto</th>
                                        <th>Comentarios</th>
                                        <th class="text-end pe-4">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr id="form-mar-costos" class="inline-form-row d-none">
                                        <td colspan="7">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-2"><label class="detail-lbl">Naviera</label><select asp-for="NuevoCostoMaritimo.IdNaviera" asp-items="Model.ListaNavieras" class="form-select-xs w-100" required><option value="">- Proveedor -</option></select></div>
                                                <div class="col-md-2"><label class="detail-lbl">Ruta (POL - POD)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.Pol" class="form-control-xs w-50 text-uppercase" placeholder="POL" required><input asp-for="NuevoCostoMaritimo.Pod" class="form-control-xs w-50 text-uppercase" placeholder="POD" required></div></div>
                                                <div class="col-md-2"><label class="detail-lbl">Condición/Concepto</label><input class="form-control-xs w-100 text-uppercase" value="Flete Base Marítimo" disabled></div>
                                                <div class="col-md-2"><label class="detail-lbl">Flete Neto USD</label><div class="d-flex gap-1"><span class="input-group-text bg-light p-1 px-2 border" style="font-size:11px;">$</span><input asp-for="NuevoCostoMaritimo.TarifaUsd" type="number" step="0.01" class="form-control-xs w-75" required></div></div>
                                                <div class="col-md-2"><label class="detail-lbl">Expiración</label><input asp-for="NuevoCostoMaritimo.FechaInicioVigencia" type="date" class="form-control-xs w-100" required></div>
                                                <div class="col-md-2 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> GUARDAR</button></div>

                                                <div class="col-md-1 mt-2"><label class="detail-lbl">Equipo</label><input asp-for="NuevoCostoMaritimo.Equipamiento" class="form-control-xs w-100 text-uppercase"></div>
                                                <div class="col-md-2 mt-2"><label class="detail-lbl">Días Lib. (Or/Des)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.DiasLibresOrigen" type="text" class="form-control-xs w-50"><input asp-for="NuevoCostoMaritimo.DiasLibresDestino" type="text" class="form-control-xs w-50"></div></div>
                                                <div class="col-md-1 mt-2"><label class="detail-lbl">Multa LAR</label><input asp-for="NuevoCostoMaritimo.CostoLateArrival" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                <div class="col-md-2 mt-2"><label class="detail-lbl">Corrector B/L</label><input asp-for="NuevoCostoMaritimo.CostoCorrectorBL" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                <div class="col-md-2 mt-2"><label class="detail-lbl">Demurrage / Día</label><input asp-for="NuevoCostoMaritimo.DemurrageDiario" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                <div class="col-md-4 mt-2"><label class="detail-lbl">Comentarios</label><input asp-for="NuevoCostoMaritimo.Comentarios" class="form-control-xs w-100 text-uppercase" placeholder="Opcional"></div>
                                            </div>
                                        </td>
                                    </tr>

                                    @foreach (var tm in Model.TarifasMaritimas)
                                    {
                                        <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#m-cos-@tm.Id">
                                            <td class="ps-4 fw-bold text-uppercase">@(tm.IdNavieraNavigation?.NombreNaviera ?? "N/A")</td>
                                            <td><span class="text-uppercase">@tm.Pol <i class="bi bi-arrow-right text-muted mx-1"></i> @tm.Pod</span></td>
                                            <td class="text-end fw-bold text-danger">USD $@tm.TarifaUsd.ToString("N2")</td>
                                            <td class="text-center">@tm.FechaInicioVigencia.ToString("dd/MM/yyyy")</td>
                                            <td><span class="text-muted">Flete Marítimo Neto</span></td>
                                            <td><span class="text-muted small">@(tm.Comentarios ?? "-")</span></td>
                                            <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                        </tr>
                                        <tr id="m-cos-@tm.Id" class="collapse detail-row">
                                            <td colspan="7">
                                                <div class="detail-content">
                                                    <div class="detail-block"><span class="detail-lbl">Contenedor</span><span class="detail-val text-uppercase">@(tm.Equipamiento ?? "-")</span></div>
                                                    <div class="detail-block"><span class="detail-lbl">Días Libres (Origen / Destino)</span><span class="detail-val">@(tm.DiasLibresOrigen?.ToString() ?? "-") / @(tm.DiasLibresDestino?.ToString() ?? "-")</span></div>
