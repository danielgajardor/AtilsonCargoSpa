                                <select asp-for="FiltroVigencia" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 130px; font-size: 11px;">
                                    <option value="">Todas Vigencias</option>
                                    <option value="VENCIDOS">Expirados</option>
                                    <option value="30DIAS">Vencen &lt; 30 días</option>
                                    <option value="90DIAS">Vencen &lt; 90 días</option>
                                </select>
                                <select asp-for="FiltroPol" asp-items="Model.ListaPols" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 100px; font-size: 11px;"><option value="">POL...</option></select>
                                <select asp-for="FiltroPod" asp-items="Model.ListaPods" class="form-select form-select-sm bg-light border-0 fw-bold" style="width: 100px; font-size: 11px;"><option value="">POD...</option></select>
                                <button type="submit" class="btn btn-dark btn-sm fw-bold px-3">FILTRAR</button>
                                @if (Model.FiltroIdCliente.HasValue || !string.IsNullOrEmpty(Model.FiltroVigencia) || !string.IsNullOrEmpty(Model.FiltroPol) || !string.IsNullOrEmpty(Model.FiltroPod))
