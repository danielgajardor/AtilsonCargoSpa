                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cli-terrestre" type="button">Terrestre</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cli-documental" type="button">Documental</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cli-gate" type="button">Gate Out/In</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="tab-cli-almacenamiento" data-bs-toggle="tab" data-bs-target="#cli-almacenamiento" type="button" role="tab">Almacenamiento</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cli-otros" type="button">Otros (Recintos)</button></li>
            </ul>

            <div class="tab-content">
                <!-- CLIENTES -> MARÍTIMO -->
                <div class="tab-pane fade show active" id="cli-maritimo">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm">
                        <ul class="nav nav-pills sub-tabs" id="pills-cli-mar" role="tablist">
                            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#cli-mar-dry" type="button">Dry</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#cli-mar-rfcong" type="button">Reefer Congelado</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#cli-mar-rffres" type="button">Reefer Fresco</button></li>
                        </ul>
                        <div class="d-flex gap-2">
                            <form method="get" class="d-flex gap-2 mb-0">
                                <select asp-for="FiltroIdCliente" asp-items="Model.ListaClientes" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 140px; font-size: 11px;"><option value="">Filtro Mandante...</option></select>
                                <select asp-for="FiltroVigencia" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 130px; font-size: 11px;">
                                    <option value="">Todas Vigencias</option>
                                    <option value="VENCIDOS">Expirados</option>
                                    <option value="30DIAS">Vencen &lt; 30 días</option>
                                    <option value="90DIAS">Vencen &lt; 90 días</option>
                                </select>
                                <select asp-for="FiltroPol" asp-items="Model.ListaPols" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 100px; font-size: 11px;"><option value="">POL...</option></select>
                                <select asp-for="FiltroPod" asp-items="Model.ListaPods" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 100px; font-size: 11px;"><option value="">POD...</option></select>
                                <button type="submit" class="btn btn-dark btn-sm fw-bold px-3">FILTRAR</button>
                                @if (Model.FiltroIdCliente.HasValue || !string.IsNullOrEmpty(Model.FiltroVigencia) || !string.IsNullOrEmpty(Model.FiltroPol) || !string.IsNullOrEmpty(Model.FiltroPod))
                                {
                                    <a asp-page="./Index" class="btn btn-light btn-sm border text-danger"><i class="bi bi-x-lg"></i></a>
                                }
                            </form>
                        </div>
                    </div>

                    <div class="tab-content">
                        <!-- CLIENTES -> MARÍTIMO -> DRY -->
                        <div class="tab-pane fade show active" id="cli-mar-dry">
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="document.getElementById('form-cli-mar-dry').classList.toggle('d-none');">
                                    <i class="bi bi-plus-lg me-1"></i> NUEVA VENTA (DRY)
                                </button>
                            </div>
                            <div class="table-container">
                                <table class="table table-erp searchable-table">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">Cliente</th>
                                            <th>Ruta (POL ➔ POD)</th>
                                            <th class="text-end">Tarifa Venta</th>
                                            <th class="text-center">Vigencia</th>
                                            <th>Condición / Concepto</th>
                                            <th>Comentarios</th>
                                            <th class="text-end pe-4">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr id="form-cli-mar-dry" class="inline-form-row d-none">
                                            <td colspan="7">
                                                <form method="post" asp-page-handler="CrearVentaMaritima">
                                                    <div class="row g-2 align-items-end">
                                                        <div class="col-md-2"><label class="detail-lbl">Cliente</label><select asp-for="NuevaVentaMaritima.IdCliente" asp-items="Model.ListaClientes" class="form-select-xs w-100" required><option value="">- Mandante -</option></select></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Ruta (POL - POD)</label><div class="d-flex gap-1"><input asp-for="NuevaVentaMaritima.Pol" class="form-control-xs w-50 text-uppercase" placeholder="POL" required><input asp-for="NuevaVentaMaritima.Pod" class="form-control-xs w-50 text-uppercase" placeholder="POD" required></div></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Condición / Concepto</label><input asp-for="NuevaVentaMaritima.Concepto" class="form-control-xs w-100 text-uppercase" placeholder="Ej: Flete Integral" required></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Tarifa ($)</label><div class="d-flex gap-1"><select asp-for="NuevaVentaMaritima.Moneda" class="form-select-xs"><option>USD</option><option>CLP</option></select><input asp-for="NuevaVentaMaritima.PrecioPactado" type="number" step="0.01" class="form-control-xs w-75" required></div></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Expiración</label><input asp-for="NuevaVentaMaritima.FechaFinVigencia" type="date" class="form-control-xs w-100" required></div>
