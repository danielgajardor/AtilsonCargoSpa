    }

        .sub-tabs .nav-link {
            font-size: 11px;
            font-weight: 800;
            color: #64748b;
            background-color: transparent !important;
            border-radius: 5px;
            padding: 7px 16px;
            margin-bottom: 0;
            border: none;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.15s ease-in-out;
        }

            .sub-tabs .nav-link:hover {
                color: var(--atilson-dark);
                background-color: rgba(255,255,255,0.7) !important;
            }

            .sub-tabs .nav-link.active,
            .sub-tabs .nav-link.active:hover {
                color: #fff !important;
                background-color: var(--atilson-dark) !important;
                box-shadow: 0 1px 4px rgba(44,27,77,0.35);
            }

    .table-container {
        background: white;
        border: 1px solid #e5e9f0;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15,23,42,0.04);
        overflow-x: auto;
    }

    .table-erp {
        margin: 0;
        width: 100%;
        border-collapse: collapse;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

        .table-erp th {
            background: #ffffff;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            padding: 10px 16px;
            border-bottom: 2px solid #cbd5e1;
