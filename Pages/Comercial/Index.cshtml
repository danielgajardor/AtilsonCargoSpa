                                                        <div class="col-md-2 mt-2"><label class="detail-lbl">Naviera Asociada</label><select asp-for="NuevaVentaMaritima.IdNaviera" asp-items="Model.ListaNavieras" class="form-select-xs w-100"><option value="">- N/A -</option></select></div>
                                                        <div class="col-md-1 mt-2"><label class="detail-lbl">Equipo Aplica</label><input asp-for="NuevaVentaMaritima.TipoContenedor" class="form-control-xs w-100 text-uppercase"></div>
