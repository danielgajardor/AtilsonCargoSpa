                                                        <div class="col-md-1"><label class="detail-lbl">Equipo</label><input asp-for="NuevoCostoMaritimo.Equipamiento" class="form-control-xs w-100 text-uppercase" placeholder="Ej: 40' HC RF" required></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Ruta (POL - POD)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.Pol" class="form-control-xs w-50 text-uppercase" placeholder="POL"><input asp-for="NuevoCostoMaritimo.Pod" class="form-control-xs w-50 text-uppercase" placeholder="POD"></div></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Flete Neto USD</label><input asp-for="NuevoCostoMaritimo.TarifaUsd" type="number" step="0.01" class="form-control-xs w-100" required></div>
                                                        <div class="col-md-2"><label class="detail-lbl text-primary">Plug (Reefer)</label><input name="PlacPlug_Costo" type="number" step="0.01" class="form-control-xs w-100 border-primary" placeholder="USD"></div>
                                                        <div class="col-md-2"><label class="detail-lbl">Expiración</label><input asp-for="NuevoCostoMaritimo.FechaInicioVigencia" type="date" class="form-control-xs w-100" required></div>
                                                        <div class="col-md-1 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> ADD</button></div>

                                                        <div class="col-md-2 mt-2"><label class="detail-lbl">Late Arrival (USD)</label><input asp-for="NuevoCostoMaritimo.CostoLateArrival" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                        <div class="col-md-2 mt-2"><label class="detail-lbl">Corrector B/L</label><input asp-for="NuevoCostoMaritimo.CostoCorrectorBL" type="number" step="0.01" class="form-control-xs w-100"></div>
