    }

    .form-label {
        font-size: 10px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        font-size: 12px;
        border: 1px solid #cbd5e1;
        padding: 8px 12px;
        border-radius: 4px;
    }
</style>

<div class="container-fluid py-4" style="width: 100%; padding: 0 2%;">
