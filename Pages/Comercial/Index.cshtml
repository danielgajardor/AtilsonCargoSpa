@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Inicializar Tabs de Bootstrap (Servicios Múltiples)
            var triggerTabList = [].slice.call(document.querySelectorAll('.nav-link'));
            triggerTabList.forEach(function (triggerEl) {
                var tabTrigger = new bootstrap.Tab(triggerEl);
                triggerEl.addEventListener('click', function (event) {
                    event.preventDefault();
                    tabTrigger.show();
                });
            });

            // Prevenir que el acordeón se cierre cuando hacemos clic en el botón de eliminar
            const deleteButtons = document.querySelectorAll('.detail-row form button');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            });

            // Filtro de Búsqueda Rápida Universal
            document.querySelectorAll('.tab-search').forEach(input => {
                input.addEventListener('keyup', function() {
                    const term = this.value.toLowerCase();
                    // Buscar en la tabla activa actual
                    const activeTable = this.closest('.tab-pane').querySelector('.tab-pane.active .searchable-table tbody');
                    if(!activeTable) return;

                    const rows = activeTable.querySelectorAll('tr.main-row');
                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        if(text.includes(term)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                            // Asegurar que su detalle también se esconda si está abierto
                            const targetId = row.getAttribute('data-bs-target');
                            if(targetId) {
                                const detailRow = document.querySelector(targetId);
                                if(detailRow && detailRow.classList.contains('show')) {
                                    detailRow.classList.remove('show');
                                }
                            }
                        }
                  
                });
            });
        });
    </script>
}