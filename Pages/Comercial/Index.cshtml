@page
@model AtilsonCargoSpa.Pages.Comercial.IndexModel
@{
    ViewData["Title"] = "Command Center Comercial - Tarifario y Negociaciones";

    // VARIABLES GLOBALES PARA FILTROS DE CIUDADES (PUERTOS)
    var nombresPuertosFiltro = new[] { "VALPARAISO", "VAP", "SAN ANTONIO", "SAI", "SAN VICENTE", "CORONEL", "LIRQ" };
    var optionsPuertosFiltro = new SelectList(Model.ListaCiudades.Where(c => nombresPuertosFiltro.Any(p => QuitarAcentos(c.Text).Contains(p))), "Value", "Text");

    var selectListaNombres = ViewData["ListaCiudadesNombre"] as SelectList;
    var optionsPuertosNombreFiltro = selectListaNombres != null ? new SelectList(selectListaNombres.Where(c => nombresPuertosFiltro.Any(p => QuitarAcentos(c.Text).Contains(p))), "Value", "Text") : null;
}

@functions {
    // Quita tildes antes de comparar, así "Lirquén", "LIRQUÉN" o variantes con acento
    // "descompuesto" en la BD igual matchean contra "LIRQUEN".
    string QuitarAcentos(string? texto)
    {
        if (string.IsNullOrEmpty(texto)) return string.Empty;
        var normalizado = texto.ToUpper().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalizado)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    /* INTEGRACIÓN SELECT2 CON DISEÑO MINIMALISTA */
    .select2-container--default .select2-selection--single {
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        height: 36px;
        padding: 4px 0;
        font-size: 12.5px;
        font-weight: 600;
        background-color: #fff;
        transition: border-color 0.15s ease;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: var(--text-main);
            line-height: 28px;
            padding-left: 10px;
            padding-right: 26px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 34px;
        }

    /* Al abrir, usamos el color de marca en vez del azul por defecto de Select2 */
    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: var(--atilson-dark) !important;
        border-bottom-left-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
    }

    /* El desplegable queda PEGADO al cuadro, sin gap, como si fuera el mismo bloque */
    .select2-dropdown {
        font-size: 12.5px;
        font-weight: 600;
        border: 1px solid var(--atilson-dark);
        border-top: none;
        border-radius: 0 0 4px 4px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        margin-top: -1px;
    }

    .select2-results__option {
        padding: 8px 12px;
    }

    .select2-results__option--highlighted {
        background-color: var(--atilson-dark) !important;
    }

    /* El campo para escribir queda integrado justo debajo, con el mismo look
           que el cuadro cerrado, en vez de verse como una caja aparte */
    .select2-search--dropdown {
        padding: 6px;
        border-bottom: 1px solid #e2e8f0;
        background: #fff;
    }

    .select2-search__field {
        text-transform: uppercase;
        height: 30px;
        padding: 4px 8px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 4px;
        font-size: 12.5px;
        font-weight: 600;
        outline: none;
    }

        .select2-search__field:focus {
            border-color: var(--atilson-dark) !important;
        }

    .select2-container {
        width: 100% !important;
    }

    /* FILTROS SUPERIORES: se agrandan y dejan de ser aplastados por el flex */
    select.filtro-select + .select2-container {
        width: auto !important;
        min-width: 190px !important;
        flex: 0 0 auto;
    }

        select.filtro-select + .select2-select .select2-selection--single,
        select.filtro-select + .select2-container .select2-selection--single {
            width: auto !important;
            min-width: 190px !important;
        }

    /* DISEÑO MINIMALISTA Y CORPORATIVO TIPO EXCEL */
    :root {
        --dark-bg: #111827;
        --border-color: #e2e8f0;
        --text-main: #334155;
        --text-muted: #64748b;
        --atilson-dark: #2c1b4d;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--text-main);
    }

    .nav-tabs-main {
        border-bottom: 1px solid var(--border-color);
        gap: 6px;
        margin-bottom: 30px;
    }

        .nav-tabs-main .nav-link {
            border: none;
            background: transparent;
            color: #94a3b8;
            font-weight: 800;
            font-size: 13.5px;
            text-transform: uppercase;
            padding: 14px 22px;
            margin-bottom: -1px;
            border-radius: 10px 10px 0 0;
            border-bottom: 3px solid transparent;
            cursor: pointer;
            letter-spacing: 0.6px;
            transition: all 0.18s ease;
            display: inline-flex;
            align-items: center;
        }

            .nav-tabs-main .nav-link:hover {
                color: var(--atilson-dark);
                background-color: rgba(44,27,77,0.04);
            }

            .nav-tabs-main .nav-link.active {
                color: var(--atilson-dark);
                font-weight: 900;
                background-color: rgba(44,27,77,0.06);
                border-bottom: 3px solid var(--atilson-dark);
            }

            .nav-tabs-main .nav-link i {
                font-size: 15px;
            }

    .nav-tabs-custom {
        border-bottom: 1px solid var(--border-color);
        gap: 4px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

        .nav-tabs-custom .nav-link {
            border: none;
            background: transparent;
            color: #94a3b8;
            font-weight: 700;
            font-size: 11.5px;
            text-transform: uppercase;
            padding: 11px 16px;
            margin-bottom: -1px;
            border-radius: 8px 8px 0 0;
            border-bottom: 2px solid transparent;
