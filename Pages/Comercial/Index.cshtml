                                    <th class="text-end pe-4" style="width: 20%;">Desplegar</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- FORMULARIO DE INGRESO RÁPIDO -->
                                <tr id="form-almacenamiento" class="inline-form-row d-none">
                                    <td colspan="4">
                                        <form method="post" asp-page-handler="CrearTarifaAlmacenamiento">
                                            <div class="row g-2 align-items-end px-3">
