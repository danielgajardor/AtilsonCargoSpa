                                                            <div class="col-md-2"><label class="form-label">Porteo / Interplanta</label><div class="d-flex gap-1"><input asp-for="NuevoCostoTerrestre.ServicioPorteoPuerto" type="number" class="form-control-xs w-50" placeholder="Porteo"><input asp-for="NuevoCostoTerrestre.Interplanta" type="number" class="form-control-xs w-50" placeholder="Interplanta"></div></div>
                                                            <div class="col-md-1 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> ADD</button></div>

                                                            <div class="col-md-2 mt-2"><label class="form-label">Tipo Carga</label><select asp-for="NuevoCostoTerrestre.IdTipoCarga" class="form-select-xs w-100" required><option value="1">DRY</option><option value="2">REEFER</option></select></div>
                                                            <div class="col-md-2 mt-2"><label class="form-label">Falso Flete Depósito</label><input asp-for="NuevoCostoTerrestre.FalsoFleteDeposito" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                            <div class="col-md-2 mt-2"><label class="form-label">Expiración</label><input asp-for="NuevoCostoTerrestre.FechaFinVigencia" type="date" class="form-control-xs w-100" required></div>
                                                            <div class="col-md-2 mt-2"><label class="form-label">Hrs Libres (Plt/Pto)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoTerrestre.HorasLibresPlanta" type="number" class="form-control-xs w-50" placeholder="7"><input asp-for="NuevoCostoTerrestre.HorasLibresPuerto" type="number" class="form-control-xs w-50" placeholder="3"></div></div>
                                                        </div>
                                                    </form>
                                                </td>
                                            </tr>
                                            @foreach (var grupo in Model.TarifasTerrestres.GroupBy(t => t.IdProveedorNavigation))
                                            {
                                                var prov = grupo.Key;
