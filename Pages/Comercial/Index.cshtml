@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Guardar y restaurar TODO el árbol de pestañas (Nivel 1, 2 y 3)
            const tabGroups = [
                { selector: '#mainTabs .nav-link', key: 'activeMainTab' },
                { selector: '.nav-tabs-custom .nav-link', key: 'activeSubTab' },
                { selector: '.sub-tabs .nav-link', key: 'activePillTab' }
            ];

            tabGroups.forEach(group => {
                let savedTarget = localStorage.getItem(group.key);
                if (savedTarget) {
                    let el = document.querySelector(`${group.selector}[data-bs-target="${savedTarget}"]`) || document.getElementById(savedTarget);
                    if (el) new bootstrap.Tab(el).show();
                }

                document.querySelectorAll(group.selector).forEach(tab => {
                    tab.addEventListener('click', e => {
                        let target = e.target.getAttribute('data-bs-target') || e.target.id;
                        localStorage.setItem(group.key, target);
                    });
                });
            });

            const deleteButtons = document.querySelectorAll('.btn-delete, form');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function(e) { e.stopPropagation(); });
            });

            window.abrirModalEditarTerrestre = function(id, valorActual) {
                document.getElementById('editTerrestreId').value = id;
                document.getElementById('editTerrestreValor').value = valorActual ? valorActual.replace(',', '.') : '';
                new bootstrap.Modal(document.getElementById('modalEditarTerrestre')).show();
            };

            window.abrirModalEditarMaritimo = function(id, valorActual) {
                document.getElementById('editMaritimoId').value = id;
                document.getElementById('editMaritimoValor').value = valorActual ? valorActual.replace(',', '.') : '';
                new bootstrap.Modal(document.getElementById('modalEditarMaritimo')).show();
            };
        });

        function filterBookings() {
            const input = document.getElementById('liveSearchInput');
            const filter = input.value.toUpperCase();
            const table = document.getElementById('bookingsTable');
            const mainRows = table.getElementsByClassName('row-master');

            for (let i = 0; i < mainRows.length; i++) {
                const bkgCol = mainRows[i].getElementsByTagName("td")[0];
                const cliCol = mainRows[i].getElementsByTagName("td")[1];
                if (bkgCol || cliCol) {
                    const bkgText = bkgCol.textContent || bkgCol.innerText;
                    const cliText = cliCol.textContent || cliCol.innerText;
                    if (bkgText.toUpperCase().indexOf(filter) > -1 || cliText.toUpperCase().indexOf(filter) > -1) {
                        mainRows[i].style.display = "";
                    } else {
                        mainRows[i].style.display = "none";
                        const targetId = mainRows[i].getAttribute('data-bs-target').substring(1);
                        const detailRow = document.getElementById(targetId);
                        if (detailRow && detailRow.classList.contains('show')) {
                            new bootstrap.Collapse(detailRow, { toggle: false }).hide();
                        }
                    }
                }
            }
        }

        // SECCIONES DE SCRIPTS PARA GESTIÓN DE ACUERDOS EXISTENTES (MANTENIDOS)
        function checkAgreement(input, auditBoxId) {
            const baseValue = parseFloat(input.getAttribute('data-base'));
            const currentValue = parseFloat(input.value);
            const auditBox = document.getElementById(auditBoxId);
            const auditInput = auditBox.querySelector('input');

            if (!isNaN(currentValue) && currentValue !== baseValue) {
                input.classList.add('is-modified');
                auditBox.style.display = 'block';
                auditInput.required = true;
            } else {
                input.classList.remove('is-modified');
                auditBox.style.display = 'none';
                auditInput.required = false;
                auditInput.value = '';
            }
        }

        function guardarAcuerdos(idOperacion, btn) {
            const detailRow = document.getElementById('bkg-' + idOperacion);
            if (!detailRow) return;

            const payload = [];
            const inputs = detailRow.querySelectorAll('.tx-input');
            let faltanJustificaciones = false;

            inputs.forEach(input => {
                const idTx = input.getAttribute('data-txid');
                const baseVal = parseFloat(input.getAttribute('data-base'));
                const currentVal = parseFloat(input.value);

                if (!isNaN(currentVal) && currentVal !== baseVal) {
                    const justificacionInput = detailRow.querySelector(`#aud-tx-${idTx} .tx-justificacion`);
                    const justificacionText = justificacionInput ? justificacionInput.value.trim() : '';

                    if (justificacionText === '') {
                        faltanJustificaciones = true;
                        justificacionInput.classList.add('border-danger');
                    }

                    payload.push({ IdTx: parseInt(idTx), NuevoMonto: currentVal, Justificacion: justificacionText });
                }
            });

            if (faltanJustificaciones) { Swal.fire('Atención', 'Debes ingresar un comentario justificando el cambio de valor.', 'warning'); return; }
            if (payload.length === 0) { Swal.fire('Información', 'No has modificado ninguna tarifa.', 'info'); return; }

            const originalBtnText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> GUARDANDO...';
            btn.disabled = true;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch(`?handler=GuardarAcuerdos&idOperacion=${idOperacion}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            })
                .then(res => res.json())
                .then(data => {
                    btn.innerHTML = originalBtnText; btn.disabled = false;
                    if (data.success) { Swal.fire('¡Acuerdos Cerrados!', 'Las calibraciones fueron sobreescritas en Finanzas.', 'success').then(() => window.location.reload()); }
                    else { Swal.fire('Error', data.message || 'No se pudo guardar', 'error'); }
                }).catch(err => {
                    Swal.fire('Error de conexión', 'No se pudo contactar con el servidor.', 'error');
                    btn.innerHTML = originalBtnText; btn.disabled = false;
                });
        }

        function agregarTramoInterplanta(idOperacion, btnElement) {
            Swal.fire({
                title: '<i class="bi bi-signpost-split-fill text-warning"></i> Añadir Tarifa Interplanta',
                html: `
                            <p style="font-size:13px;" class="text-muted">Se agregará la línea de <strong>Costo (Proveedor)</strong> y <strong>Venta (Cliente)</strong> bajo la categoría Transporte Terrestre.</p>
                            <select id="swalTipoTramo" class="form-select mb-3 fw-bold">
                                <option value="TARIFA PLANA INTERPLANTA (<20 KM)">Tarifa Plana Corta (Porteo < 20 KM)</option>
                                <option value="FLETE TERRESTRE (TRAMO INTERPLANTA ADICIONAL)">Tramo Largo Independiente (> 20 KM)</option>
                            </select>
                            <div class="input-group mb-2">
                                <select id="swalMonedaTramo" class="form-select" style="max-width: 100px;"><option value="CLP">CLP</option><option value="USD">USD</option></select>
                                <input type="number" id="swalMontoTramo" class="form-control fw-bold" placeholder="Monto Base Proveedor..." />
                            </div>
                            <small class="text-muted" style="font-size: 10px;">Podrás calibrar el margen de venta en la tabla del cliente.</small>`,
                showCancelButton: true, confirmButtonText: 'Añadir a Finanzas', cancelButtonText: 'Cancelar', confirmButtonColor: '#0f172a',
                preConfirm: () => {
                    const concepto = document.getElementById('swalTipoTramo').value;
                    const monto = parseFloat(document.getElementById('swalMontoTramo').value);
                    const moneda = document.getElementById('swalMonedaTramo').value;
                    if (!monto || isNaN(monto)) { Swal.showValidationMessage('Ingresa un monto válido'); return false; }
                    return { concepto, monto, moneda };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const originalHtml = btnElement.innerHTML;
                    btnElement.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Procesando...'; btnElement.disabled = true;

                    fetch(`?handler=AñadirTramoInterplanta`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({ IdOperacion: idOperacion, Concepto: result.value.concepto, MontoNeto: result.value.monto, Moneda: result.value.moneda })
                    }).then(res => res.json()).then(data => {
                        if (data.success) {
                            btnElement.outerHTML = `<span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-2" style="font-size: 10px;"><i class="bi bi-check-circle-fill me-1"></i> Costo y Venta añadidos</span>`;
                            setTimeout(() => { window.location.reload(); }, 1500);
                        } else {
                            btnElement.innerHTML = originalHtml; btnElement.disabled = false; Swal.fire('Error', data.message, 'error');
                        }
                    }).catch(() => {
                        btnElement.innerHTML = originalHtml; btnElement.disabled = false; Swal.fire('Error', 'Fallo de conexión', 'error');
                    });
                }
            });
        }
    </script>
}