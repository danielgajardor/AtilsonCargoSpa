    <!-- PESTAÑAS PRINCIPALES (NIVEL 1) -->
    <ul class="nav nav-tabs-main" id="mainTabs" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-proveedores" data-bs-toggle="tab" data-bs-target="#panel-proveedores" type="button" role="tab"><i class="bi bi-truck me-2"></i> Proveedores</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="tab-clientes" data-bs-toggle="tab" data-bs-target="#panel-clientes" type="button" role="tab"><i class="bi bi-briefcase-fill me-2"></i> Clientes</button></li>
    </ul>

    <div class="tab-content" id="mainTabsContent">

        <!-- ============================================== -->
        <!-- PANEL 1: PROVEEDORES (COSTOS)                  -->
        <!-- ============================================== -->
        <div class="tab-pane fade show active" id="panel-proveedores" role="tabpanel">

            <ul class="nav nav-tabs-custom" id="servicios-prov" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#prov-maritimo" type="button">Marítimo</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-terrestre" type="button">Terrestre</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-documental" type="button">Documental</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-gate" type="button">Gate Out/In</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="tab-almacenamiento" data-bs-toggle="tab" data-bs-target="#panel-almacenamiento" type="button" role="tab">Almacenamiento</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#prov-otros" type="button">Otros</button></li>
            </ul>

            <div class="tab-content">
                <!-- PROVEEDORES -> MARÍTIMO -->
                <div class="tab-pane fade show active" id="prov-maritimo">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm">
                        <ul class="nav nav-pills sub-tabs" id="pills-prov-mar" role="tablist">
                            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#prov-mar-dry" type="button">Dry</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#prov-mar-rfcong" type="button">Reefer Congelado</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#prov-mar-rffres" type="button">Reefer Fresco</button></li>
                        </ul>
                        <div class="d-flex gap-2">
                            <form method="get" class="d-flex gap-2 mb-0">
                                <select asp-for="FiltroIdNaviera" asp-items="Model.ListaNavieras" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 150px; font-size: 11px;"><option value="">Naviera...</option></select>
                                <select asp-for="FiltroPol" asp-items="Model.ListaPols" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 100px; font-size: 11px;"><option value="">POL...</option></select>
                                <select asp-for="FiltroPod" asp-items="Model.ListaPods" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 100px; font-size: 11px;"><option value="">POD...</option></select>
                                <button type="submit" class="btn btn-dark btn-sm fw-bold px-3">FILTRAR</button>
                                @if (Model.FiltroIdNaviera.HasValue || !string.IsNullOrEmpty(Model.FiltroPol) || !string.IsNullOrEmpty(Model.FiltroPod))
                                {
                                    <a asp-page="./Index" class="btn btn-light btn-sm border text-danger"><i class="bi bi-x-lg"></i></a>
                                }
                            </form>
                        </div>
                    </div>

                    <div class="tab-content">
                        <!-- PROVEEDORES -> MARÍTIMO -> DRY -->
                        <div class="tab-pane fade show active" id="prov-mar-dry">
                            <div class="d-flex justify-content-end mb-3 gap-2 align-items-center">
                                <button type="button" id="btnToggleRankingMaritimo" class="btn btn-sm fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px; background-color: #f8fafc; border: 1px solid #cbd5e1; color: #475569; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s ease;"
                                        onclick="
                                    var viewGrouped = document.getElementById('view-grouped-mar-dry');
                                    var viewRanking = document.getElementById('view-ranking-mar-dry');
                                    var btnIcon = this.querySelector('i');
                                    var btnText = this.querySelector('span');

                                    if (viewGrouped.classList.contains('d-none')) {
                                    viewGrouped.classList.remove('d-none');
                                    viewRanking.classList.add('d-none');
                                    this.style.backgroundColor = '#f8fafc';
                                    this.style.borderColor = '#cbd5e1';
                                    this.style.color = '#475569';
                                    btnIcon.className = 'bi bi-sort-numeric-down text-primary me-2';
                                    btnText.innerText = 'Comparativa Tarifas';
                                    } else {
                                    viewGrouped.classList.add('d-none');
                                    viewRanking.classList.remove('d-none');
                                    this.style.backgroundColor = '#f0fdf4';
                                    this.style.borderColor = '#22c55e';
                                    this.style.color = '#16a34a';
                                    btnIcon.className = 'bi bi-check-circle-fill me-2';
                                    btnText.innerText = 'Comparativa Activa';
                                    }
                                    ">
                                    <i class="bi bi-sort-numeric-down text-primary me-2" style="font-size: 12px;"></i> <span>Comparativa Tarifas</span>
                                </button>

                                <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px;" onclick="document.getElementById('form-prov-mar-dry').classList.toggle('d-none');">
                                    <i class="bi bi-plus-lg me-1"></i> NUEVO FLETE MARÍTIMO
                                </button>
                            </div>

                            <div id="view-grouped-mar-dry">
                                <div class="table-container">
                                    <table class="table table-erp searchable-table">
                                        <thead>
                                            <tr>
                                                <th colspan="2" class="ps-4">Naviera</th>
                                                <th class="text-end pe-4">Desplegar Rutas</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr id="form-prov-mar-dry" class="inline-form-row d-none">
                                                <td colspan="3">
                                                    <form method="post" asp-page-handler="CrearCostoMaritimo">
                                                        <div class="row g-2 align-items-end">
                                                            <div class="col-md-2"><label class="detail-lbl">Naviera</label><select asp-for="NuevoCostoMaritimo.IdNaviera" asp-items="Model.ListaNavieras" class="form-select-xs w-100" required><option value="">- Proveedor -</option></select></div>
                                                            <div class="col-md-1"><label class="detail-lbl">Equipo</label><input asp-for="NuevoCostoMaritimo.Equipamiento" class="form-control-xs w-100 text-uppercase" placeholder="Ej: 40' HC" required></div>
                                                            <div class="col-md-3"><label class="detail-lbl">Ruta (POL - POD)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.Pol" class="form-control-xs w-50 text-uppercase" placeholder="POL" required><input asp-for="NuevoCostoMaritimo.Pod" class="form-control-xs w-50 text-uppercase" placeholder="POD" required></div></div>
                                                            <div class="col-md-2"><label class="detail-lbl">Flete Neto USD</label><div class="d-flex gap-1"><span class="input-group-text bg-light p-1 px-2 border" style="font-size:11px;">$</span><input asp-for="NuevoCostoMaritimo.TarifaUsd" type="number" step="0.01" class="form-control-xs w-75" required></div></div>
                                                            <div class="col-md-3"><label class="detail-lbl">Días Libres (Ori/Des)</label><div class="d-flex gap-1"><input asp-for="NuevoCostoMaritimo.DiasLibresOrigen" type="text" class="form-control-xs w-50" placeholder="Ori"><input asp-for="NuevoCostoMaritimo.DiasLibresDestino" type="text" class="form-control-xs w-50" placeholder="Des"></div></div>
                                                            <div class="col-md-1 text-end"><button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> ADD</button></div>

                                                            <div class="col-md-2 mt-2"><label class="detail-lbl">Late Arrival (USD)</label><input asp-for="NuevoCostoMaritimo.CostoLateArrival" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                            <div class="col-md-2 mt-2"><label class="detail-lbl">Corrector B/L</label><input asp-for="NuevoCostoMaritimo.CostoCorrectorBL" type="number" step="0.01" class="form-control-xs w-100"></div>
                                                            <div class="col-md-2 mt-2"><label class="detail-lbl">Expiración</label><input asp-for="NuevoCostoMaritimo.FechaInicioVigencia" type="date" class="form-control-xs w-100" required></div>
                                                        </div>
                                                    </form>
                                                </td>
                                            </tr>

                                            @foreach (var grupo in Model.TarifasMaritimas.GroupBy(t => t.IdNavieraNavigation))
                                            {
                                                var naviera = grupo.Key;
                                                var tarifasDry = grupo.Where(t => !(t.Equipamiento ?? "").ToUpper().Contains("REEFER") && !(t.Equipamiento ?? "").ToUpper().Contains("RF")).ToList();

                                                if (tarifasDry.Any())
                                                {
                                                    <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#nav-dry-@naviera?.Id" style="cursor: pointer;">
                                                        <td colspan="2" class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-ship me-2 text-primary"></i> @(naviera?.NombreNaviera ?? "S/N")</td>
                                                        <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
