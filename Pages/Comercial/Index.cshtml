                                                    </div>
                                                </form>
                                            </td>
                                        </tr>

                                        @foreach (var grupo in Model.TarifasMaritimas.GroupBy(t => t.IdNavieraNavigation))
                                        {
                                            var naviera = grupo.Key;
                                            var tarifasRf = grupo.Where(t => (t.Equipamiento ?? "").ToUpper().Contains("REEFER") || (t.Equipamiento ?? "").ToUpper().Contains("RF")).ToList();

                                            if (tarifasRf.Any())
                                            {
                                                <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#nav-rf-@naviera?.Id" style="cursor: pointer;">
                                                    <td colspan="2" class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-ship me-2 text-primary"></i> @(naviera?.NombreNaviera ?? "S/N")</td>
                                                    <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                                </tr>
                                                <tr id="nav-rf-@naviera?.Id" class="collapse detail-row">
                                                    <td colspan="3" class="p-0">
                                                        <div class="p-3 bg-light border-bottom">
                                                            <table class="table table-sm table-borderless m-0">
                                                                <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                                    <tr>
                                                                        <th>Ruta (POL ➔ POD)</th>
                                                                        <th>Equipo</th>
                                                                        <th class="text-end text-dark fw-bold">Flete Base (USD)</th>
                                                                        <th class="text-end">Plug</th>
                                                                        <th class="text-end">Late Arrival</th>
                                                                        <th class="text-end">Corr. B/L</th>
                                                                        <th class="text-center">Días Libres Origen</th>
                                                                        <th class="text-center">Días Libres Destino</th>
                                                                        <th class="text-center">Vigencia</th>
                                                                        <th></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var tm in tarifasRf)
                                                                    {
                                                                        var propPlacPlug = tm.GetType().GetProperty("PlacPlug")?.GetValue(tm, null);
                                                                        <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                            <td class="text-uppercase fw-bold text-dark" style="font-size: 11px;">@tm.Pol <i class="bi bi-arrow-right text-muted mx-1"></i> @tm.Pod</td>
                                                                            <td><span class="badge-reefer">@(tm.Equipamiento ?? "N/A")</span></td>
                                                                            <td class="text-end font-monospace fw-bold text-danger" style="font-size: 12px;">$@(tm.TarifaUsd.ToString("N0"))</td>
                                                                            <td class="text-end font-monospace text-primary fw-bold" style="font-size: 11px;">@(propPlacPlug != null ? $"${propPlacPlug}" : "No inc.")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoLateArrival != null ? $"${tm.CostoLateArrival}" : "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoCorrectorBL != null ? $"${tm.CostoCorrectorBL}" : "-")</td>
                                                                            <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresOrigen?.ToString() ?? "0")</td>
                                                                            <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresDestino?.ToString() ?? "0")</td>
                                                                            <td class="text-center text-muted font-monospace" style="font-size: 11px;">@tm.FechaInicioVigencia.ToString("dd/MM/yyyy")</td>
                                                                            <td class="text-end pe-2">
                                                                                <form method="post" asp-page-handler="EliminarCostoMaritimo">
                                                                                    <input type="hidden" name="idTarifa" value="@tm.Id" />
                                                                                    <button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button>
                                                                                </form>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="prov-mar-rffres">
                            <div class="p-4 text-center text-muted">Por poblar tablas.</div>
                        </div>
                    </div>
                </div>

                <!-- PROVEEDORES -> TERRESTRE -->
                <div class="tab-pane fade" id="prov-terrestre">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm">
                        <ul class="nav nav-pills sub-tabs" id="pills-prov-ter" role="tablist">
                            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#prov-ter-dry" type="button">Dry</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#prov-ter-rf" type="button">Reefer</button></li>
