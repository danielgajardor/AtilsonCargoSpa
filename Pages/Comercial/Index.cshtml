                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">@(tm.CostoCorrectorBL != null ? $"${tm.CostoCorrectorBL}" : "-")</td>
                                                                                <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresOrigen?.ToString() ?? "0")</td>
                                                                                <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tm.DiasLibresDestino?.ToString() ?? "0")</td>
