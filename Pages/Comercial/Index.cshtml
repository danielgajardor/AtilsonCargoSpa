                                                                                    </button>
                                                                                    <form method="post" asp-page-handler="EliminarCostoDocumental" onsubmit="return confirm('¿Archivar costo de agencia?');"><input type="hidden" name="idTarifa" value="@tarifa.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PROVEEDORES -> GATE OUT/IN -->
                <div class="tab-pane fade" id="prov-gate">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm">
                        <h6 class="m-0 fw-bold px-2 text-dark" style="font-size: 13px;"><i class="bi bi-cone-striped text-warning me-2"></i> Tarifas Gate Out/In (Depósitos)</h6>
                        <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="document.getElementById('form-prov-gate').classList.toggle('d-none');">
                            <i class="bi bi-plus-lg me-1"></i> NUEVO COSTO GATE
                        </button>
                    </div>
                    <div class="table-container">
                        <table class="table table-erp searchable-table">
                            <thead>
                                <tr>
                                    <th class="ps-4">Depósito</th>
                                    <th>Concepto / Movimiento</th>
                                    <th class="text-end">Tarifa Costo</th>
                                    <th class="text-center">Vigencia</th>
                                    <th class="text-end pe-4">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="form-prov-gate" class="inline-form-row d-none"><td colspan="5" class="text-center p-3 text-muted">Formulario pendiente de enlazar...</td></tr>
                                @if (Model.TarifasGate != null)
                                {
                                    @foreach (var gate in Model.TarifasGate)
                                    {
                                        <tr style="border-bottom: 1px dashed #e2e8f0;">
                                            <td class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:12px;">@(gate.IdDepositoNavigation?.NombreDeposito ?? "S/N")</td>
                                            <td class="text-uppercase fw-bold text-dark">GATE @gate.TipoMovimiento - @(gate.TipoContenedor ?? "AMBOS")</td>
                                            <td class="text-end font-monospace fw-bold text-danger">@gate.Moneda $@(gate.ValorNeto?.ToString("N0") ?? "0")</td>
                                            <td class="text-center font-monospace text-muted">@(gate.FechaFinVigencia?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td class="text-end pe-4">
                                                <div class="d-flex justify-content-end gap-1">
                                                    <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalUniversal(@gate.Id, '@gate.ValorNeto', '@(gate.FechaFinVigencia?.ToString("yyyy-MM-dd") ?? "")', 'Gate')" title="Editar Tarifa">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <form method="post" asp-page-handler="EliminarTarifaGate" onsubmit="return confirm('¿Archivar costo Gate?');"><input type="hidden" name="idTarifa" value="@gate.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PROVEEDORES -> ALMACENAMIENTO -->
                <div class="tab-pane fade" id="panel-almacenamiento" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm">
                        <h6 class="m-0 fw-bold px-2 text-dark" style="font-size: 13px;"><i class="bi bi-boxes text-warning me-2"></i> Acuerdos Comerciales de Cadenas y Depósitos</h6>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="document.getElementById('form-almacenamiento').classList.toggle('d-none');">
                                <i class="bi bi-plus-lg me-1"></i> NUEVO ACUERDO
                            </button>
                        </div>
                    </div>

                    <div class="table-container">
                        <table class="table table-erp searchable-table">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width: 40%;">Cadena / Depósito (Razón Social)</th>
                                    <th class="text-center" style="width: 20%;">RUT Comercial</th>
                                    <th class="text-center" style="width: 20%;">Acuerdos Activos</th>
                                    <th class="text-end pe-4" style="width: 20%;">Desplegar</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="form-almacenamiento" class="inline-form-row d-none">
                                    <td colspan="4">
                                        <form method="post" asp-page-handler="CrearTarifaAlmacenamiento">
                                            <div class="row g-2 align-items-end px-3">
                                                <div class="col-md-3">
                                                    <label class="form-label">Proveedor (Cadena)</label>
                                                    <select asp-for="NuevaTarifaAlmacenamiento.IdProveedor" asp-items="Model.ListaProveedores" class="form-select-xs w-100" required>
                                                        <option value="">- Seleccione -</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">Días Libres</label>
                                                    <input asp-for="NuevaTarifaAlmacenamiento.DiasLibres" type="number" class="form-control-xs w-100 text-center fw-bold" value="5" required>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">Tarifa Base (CLP)</label>
                                                    <input asp-for="NuevaTarifaAlmacenamiento.TarifaBase" type="number" class="form-control-xs w-100 text-end fw-bold text-danger" value="30000" required>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">Tarifa Reefer (CLP/hr)</label>
                                                    <input asp-for="NuevaTarifaAlmacenamiento.TarifaConexionReefer" type="number" class="form-control-xs w-100 text-end fw-bold" value="3500" required>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label">¿Aplica IVA?</label>
                                                    <select asp-for="NuevaTarifaAlmacenamiento.AplicaIva" class="form-select-xs w-100">
                                                        <option value="true">SÍ (+19%)</option>
                                                        <option value="false">EXENTO</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-1 text-end">
                                                    <button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> ADD</button>
                                                </div>
                                            </div>
                                        </form>
                                    </td>
                                </tr>

                                @if (Model.TarifasAlmacenamientos != null && Model.TarifasAlmacenamientos.Any())
                                {
                                    foreach (var grupo in Model.TarifasAlmacenamientos.GroupBy(t => t.IdProveedorNavigation))
                                    {
                                        var prov = grupo.Key;
                                        <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#deposito-@prov?.Id" style="cursor: pointer;">
                                            <td class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;">
                                                <i class="bi bi-building me-2 text-primary"></i> @(prov?.NombreProveedor ?? "SIN PROVEEDOR ASIGNADO")
                                            </td>
                                            <td class="text-center font-monospace fw-bold text-muted">@(prov?.Rut ?? "SIN RUT")</td>
                                            <td class="text-center">
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 py-1 px-2">@grupo.Count() Acuerdos</span>
                                            </td>
                                            <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                        </tr>
                                        <tr id="deposito-@prov?.Id" class="collapse detail-row">
                                            <td colspan="4" class="p-0">
                                                <div class="p-3 bg-light border-bottom">
                                                    <div class="d-flex gap-5 mb-3 px-3 py-2 bg-white border rounded shadow-sm">
                                                        <div>
                                                            <span class="text-muted" style="font-size: 10px; text-transform: uppercase;">Ubicación Geográfica / Google Maps</span><br>
                                                            <span class="fw-bold text-dark" style="font-size: 11px;"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @(prov?.Contacto ?? "Valparaíso / San Antonio")</span>
                                                        </div>
                                                        <div>
                                                            <span class="text-muted" style="font-size: 10px; text-transform: uppercase;">Correo Operaciones Patio</span><br>
                                                            <span class="fw-bold text-dark" style="font-size: 11px;"><i class="bi bi-envelope-at-fill text-primary me-1"></i> @(prov?.CorreoOperativo ?? "No registrado")</span>
                                                        </div>
                                                    </div>

                                                    <table class="table table-sm table-borderless m-0">
                                                        <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                            <tr>
                                                                <th class="ps-3 text-center">Días Libres (Free Time)</th>
                                                                <th class="text-end">Tarifa Base Almacenaje</th>
                                                                <th class="text-end">Conexión Reefer (x Hora)</th>
                                                                <th class="text-center">Impuesto</th>
                                                                <th class="text-end pe-3">Acción</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var tarifa in grupo)
                                                            {
                                                                <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                    <td class="text-center font-monospace fw-bold text-primary" style="font-size: 12px;">@tarifa.DiasLibres DÍAS</td>
                                                                    <td class="text-end font-monospace fw-bold text-danger" style="font-size: 12px;">$@(tarifa.TarifaBase.ToString("N0"))</td>
                                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tarifa.TarifaConexionReefer.ToString("N0")) / hr</td>
                                                                    <td class="text-center">
                                                                        @(tarifa.AplicaIva ? Html.Raw("<span class='badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25' style='font-size:9px;'>SÍ (+19%)</span>") : Html.Raw("<span class='badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25' style='font-size:9px;'>EXENTO</span>"))
                                                                    </td>
                                                                    <td class="text-end pe-3">
                                                                        <div class="d-flex justify-content-end gap-1">
                                                                            <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalUniversal(@tarifa.Id, '@tarifa.TarifaBase', null, 'Almacenamiento')" title="Editar Tarifa Base">
                                                                                <i class="bi bi-pencil"></i>
                                                                            </button>
                                                                            <form method="post" asp-page-handler="EliminarTarifaAlmacenamiento" onsubmit="return confirm('¿Archivar este acuerdo de almacenamiento?');"><input type="hidden" name="idTarifa" value="@tarifa.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-2 opacity-25"></i>
                                            No hay acuerdos comerciales registrados con depósitos.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PROVEEDORES -> OTROS -->
                <div class="tab-pane fade" id="prov-otros">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="m-0 fw-bold" style="color: var(--atilson-dark); font-size: 14px;"><i class="bi bi-file-earmark-check me-2"></i> Maestro de Extracostos y Recintos</h5>
                        <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="document.getElementById('form-doc-maestro').classList.toggle('d-none');">
                            <i class="bi bi-plus-lg me-1"></i> NUEVO EXTRACOSTO / RECINTO
                        </button>
                    </div>

                    <div class="table-container">
                        <table class="table table-erp searchable-table">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width: 35%;">Concepto</th>
                                    <th class="text-center" style="width: 15%;">Moneda</th>
                                    <th class="text-end" style="width: 15%;">Valor Neto</th>
                                    <th class="text-center" style="width: 15%;">Incluye IVA</th>
                                    <th class="text-end pe-4" style="width: 20%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="form-doc-maestro" class="inline-form-row d-none">
                                    <td colspan="5">
                                        <form method="post" asp-page-handler="CrearTarifaDocumental">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-5">
                                                    <label class="detail-lbl">Concepto Extracosto</label>
                                                    <input asp-for="NuevaTarifaDocumental.Concepto" class="form-control-xs w-100 text-uppercase" required>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="detail-lbl">Moneda</label>
                                                    <select asp-for="NuevaTarifaDocumental.Moneda" class="form-select-xs w-100" required><option value="CLP">CLP</option><option value="USD">USD</option><option value="UF">UF</option></select>
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="detail-lbl">Valor Neto</label>
                                                    <input asp-for="NuevaTarifaDocumental.ValorNeto" type="number" step="0.01" class="form-control-xs w-100 fw-bold text-success" required>
                                                </div>
                                                <div class="col-md-1 text-center">
                                                    <label class="detail-lbl d-block mb-2">¿Aplica IVA?</label>
                                                    <div class="form-check form-switch d-inline-block m-0"><input class="form-check-input" type="checkbox" asp-for="NuevaTarifaDocumental.AplicaIva" value="true" checked></div>
                                                </div>
                                                <div class="col-md-2 text-end">
                                                    <button type="submit" class="btn btn-sm btn-primary fw-bold w-100"><i class="bi bi-check2"></i> GUARDAR</button>
                                                </div>
                                            </div>
                                        </form>
                                    </td>
                                </tr>

                                @if (Model.TarifasMaestrasDocumentales != null && Model.TarifasMaestrasDocumentales.Any())
                                {
                                    foreach (var doc in Model.TarifasMaestrasDocumentales)
                                    {
                                        <tr class="main-row">
                                            <td class="ps-4 fw-bold" style="color: var(--atilson-dark);">@doc.Concepto</td>
                                            <td class="text-center font-monospace text-muted">@doc.Moneda</td>
                                            <td class="text-end fw-bold text-success font-monospace">@doc.Moneda $@doc.ValorNeto.ToString("N0")</td>
                                            <td class="text-center">
                                                @if (doc.AplicaIva)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size:9px;">SÍ (+19%)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25" style="font-size:9px;">EXENTO</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <form method="post" asp-page-handler="EliminarTarifaDocumental" onsubmit="return confirm('¿Está seguro de eliminar este concepto?');">
                                                    <input type="hidden" name="idTarifa" value="@doc.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 10px; font-weight: 800; padding: 4px 8px;"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

        <!-- ============================================== -->
        <!-- PANEL 2: CLIENTES (VENTAS)                     -->
