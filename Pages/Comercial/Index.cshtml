                                                                                <td><span class="badge-dry">@(tm.Equipamiento ?? "N/A")</span></td>
                                                                                <td class="text-end font-monospace fw-bold text-danger" style="font-size: 12px;">$@(tm.TarifaUsd.ToString("N0"))</td>
