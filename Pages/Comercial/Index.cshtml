                                                            <div class="col-md-4"><label class="form-label">Ruta (Retiro - Planta - Puerto)</label><div class="d-flex gap-1"><select asp-for="NuevoCostoTerrestre.IdCiudadOrigen" asp-items="Model.ListaCiudades" class="form-select-xs w-33" required><option value="">Retiro</option></select><select asp-for="NuevoCostoTerrestre.IdCiudadPlanta" asp-items="Model.ListaCiudades" class="form-select-xs w-33" required><option value="">Planta</option></select><select asp-for="NuevoCostoTerrestre.IdCiudadDestino" asp-items="Model.ListaCiudades" class="form-select-xs w-33" required><option value="">Puerto</option></select></div></div>
                                                            <div class="col-md-2"><label class="form-label">Costo Flete Base</label><div class="d-flex gap-1"><span class="input-group-text bg-light p-1 px-2 border" style="font-size:11px;">$</span><input asp-for="NuevoCostoTerrestre.ValorNeto" type="number" class="form-control-xs w-75" required></div></div>
