            font-size: 12.5px;
            font-weight: 500;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
            color: #334155;
        }

        .table-erp tbody tr:hover {
            background-color: #f8fafc;
        }

    .badge-dry {
        background-color: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: 800;
        font-size: 10px;
    }

    .badge-reefer {
        background-color: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: 800;
        font-size: 10px;
    }

    .detail-row td {
        background-color: #fafafa;
        padding: 0 !important;
        border-bottom: 1px solid var(--border-color);
    }

    .inline-form-row {
        background-color: #f0f9ff;
        border-bottom: 2px solid #bae6fd;
    }

        .inline-form-row td {
            padding: 15px !important;
        }

    .form-control-xs, .form-select-xs {
        font-size: 11px;
        padding: 6px 10px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-weight: 600;
    }

    .btn-delete {
        color: #ef4444;
        background: transparent;
        border: none;
        padding: 4px 8px;
        font-size: 12px;
    }

        .btn-delete:hover {
            background: #fef2f2;
            border-radius: 4px;
        }

    .modal-content {
        border: none;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .modal-header {
        border-bottom: 1px solid var(--border-color);
        padding: 20px 24px;
        background: white;
    }

    .modal-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--dark-bg);
        text-transform: uppercase;
    }

    .modal-body {
        padding: 24px;
        background: #fcfcfc;
    }

    .modal-footer {
        border-top: 1px solid var(--border-color);
