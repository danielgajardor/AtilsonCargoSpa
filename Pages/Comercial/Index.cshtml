                                <select asp-for="FiltroIdProveedor" asp-items="Model.ListaProveedores" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 120px; font-size: 11px;"><option value="">Transporte...</option></select>
                                <select asp-for="FiltroIdCiudadOrigen" asp-items="optionsPuertosFiltro" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 90px; font-size: 11px;"><option value="">Retiro...</option></select>
                                <select asp-for="FiltroIdCiudadPlanta" asp-items="Model.ListaCiudades" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 90px; font-size: 11px;"><option value="">Planta...</option></select>
                                <select asp-for="FiltroIdCiudadDestino" asp-items="optionsPuertosFiltro" class="form-select form-select-sm bg-light border-0 fw-bold filtro-select" style="width: 90px; font-size: 11px;"><option value="">Puerto...</option></select>

                                <button type="submit" class="btn btn-dark btn-sm fw-bold px-3" onclick="localStorage.setItem('activeMainTab', '#tab-proveedores'); localStorage.setItem('activeSubTab', '#prov-terrestre');">FILTRAR</button>

                                @if (Model.FiltroIdProveedor.HasValue || Model.FiltroIdCiudadOrigen.HasValue || Model.FiltroIdCiudadPlanta.HasValue || Model.FiltroIdCiudadDestino.HasValue)
                                {
                                    <a asp-page="./Index" class="btn btn-light btn-sm border text-danger" onclick="localStorage.setItem('activeMainTab', '#tab-proveedores'); localStorage.setItem('activeSubTab', '#prov-terrestre');"><i class="bi bi-x-lg"></i></a>
                                }
                            </form>
                        </div>
                    </div>
                    <div class="tab-content">
                        <!-- PESTAÑA DRY TERRESTRE -->
                        <div class="tab-pane fade show active" id="prov-ter-dry">
                            <div class="d-flex justify-content-end mb-3 gap-2 align-items-center">
                                <button type="button" id="btnToggleRanking" class="btn btn-sm fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px; background-color: #f8fafc; border: 1px solid #cbd5e1; color: #475569; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s ease;"
                                        onclick="
                                    var viewGrouped = document.getElementById('view-grouped-dry');
                                    var viewRanking = document.getElementById('view-ranking-dry');
                                    var btnIcon = this.querySelector('i');
                                    var btnText = this.querySelector('span');

                                    if (viewGrouped.classList.contains('d-none')) {
                                    viewGrouped.classList.remove('d-none');
                                    viewRanking.classList.add('d-none');
                                    this.style.backgroundColor = '#f8fafc';
                                    this.style.borderColor = '#cbd5e1';
                                    this.style.color = '#475569';
                                    btnIcon.className = 'bi bi-sort-numeric-down text-primary me-2';
                                    btnText.innerText = 'Comparativa Tarifas';
                                    } else {
                                    viewGrouped.classList.add('d-none');
                                    viewRanking.classList.remove('d-none');
                                    this.style.backgroundColor = '#f0fdf4';
                                    this.style.borderColor = '#22c55e';
                                    this.style.color = '#16a34a';
                                    btnIcon.className = 'bi bi-check-circle-fill me-2';
                                    btnText.innerText = 'Comparativa Activa';
                                    }
                                    ">
                                    <i class="bi bi-sort-numeric-down text-primary me-2" style="font-size: 12px;"></i> <span>Comparativa Tarifas</span>
                                </button>

                                <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px;" onclick="document.getElementById('form-prov-ter').classList.toggle('d-none');">
                                    <i class="bi bi-plus-lg me-1"></i> NUEVO TRAMO TRANSPORTE
                                </button>
                            </div>

                            <div id="view-grouped-dry">
                                <div class="table-container">
                                    <table class="table table-erp searchable-table">
                                        <thead>
                                            <tr>
                                                <th colspan="2" class="ps-4">Empresa Transporte</th>
                                                <th class="text-end pe-4">Desplegar Tramos</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr id="form-prov-ter" class="inline-form-row d-none">
