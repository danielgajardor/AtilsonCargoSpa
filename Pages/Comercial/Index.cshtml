                                                <th>Ruta (Retiro ➔ Planta ➔ Pto. Entrega)</th>
                                                <th class="text-end text-dark fw-bold">Flete Base</th>
                                                <th class="text-end">F.F Planta</th>
                                                <th class="text-end">F.F &gt;50%</th>
                                                <th class="text-end">F.F &lt;50%</th>
                                                <th class="text-end">F.F Depósito</th>
                                                <th class="text-end">Porteo</th>
                                                <th class="text-end">Interplanta</th>
